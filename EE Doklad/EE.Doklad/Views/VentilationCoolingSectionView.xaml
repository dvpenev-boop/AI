<UserControl x:Class="EE.Doklad.Views.VentilationCoolingSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:EE.Doklad.Converters"
             xmlns:models="clr-namespace:EE.Doklad.Models"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1200">

    <UserControl.Resources>
        <converters:FlexibleDoubleConverter x:Key="FlexibleDoubleConverter"/>
        <converters:TimeSpanToStringConverter x:Key="TimeSpanToStringConverter"/>
        <converters:ClimateDatabaseConverter x:Key="ClimateDatabaseConverter"/>
        <converters:StringMatchToVisibilityConverter x:Key="StringMatchToVisibilityConverter"/>
        <converters:CollectionToVisibilityConverter x:Key="CollectionToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>

        <Style x:Key="EditableTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#00796B"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ReadOnlyTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource EditableTextBoxStyle}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
        </Style>

        <Style x:Key="EnergyComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="MinWidth" Value="300"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#00796B"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0F2F1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EnergySourceComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource EnergyComboBoxItemStyle}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#00796B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="MaxDropDownHeight" Value="420"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="14. Вентилация - охлаждане"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,0,15"
                       Foreground="#2E7D32"/>

            <TextBlock Text="Попълнете данните за секция: 14. Вентилация Охлаждане"
                       FontSize="12"
                       FontStyle="Italic"
                       Foreground="DimGray"
                       Margin="0,0,0,20"/>

            <!-- Warning text (when cooling season is NOT enabled) -->
            <Border Background="#FFF3CD" BorderBrush="#FFC107" BorderThickness="2" Padding="12" Margin="0,0,0,15"
                    Visibility="{Binding CoolingSeasonWarning, Converter={StaticResource StringToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠️" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding CoolingSeasonWarning}" 
                               FontSize="13" FontWeight="SemiBold" 
                               Foreground="#856404" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Main content (disabled when cooling season is NOT enabled) -->
            <StackPanel IsEnabled="{Binding IsCoolingSeasonEnabled}">

                <!-- ГРАФИЦИ ЗА ОХЛАДИТЕЛЕН ПЕРИОД (от ObjectData.CoolingSchedules) -->
                <Border BorderBrush="#0066CC" BorderThickness="2" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Графици за охладителен период" 
                                   FontSize="14" FontWeight="Bold" Padding="12,10" 
                                   Background="#E6F2FF" Foreground="#0066CC"/>

                        <!-- A) График за обитаване – охладителен период -->
                        <Border BorderBrush="#CCC" BorderThickness="0,1,0,0" Padding="10">
                            <StackPanel>
                                <TextBlock Text="A) График за обитаване – охладителен период" 
                                           FontWeight="Bold" FontSize="12" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Раб.дни:" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="11"/>
                                    <TextBox Grid.Column="1" Text="{Binding ObjectData.CoolingSchedules.OccupancyCoolingSchedule.Workdays.StartTime, Converter={StaticResource TimeSpanToStringConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="4" TextAlignment="Center" FontSize="11"/>
                                    <TextBlock Grid.Column="2" Text="–" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                                    <TextBox Grid.Column="3" Text="{Binding ObjectData.CoolingSchedules.OccupancyCoolingSchedule.Workdays.EndTime, Converter={StaticResource TimeSpanToStringConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="4" TextAlignment="Center" FontSize="11"/>
                                    
                                    <TextBlock Grid.Column="5" Text="Съб:" VerticalAlignment="Center" Margin="8,0,5,0" FontSize="11"/>
                                    <TextBox Grid.Column="6" Text="{Binding ObjectData.CoolingSchedules.OccupancyCoolingSchedule.Saturday.StartTime, Converter={StaticResource TimeSpanToStringConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="4" TextAlignment="Center" FontSize="11"/>
                                    <TextBlock Grid.Column="7" Text="–" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                                    <TextBox Grid.Column="8" Text="{Binding ObjectData.CoolingSchedules.OccupancyCoolingSchedule.Saturday.EndTime, Converter={StaticResource TimeSpanToStringConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="4" TextAlignment="Center" FontSize="11"/>
                                    
                                    <TextBlock Grid.Column="10" Text="Нед:" VerticalAlignment="Center" Margin="8,0,5,0" FontSize="11"/>
                                    <TextBox Grid.Column="11" Text="{Binding ObjectData.CoolingSchedules.OccupancyCoolingSchedule.Sunday.StartTime, Converter={StaticResource TimeSpanToStringConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="4" TextAlignment="Center" FontSize="11"/>
                                    <TextBlock Grid.Column="12" Text="–" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                                    <TextBox Grid.Column="13" Text="{Binding ObjectData.CoolingSchedules.OccupancyCoolingSchedule.Sunday.EndTime, Converter={StaticResource TimeSpanToStringConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="4" TextAlignment="Center" FontSize="11"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- B) График за охлаждане -->
                        <Border BorderBrush="#CCC" BorderThickness="0,1,0,0" Padding="10">
                            <StackPanel>
                                <TextBlock Text="B) График за охлаждане" 
                                           FontWeight="Bold" FontSize="12" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Раб.дни:" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="11"/>
                                    <TextBox Grid.Column="1" Text="{Binding ObjectData.CoolingSchedules.CoolingSchedule.Workdays.StartTime, Converter={StaticResource TimeSpanToStringConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="4" TextAlignment="Center" FontSize="11"/>
                                    <TextBlock Grid.Column="2" Text="–" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                                    <TextBox Grid.Column="3" Text="{Binding ObjectData.CoolingSchedules.CoolingSchedule.Workdays.EndTime, Converter={StaticResource TimeSpanToStringConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="4" TextAlignment="Center" FontSize="11"/>
                                    
                                    <TextBlock Grid.Column="5" Text="Съб:" VerticalAlignment="Center" Margin="8,0,5,0" FontSize="11"/>
                                    <TextBox Grid.Column="6" Text="{Binding ObjectData.CoolingSchedules.CoolingSchedule.Saturday.StartTime, Converter={StaticResource TimeSpanToStringConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="4" TextAlignment="Center" FontSize="11"/>
                                    <TextBlock Grid.Column="7" Text="–" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                                    <TextBox Grid.Column="8" Text="{Binding ObjectData.CoolingSchedules.CoolingSchedule.Saturday.EndTime, Converter={StaticResource TimeSpanToStringConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="4" TextAlignment="Center" FontSize="11"/>
                                    
                                    <TextBlock Grid.Column="10" Text="Нед:" VerticalAlignment="Center" Margin="8,0,5,0" FontSize="11"/>
                                    <TextBox Grid.Column="11" Text="{Binding ObjectData.CoolingSchedules.CoolingSchedule.Sunday.StartTime, Converter={StaticResource TimeSpanToStringConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="4" TextAlignment="Center" FontSize="11"/>
                                    <TextBlock Grid.Column="12" Text="–" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                                    <TextBox Grid.Column="13" Text="{Binding ObjectData.CoolingSchedules.CoolingSchedule.Sunday.EndTime, Converter={StaticResource TimeSpanToStringConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="4" TextAlignment="Center" FontSize="11"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- C) График за вентилация охлаждане -->
                        <Border BorderBrush="#CCC" BorderThickness="0,1,0,0" Padding="10">
                            <StackPanel>
                                <TextBlock Text="C) График за вентилация охлаждане" 
                                           FontWeight="Bold" FontSize="12" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Раб.дни:" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="11"/>
                                    <TextBox Grid.Column="1" Text="{Binding ObjectData.CoolingSchedules.VentilationCoolingSchedule.Workdays.StartTime, Converter={StaticResource TimeSpanToStringConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="4" TextAlignment="Center" FontSize="11"/>
                                    <TextBlock Grid.Column="2" Text="–" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                                    <TextBox Grid.Column="3" Text="{Binding ObjectData.CoolingSchedules.VentilationCoolingSchedule.Workdays.EndTime, Converter={StaticResource TimeSpanToStringConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="4" TextAlignment="Center" FontSize="11"/>
                                    
                                    <TextBlock Grid.Column="5" Text="Съб:" VerticalAlignment="Center" Margin="8,0,5,0" FontSize="11"/>
                                    <TextBox Grid.Column="6" Text="{Binding ObjectData.CoolingSchedules.VentilationCoolingSchedule.Saturday.StartTime, Converter={StaticResource TimeSpanToStringConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="4" TextAlignment="Center" FontSize="11"/>
                                    <TextBlock Grid.Column="7" Text="–" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                                    <TextBox Grid.Column="8" Text="{Binding ObjectData.CoolingSchedules.VentilationCoolingSchedule.Saturday.EndTime, Converter={StaticResource TimeSpanToStringConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="4" TextAlignment="Center" FontSize="11"/>
                                    
                                    <TextBlock Grid.Column="10" Text="Нед:" VerticalAlignment="Center" Margin="8,0,5,0" FontSize="11"/>
                                    <TextBox Grid.Column="11" Text="{Binding ObjectData.CoolingSchedules.VentilationCoolingSchedule.Sunday.StartTime, Converter={StaticResource TimeSpanToStringConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="4" TextAlignment="Center" FontSize="11"/>
                                    <TextBlock Grid.Column="12" Text="–" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                                    <TextBox Grid.Column="13" Text="{Binding ObjectData.CoolingSchedules.VentilationCoolingSchedule.Sunday.EndTime, Converter={StaticResource TimeSpanToStringConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="4" TextAlignment="Center" FontSize="11"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- D) График за вентилиране с външен въздух -->
                        <Border BorderBrush="#CCC" BorderThickness="0,1,0,0" Padding="10">
                            <StackPanel>
                                <TextBlock Text="D) График за вентилиране с външен въздух" 
                                           FontWeight="Bold" FontSize="12" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Раб.дни:" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="11"/>
                                    <TextBox Grid.Column="1" Text="{Binding ObjectData.CoolingSchedules.OutdoorAirVentSchedule.Workdays.StartTime, Converter={StaticResource TimeSpanToStringConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="4" TextAlignment="Center" FontSize="11"/>
                                    <TextBlock Grid.Column="2" Text="–" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                                    <TextBox Grid.Column="3" Text="{Binding ObjectData.CoolingSchedules.OutdoorAirVentSchedule.Workdays.EndTime, Converter={StaticResource TimeSpanToStringConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="4" TextAlignment="Center" FontSize="11"/>
                                    
                                    <TextBlock Grid.Column="5" Text="Съб:" VerticalAlignment="Center" Margin="8,0,5,0" FontSize="11"/>
                                    <TextBox Grid.Column="6" Text="{Binding ObjectData.CoolingSchedules.OutdoorAirVentSchedule.Saturday.StartTime, Converter={StaticResource TimeSpanToStringConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="4" TextAlignment="Center" FontSize="11"/>
                                    <TextBlock Grid.Column="7" Text="–" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                                    <TextBox Grid.Column="8" Text="{Binding ObjectData.CoolingSchedules.OutdoorAirVentSchedule.Saturday.EndTime, Converter={StaticResource TimeSpanToStringConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="4" TextAlignment="Center" FontSize="11"/>
                                    
                                    <TextBlock Grid.Column="10" Text="Нед:" VerticalAlignment="Center" Margin="8,0,5,0" FontSize="11"/>
                                    <TextBox Grid.Column="11" Text="{Binding ObjectData.CoolingSchedules.OutdoorAirVentSchedule.Sunday.StartTime, Converter={StaticResource TimeSpanToStringConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="4" TextAlignment="Center" FontSize="11"/>
                                    <TextBlock Grid.Column="12" Text="–" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                                    <TextBox Grid.Column="13" Text="{Binding ObjectData.CoolingSchedules.OutdoorAirVentSchedule.Sunday.EndTime, Converter={StaticResource TimeSpanToStringConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="4" TextAlignment="Center" FontSize="11"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- БАЗА ДАННИ -->
                <Border BorderBrush="#0066CC" BorderThickness="2" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="База данни" 
                                   FontSize="14" FontWeight="Bold" Padding="12,10" 
                                   Background="#E6F2FF" Foreground="#0066CC"/>
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Климатична база данни:" 
                                       VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                            <ComboBox Grid.Column="1" 
                                      SelectedItem="{Binding CoolingClimateDatabase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Padding="5" FontSize="12" HorizontalAlignment="Left" Width="250">
                                <models:ClimateDatabase>BG</models:ClimateDatabase>
                                <models:ClimateDatabase>ASHRAE</models:ClimateDatabase>
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource ClimateDatabaseConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <!-- EPW File Picker (видим само когато е избран ASHRAE) -->
                        <Grid Margin="10,0,10,10" 
                              Visibility="{Binding CoolingClimateDatabase, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter=ASHRAE}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Label -->
                            <TextBlock Grid.Row="0" Grid.Column="0" 
                                       Text="EPW файл:" 
                                       VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>

                            <!-- File Name Display -->
                            <TextBlock Grid.Row="0" Grid.Column="1" 
                                       Text="{Binding EpwFileDisplayName}" 
                                       VerticalAlignment="Center" FontSize="12" 
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{Binding EpwFileDisplayColor}"
                                       Margin="0,0,10,0"/>

                            <!-- Load Button -->
                            <Button Grid.Row="0" Grid.Column="2" 
                                    Content="Избери EPW файл..." 
                                    Command="{Binding LoadEpwFileCommand}"
                                    Padding="10,5" FontSize="12" 
                                    Background="#0066CC" Foreground="White"
                                    BorderThickness="0" Cursor="Hand"/>

                            <!-- Location Info (когато има зареден файл) -->
                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                       Text="{Binding EpwLocationInfo}"
                                       FontSize="11" FontStyle="Italic" Foreground="#666"
                                       Margin="0,5,0,0"
                                       Visibility="{Binding EpwLocationInfo, Converter={StaticResource CollectionToVisibilityConverter}}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ОСНОВНИ ПАРАМЕТРИ -->
                <Border BorderBrush="#0066CC" BorderThickness="2" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Основни параметри" 
                                   FontSize="14" FontWeight="Bold" Padding="12,10" 
                                   Background="#E6F2FF" Foreground="#0066CC"/>
                        
                        <!-- Таблица с параметри -->
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>

                            <!-- Header row -->
                            <Border Grid.Row="0" Grid.Column="0" Background="#2E7D32" BorderBrush="White" BorderThickness="1">
                                <TextBlock Text="Параметър" FontWeight="Bold" Foreground="White" Padding="10,5" FontSize="12"/>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="1" Background="#2E7D32" BorderBrush="White" BorderThickness="0,1,1,1">
                                <TextBlock Text="Стойност" FontWeight="Bold" Foreground="White" Padding="10,5" FontSize="12" TextAlignment="Center"/>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="2" Background="#2E7D32" BorderBrush="White" BorderThickness="0,1,1,1">
                                <TextBlock Text="Единици" FontWeight="Bold" Foreground="White" Padding="10,5" FontSize="12" TextAlignment="Center"/>
                            </Border>

                            <!-- Row 1: h/week (readonly) -->
                            <Border Grid.Row="1" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="1,0,1,1">
                                <TextBlock Text="Работен режим (h/week)" Padding="10,5" FontSize="11"/>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                                <TextBox Text="{Binding HoursPerWeek, StringFormat=F2, Mode=OneWay}" 
                                         Style="{StaticResource ReadOnlyTextBoxStyle}" Padding="5" FontSize="11"/>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="2" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                                <TextBlock Text="h/седм" Padding="5" FontSize="11" TextAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Row 2: Supply airflow (editable) -->
                            <Border Grid.Row="2" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="1,0,1,1">
                                <TextBlock Text="Специфичен дебит на приточен въздух" Padding="10,5" FontSize="11"/>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                                <TextBox Text="{Binding CoolingSupplyAirflow, StringFormat=F2, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}" 
                                         Style="{StaticResource EditableTextBoxStyle}" Padding="5" FontSize="11"/>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="2" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                                <TextBlock Text="m³/h·m²" Padding="5" FontSize="11" TextAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Row 3: Supply temperature (editable) -->
                            <Border Grid.Row="3" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="1,0,1,1">
                                <TextBlock Text="Температура на подавания въздух" Padding="10,5" FontSize="11"/>
                            </Border>
                            <Border Grid.Row="3" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                                <TextBox Text="{Binding CoolingSupplyTemperature, StringFormat=F2, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}" 
                                         Style="{StaticResource EditableTextBoxStyle}" Padding="5" FontSize="11"/>
                            </Border>
                            <Border Grid.Row="3" Grid.Column="2" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                                <TextBlock Text="°C" Padding="5" FontSize="11" TextAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Row 4: Relative humidity (editable) -->
                            <Border Grid.Row="4" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="1,0,1,1">
                                <TextBlock Text="Относителна влажност на подавания въздух" Padding="10,5" FontSize="11"/>
                            </Border>
                            <Border Grid.Row="4" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                                <TextBox Text="{Binding CoolingRelativeHumidity, StringFormat=F2, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}" 
                                         Style="{StaticResource EditableTextBoxStyle}" Padding="5" FontSize="11"/>
                            </Border>
                            <Border Grid.Row="4" Grid.Column="2" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                                <TextBlock Text="%" Padding="5" FontSize="11" TextAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Row 5: Recuperation efficiency (editable) -->
                            <Border Grid.Row="5" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="1,0,1,1">
                                <TextBlock Text="Ефективност на рекуперация η_r" Padding="10,5" FontSize="11"/>
                            </Border>
                            <Border Grid.Row="5" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                                <TextBox Text="{Binding RecuperationEfficiency, StringFormat=F1, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}" 
                                         Style="{StaticResource EditableTextBoxStyle}" Padding="5" FontSize="11"/>
