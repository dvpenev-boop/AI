<UserControl x:Class="EE.Doklad.Views.CoolingSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:EE.Doklad.Converters"
             xmlns:models="clr-namespace:EE.Doklad.Models"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="900">

    <UserControl.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:TimeSpanToStringConverter x:Key="TimeSpanToStringConverter"/>

        <!-- Note: energy-related styles and converters are defined at Application scope (App.xaml)
             to ensure ComboBox item container styles are available to the popup visual root on first show.
             Keep section-specific styles here. -->

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,20,0,10"/>
        </Style>
        
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        
        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        
        <!-- Backwards-compatible alias used across views: ensure editable textboxes are vertically centered -->
        <Style x:Key="EditableTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource InputTextBoxStyle}">
            <!-- keep defaults from InputTextBoxStyle; individual TextBoxes set Width/TextAlignment -->
        </Style>
        
        <Style x:Key="ReadOnlyTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource InputTextBoxStyle}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#F9F9F9"/>
            <Setter Property="Foreground" Value="#555"/>
        </Style>
        
        <Style x:Key="ErrorTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Red"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="5,2,0,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <!-- Заглавие -->
            <TextBlock Text="12. Охлаждане"
                       FontSize="18" 
                       FontWeight="Bold" 
                       Margin="0,0,0,15"/>

            <!-- Warning text (when cooling season is NOT enabled) -->
            <Border Background="#FFF3CD" BorderBrush="#FFC107" BorderThickness="2" Padding="12" Margin="0,0,0,15"
                    Visibility="{Binding CoolingSeasonWarning, Converter={StaticResource StringToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠️" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding CoolingSeasonWarning}" 
                               FontSize="13" FontWeight="SemiBold" 
                               Foreground="#856404" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Main content (disabled when cooling season is NOT enabled) -->
            <StackPanel IsEnabled="{Binding IsCoolingSeasonEnabled}">

                <!-- Описание (свободен текст) -->
                <TextBlock Text="Описание:"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>
                
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         MinHeight="80"
                         Padding="10"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         FontSize="11"
                         Margin="0,0,0,20"
                         BorderBrush="#E0E0E0"
                         BorderThickness="1"/>

                <!-- ГРАФИЦИ ЗА ОХЛАДИТЕЛЕН ПЕРИОД (от ObjectData.CoolingSchedules) -->
                <Border BorderBrush="#0066CC" BorderThickness="2" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Графици за охладителен период" 
                                   FontSize="14" FontWeight="Bold" Padding="12,10" 
                                   Background="#E6F2FF" Foreground="#0066CC"/>

                        <!-- A) График за обитаване – охладителен период -->
                        <Border BorderBrush="#CCC" BorderThickness="0,1,0,0" Padding="10">
                            <StackPanel>
                                <TextBlock Text="A) График за обитаване – охладителен период" 
                                           FontWeight="Bold" FontSize="12" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Раб.дни:" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="11"/>
                                    <TextBox Grid.Column="1" Text="{Binding ObjectData.CoolingSchedules.OccupancyCoolingSchedule.Workdays.StartTime, Converter={StaticResource TimeSpanToStringConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="4" TextAlignment="Center" FontSize="11"/>
                                    <TextBlock Grid.Column="2" Text="–" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                                    <TextBox Grid.Column="3" Text="{Binding ObjectData.CoolingSchedules.OccupancyCoolingSchedule.Workdays.EndTime, Converter={StaticResource TimeSpanToStringConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="4" TextAlignment="Center" FontSize="11"/>
                                    
                                    <TextBlock Grid.Column="5" Text="Съб:" VerticalAlignment="Center" Margin="8,0,5,0" FontSize="11"/>
                                    <TextBox Grid.Column="6" Text="{Binding ObjectData.CoolingSchedules.OccupancyCoolingSchedule.Saturday.StartTime, Converter={StaticResource TimeSpanToStringConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="4" TextAlignment="Center" FontSize="11"/>
                                    <TextBlock Grid.Column="7" Text="–" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                                    <TextBox Grid.Column="8" Text="{Binding ObjectData.CoolingSchedules.OccupancyCoolingSchedule.Saturday.EndTime, Converter={StaticResource TimeSpanToStringConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="4" TextAlignment="Center" FontSize="11"/>
                                    
                                    <TextBlock Grid.Column="10" Text="Нед:" VerticalAlignment="Center" Margin="8,0,5,0" FontSize="11"/>
                                    <TextBox Grid.Column="11" Text="{Binding ObjectData.CoolingSchedules.OccupancyCoolingSchedule.Sunday.StartTime, Converter={StaticResource TimeSpanToStringConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="4" TextAlignment="Center" FontSize="11"/>
                                    <TextBlock Grid.Column="12" Text="–" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                                    <TextBox Grid.Column="13" Text="{Binding ObjectData.CoolingSchedules.OccupancyCoolingSchedule.Sunday.EndTime, Converter={StaticResource TimeSpanToStringConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="4" TextAlignment="Center" FontSize="11"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- B) График за охлаждане -->
                        <Border BorderBrush="#CCC" BorderThickness="0,1,0,0" Padding="10">
                            <StackPanel>
                                <TextBlock Text="B) График за охлаждане" 
                                           FontWeight="Bold" FontSize="12" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Раб.дни:" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="11"/>
                                    <TextBox Grid.Column="1" Text="{Binding ObjectData.CoolingSchedules.CoolingSchedule.Workdays.StartTime, Converter={StaticResource TimeSpanToStringConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="4" TextAlignment="Center" FontSize="11"/>
                                    <TextBlock Grid.Column="2" Text="–" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                                    <TextBox Grid.Column="3" Text="{Binding ObjectData.CoolingSchedules.CoolingSchedule.Workdays.EndTime, Converter={StaticResource TimeSpanToStringConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="4" TextAlignment="Center" FontSize="11"/>
                                    
                                    <TextBlock Grid.Column="5" Text="Съб:" VerticalAlignment="Center" Margin="8,0,5,0" FontSize="11"/>
                                    <TextBox Grid.Column="6" Text="{Binding ObjectData.CoolingSchedules.CoolingSchedule.Saturday.StartTime, Converter={StaticResource TimeSpanToStringConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="4" TextAlignment="Center" FontSize="11"/>
                                    <TextBlock Grid.Column="7" Text="–" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                                    <TextBox Grid.Column="8" Text="{Binding ObjectData.CoolingSchedules.CoolingSchedule.Saturday.EndTime, Converter={StaticResource TimeSpanToStringConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="4" TextAlignment="Center" FontSize="11"/>
                                    
                                    <TextBlock Grid.Column="10" Text="Нед:" VerticalAlignment="Center" Margin="8,0,5,0" FontSize="11"/>
                                    <TextBox Grid.Column="11" Text="{Binding ObjectData.CoolingSchedules.CoolingSchedule.Sunday.StartTime, Converter={StaticResource TimeSpanToStringConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="4" TextAlignment="Center" FontSize="11"/>
                                    <TextBlock Grid.Column="12" Text="–" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                                    <TextBox Grid.Column="13" Text="{Binding ObjectData.CoolingSchedules.CoolingSchedule.Sunday.EndTime, Converter={StaticResource TimeSpanToStringConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="4" TextAlignment="Center" FontSize="11"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- C) График за вентилация охлаждане -->
                        <Border BorderBrush="#CCC" BorderThickness="0,1,0,0" Padding="10">
                            <StackPanel>
                                <TextBlock Text="C) График за вентилация охлаждане" 
                                           FontWeight="Bold" FontSize="12" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Раб.дни:" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="11"/>
                                    <TextBox Grid.Column="1" Text="{Binding ObjectData.CoolingSchedules.VentilationCoolingSchedule.Workdays.StartTime, Converter={StaticResource TimeSpanToStringConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="4" TextAlignment="Center" FontSize="11"/>
                                    <TextBlock Grid.Column="2" Text="–" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                                    <TextBox Grid.Column="3" Text="{Binding ObjectData.CoolingSchedules.VentilationCoolingSchedule.Workdays.EndTime, Converter={StaticResource TimeSpanToStringConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="4" TextAlignment="Center" FontSize="11"/>
                                    
                                    <TextBlock Grid.Column="5" Text="Съб:" VerticalAlignment="Center" Margin="8,0,5,0" FontSize="11"/>
                                    <TextBox Grid.Column="6" Text="{Binding ObjectData.CoolingSchedules.VentilationCoolingSchedule.Saturday.StartTime, Converter={StaticResource TimeSpanToStringConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="4" TextAlignment="Center" FontSize="11"/>
                                    <TextBlock Grid.Column="7" Text="–" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                                    <TextBox Grid.Column="8" Text="{Binding ObjectData.CoolingSchedules.VentilationCoolingSchedule.Saturday.EndTime, Converter={StaticResource TimeSpanToStringConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="4" TextAlignment="Center" FontSize="11"/>
                                    
                                    <TextBlock Grid.Column="10" Text="Нед:" VerticalAlignment="Center" Margin="8,0,5,0" FontSize="11"/>
                                    <TextBox Grid.Column="11" Text="{Binding ObjectData.CoolingSchedules.VentilationCoolingSchedule.Sunday.StartTime, Converter={StaticResource TimeSpanToStringConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="4" TextAlignment="Center" FontSize="11"/>
                                    <TextBlock Grid.Column="12" Text="–" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                                    <TextBox Grid.Column="13" Text="{Binding ObjectData.CoolingSchedules.VentilationCoolingSchedule.Sunday.EndTime, Converter={StaticResource TimeSpanToStringConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="4" TextAlignment="Center" FontSize="11"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- D) График за вентилиране с външен въздух -->
                        <Border BorderBrush="#CCC" BorderThickness="0,1,0,0" Padding="10">
                            <StackPanel>
                                <TextBlock Text="D) График за вентилиране с външен въздух" 
                                           FontWeight="Bold" FontSize="12" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Раб.дни:" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="11"/>
                                    <TextBox Grid.Column="1" Text="{Binding ObjectData.CoolingSchedules.OutdoorAirVentSchedule.Workdays.StartTime, Converter={StaticResource TimeSpanToStringConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="4" TextAlignment="Center" FontSize="11"/>
                                    <TextBlock Grid.Column="2" Text="–" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                                    <TextBox Grid.Column="3" Text="{Binding ObjectData.CoolingSchedules.OutdoorAirVentSchedule.Workdays.EndTime, Converter={StaticResource TimeSpanToStringConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="4" TextAlignment="Center" FontSize="11"/>
                                    
                                    <TextBlock Grid.Column="5" Text="Съб:" VerticalAlignment="Center" Margin="8,0,5,0" FontSize="11"/>
                                    <TextBox Grid.Column="6" Text="{Binding ObjectData.CoolingSchedules.OutdoorAirVentSchedule.Saturday.StartTime, Converter={StaticResource TimeSpanToStringConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="4" TextAlignment="Center" FontSize="11"/>
                                    <TextBlock Grid.Column="7" Text="–" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                                    <TextBox Grid.Column="8" Text="{Binding ObjectData.CoolingSchedules.OutdoorAirVentSchedule.Saturday.EndTime, Converter={StaticResource TimeSpanToStringConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="4" TextAlignment="Center" FontSize="11"/>
                                    
                                    <TextBlock Grid.Column="10" Text="Нед:" VerticalAlignment="Center" Margin="8,0,5,0" FontSize="11"/>
                                    <TextBox Grid.Column="11" Text="{Binding ObjectData.CoolingSchedules.OutdoorAirVentSchedule.Sunday.StartTime, Converter={StaticResource TimeSpanToStringConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="4" TextAlignment="Center" FontSize="11"/>
                                    <TextBlock Grid.Column="12" Text="–" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                                    <TextBox Grid.Column="13" Text="{Binding ObjectData.CoolingSchedules.OutdoorAirVentSchedule.Sunday.EndTime, Converter={StaticResource TimeSpanToStringConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="4" TextAlignment="Center" FontSize="11"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Ръчни входове -->
            <TextBlock Text="Ръчни параметри:" Style="{StaticResource SectionHeaderStyle}"/>
            
            <Border BorderBrush="#666" BorderThickness="2" Margin="0,0,0,20" Width="470" HorizontalAlignment="Left">
                <StackPanel>
                    <!-- Keep only the first three manual inputs -->
                    <!-- Инфилтрация -->
                    <Border BorderBrush="#888" BorderThickness="0,0,0,1">
                        <Grid Background="White">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Инфилтрация [1/ч]" Style="{StaticResource LabelStyle}"/>
                            <StackPanel Grid.Column="1">
                                <TextBox Text="{Binding InfiltrationText, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource EditableTextBoxStyle}" Width="120" TextAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding InfiltrationError}"
                                          Style="{StaticResource ErrorTextStyle}"
                                          Visibility="{Binding HasInfiltrationError, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Проектна температура -->
                    <Border BorderBrush="#888" BorderThickness="0,0,0,1">
                        <Grid Background="White">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Проектна температура [°C]" Style="{StaticResource LabelStyle}"/>
                            <StackPanel Grid.Column="1">
                                <TextBox Text="{Binding DesignTemperatureText, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource EditableTextBoxStyle}" Width="120" TextAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding DesignTemperatureError}"
                                          Style="{StaticResource ErrorTextStyle}"
                                          Visibility="{Binding HasDesignTemperatureError, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Температура на понижение -->
                    <Border BorderBrush="#888" BorderThickness="0,0,0,1">
                        <Grid Background="White">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Температура с повишение [°C]" Style="{StaticResource LabelStyle}"/>
                            <StackPanel Grid.Column="1">
                                <TextBox Text="{Binding ReductionTemperatureText, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource EditableTextBoxStyle}" Width="120" TextAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding ReductionTemperatureError}"
                                          Style="{StaticResource ErrorTextStyle}"
                                          Visibility="{Binding HasReductionTemperatureError, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Относителна влажност -->
                    <Border BorderBrush="#888" BorderThickness="0,0,0,1">
                        <Grid Background="White">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Относителна влажност [%]" Style="{StaticResource LabelStyle}"/>
                            <StackPanel Grid.Column="1">
                                <TextBox Text="{Binding RelativeHumidityText, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource EditableTextBoxStyle}" Width="120" TextAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding RelativeHumidityError}"
                                          Style="{StaticResource ErrorTextStyle}"
                                          Visibility="{Binding HasRelativeHumidityError, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Специфичен топлинен капацитет -->
                    <Border BorderBrush="#888" BorderThickness="0,0,0,1">
                        <Grid Background="White">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Style="{StaticResource LabelStyle}"
                                       ToolTip="Специфичен топлинен капацитет на сградата. Използва се само при режим &quot;С топлинен капацитет&quot; за нощна вентилация (Секция 14). Типично: 15 Wh/m²K (лека конструкция) / 30 (средна) / 60+ (тежка).">
                                <Run Text="Специфичен топлинен капацитет [Wh/m²K]"/>
                            </TextBlock>
                            <StackPanel Grid.Column="1">
                                <TextBox Text="{Binding SpecificHeatCapacityText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource EditableTextBoxStyle}" Width="120" TextAlignment="Center" HorizontalAlignment="Center"
                                         ToolTip="Wh/m²K — препоръчани стойности: 15 (лека), 30 (средна, default), 60 (тежка конструкция)"/>
                                <TextBlock Text="{Binding SpecificHeatCapacityError}"
                                           Style="{StaticResource ErrorTextStyle}"
                                           Visibility="{Binding HasSpecificHeatCapacityError, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Енергийни източници за охлаждане -->
            <TextBlock Text="Енергийни източници за охлаждане" Style="{StaticResource SectionHeaderStyle}"/>
            <Border BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,20" Width="470" HorizontalAlignment="Left">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>

                    <!-- Header Row for Carrier selector -->
                    <Border Grid.Row="0" Grid.Column="0" Background="#1976D2" BorderBrush="White" BorderThickness="0,0,1,1">
                        <TextBlock Text="Параметър" FontWeight="Bold" Foreground="White" Padding="10" FontSize="13"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Background="#1976D2" BorderBrush="White" BorderThickness="0,0,0,1">
                        <ComboBox x:Name="CoolingEnergyCarrierCombo1"
                                  ItemsSource="{x:Static models:EnergyCarrierInfo.All}"
                                  SelectedValuePath="Code"
                                  SelectedValue="{Binding EnergySource1Carrier, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Padding="6,2"
                                  FontSize="11"
                                  HorizontalAlignment="Stretch"
                                  Margin="2"
                                  Style="{StaticResource EnergySourceComboBoxStyle}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="11" LineHeight="13" LineStackingStrategy="BlockLineHeight" Padding="0"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                            <ComboBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11" Foreground="#0066CC" Margin="0,2,0,1"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ComboBox.GroupStyle>
                        </ComboBox>
                    </Border>

                    <!-- Row 1: Дял -->
                    <Border Grid.Row="1" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Дял, %" Padding="10" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <TextBox Text="{Binding EnergySource1Share, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}" 
                                 Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" Width="120"/>
                    </Border>

                    <!-- Row 2: Ефективност на отдаване -->
                    <Border Grid.Row="2" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Ефективност на отдаване, %" Padding="10" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <TextBox Text="{Binding EnergySource1EmissionEfficiency, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}" 
                                 Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" Width="120"/>
                    </Border>

                    <!-- Row 3: Ефективност на разпределителната мрежа -->
                    <Border Grid.Row="3" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Ефективност на разпределителната мрежа, %" Padding="10" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="3" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <TextBox Text="{Binding EnergySource1DistributionEfficiency, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}" 
                                 Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" Width="120"/>
                    </Border>

                    <!-- Row 4: Автоматично управление -->
                    <Border Grid.Row="4" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Автоматично управление, %" Padding="10" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="4" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <TextBox Text="{Binding EnergySource1AutomaticControl, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}" 
                                 Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" Width="120"/>
                    </Border>

                    <!-- Row 5: Енергиен мениджмънт -->
                    <Border Grid.Row="5" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Енергиен мениджмънт (ЕМ) и поддръжка, %" Padding="10" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="5" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <TextBox Text="{Binding EnergySource1EnergyManagement, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}" 
                                 Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" Width="120"/>
                    </Border>

                    <!-- Row 6: Ефективност на генератора на топлина -->
                    <Border Grid.Row="6" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0">
                        <TextBlock Text="Ефективност на генератора на топлина, %" Padding="10" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="6" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,0,0">
                        <TextBox Text="{Binding EnergySource1GenerationEfficiency, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}" 
                                 Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" Width="120"/>
                    </Border>
                </Grid>
            </Border>

            <CheckBox Content="Използвай втори енергиен източник (ЕИ2)" 
                      IsChecked="{Binding UseSecondEnergySource}" 
                      FontWeight="Bold" 
                      Margin="0,0,0,10"/>

            <Border BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,20" 
                    Visibility="{Binding UseSecondEnergySource, Converter={StaticResource BoolToVisibilityConverter}}" Width="470" HorizontalAlignment="Left">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>

                    <!-- Header Row -->
                    <Border Grid.Row="0" Grid.Column="0" Background="#1976D2" BorderBrush="White" BorderThickness="0,0,1,1">
                        <TextBlock Text="Параметър" FontWeight="Bold" Foreground="White" Padding="10" FontSize="13"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Background="#1976D2" BorderBrush="White" BorderThickness="0,0,0,1">
                        <ComboBox x:Name="CoolingEnergyCarrierCombo2"
                                  ItemsSource="{x:Static models:EnergyCarrierInfo.All}"
                                  SelectedValuePath="Code"
                                  SelectedValue="{Binding EnergySource2Carrier, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Padding="6,2"
                                  FontSize="11"
                                  HorizontalAlignment="Stretch"
                                  Margin="2"
                                  Style="{StaticResource EnergySourceComboBoxStyle}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="11" LineHeight="13" LineStackingStrategy="BlockLineHeight" Padding="0"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                            <ComboBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11" Foreground="#0066CC" Margin="0,2,0,1"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ComboBox.GroupStyle>
                        </ComboBox>
                    </Border>

                    <!-- Row 1: Дял -->
                    <Border Grid.Row="1" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Дял, %" Padding="10" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <TextBox Text="{Binding EnergySource2Share, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}" 
                                 Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" Width="120"/>
                    </Border>

                    <!-- Row 2: Ефективност на отдаване -->
                    <Border Grid.Row="2" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Ефективност на отдаване, %" Padding="10" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <TextBox Text="{Binding EnergySource2EmissionEfficiency, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}" 
                                 Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" Width="120"/>
                    </Border>

                    <!-- Row 3: Ефективност на разпределителната мрежа -->
                    <Border Grid.Row="3" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Ефективност на разпределителната мрежа, %" Padding="10" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="3" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <TextBox Text="{Binding EnergySource2DistributionEfficiency, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}" 
                                 Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" Width="120"/>
                    </Border>

                    <!-- Row 4: Автоматично управление -->
                    <Border Grid.Row="4" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Автоматично управление, %" Padding="10" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="4" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <TextBox Text="{Binding EnergySource2AutomaticControl, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}" 
                                 Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" Width="120"/>
                    </Border>

                    <!-- Row 5: Енергиен мениджмънт -->
                    <Border Grid.Row="5" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Енергиен мениджмънт (ЕМ) и поддръжка, %" Padding="10" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="5" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <TextBox Text="{Binding EnergySource2EnergyManagement, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}" 
                                 Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" Width="120"/>
                    </Border>

                    <!-- Row 6: Ефективност на генератора на топлина -->
                    <Border Grid.Row="6" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0">
                        <TextBlock Text="Ефективност на генератора на топлина, %" Padding="10" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="6" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,0,0">
                        <TextBox Text="{Binding EnergySource2GenerationEfficiency, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}" 
                                 Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" Width="120"/>
                    </Border>
                </Grid>
            </Border>

            <!-- СЕКЦИЯ 2: ОБИТАТЕЛИ -->
            <TextBlock Text="Топлина от обитатели:" Style="{StaticResource SectionHeaderStyle}"/>
            
            <Border BorderBrush="#666" BorderThickness="2" Margin="0,0,0,20" Width="470" HorizontalAlignment="Left">
                <StackPanel>
                    <!-- Брой обитатели (read-only, от секция 5) -->
                    <Border BorderBrush="#888" BorderThickness="0,0,0,1">
                        <Grid Background="White">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Брой обитатели" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Column="1" Text="{Binding NumberOfOccupants, Mode=OneWay}"
                                    Style="{StaticResource ReadOnlyTextBoxStyle}" Width="120" TextAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Степен на активност (dropdown) -->
                    <Border BorderBrush="#888" BorderThickness="0,0,0,1">
                        <Grid Background="White">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Степен на активност" Style="{StaticResource LabelStyle}"/>
                            <ComboBox Grid.Column="1" 
                                     ItemsSource="{Binding ActivityLevelOptions}"
                                     SelectedValue="{Binding SelectedActivityLevel}"
                                     SelectedValuePath="Level"
                                     DisplayMemberPath="DisplayName"
                                     Padding="10"
                                     FontSize="12"
                                     Margin="2"
                                     VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Температура в помещението (read-only) -->
                    <Border BorderBrush="#888" BorderThickness="0,0,0,1">
                        <Grid Background="White">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Температура в помещението" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Column="1" Text="{Binding RoomTemperatureDisplay, Mode=OneWay}"
                                    Style="{StaticResource ReadOnlyTextBoxStyle}" Width="120" TextAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Явна топлина от един човек (read-only) -->
                    <Border BorderBrush="#888" BorderThickness="0,0,0,1">
                        <Grid Background="White">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Явна топлина от един човек [W]" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Column="1" Text="{Binding SensibleHeatPerPersonDisplay, Mode=OneWay}"
                                    Style="{StaticResource ReadOnlyTextBoxStyle}" Width="120" TextAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Скрита топлина от един човек (read-only) -->
                    <Border BorderBrush="#888" BorderThickness="0,0,0,1">
                        <Grid Background="White">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Скрита топлина от един човек [W]" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Column="1" Text="{Binding LatentHeatPerPersonDisplay, Mode=OneWay}"
                                    Style="{StaticResource ReadOnlyTextBoxStyle}" Width="120" TextAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Топлина от обитатели (read-only) -->
                    <Border BorderBrush="#888" BorderThickness="0,0,0,1">
                        <Grid Background="White">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Топлина от обитатели [W]" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Column="1" Text="{Binding TotalOccupantHeatDisplay, Mode=OneWay}"
                                    Style="{StaticResource ReadOnlyTextBoxStyle}" Width="120" TextAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Латентна топлина от обитатели (read-only) -->
                    <Border BorderBrush="#888" BorderThickness="0,0,0,1">
                        <Grid Background="White">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Латентна топлина от обитатели [W]" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Column="1" Text="{Binding TotalLatentHeatDisplay, Mode=OneWay}"
                                    Style="{StaticResource ReadOnlyTextBoxStyle}" Width="120" TextAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Топлина от обитатели W/m² (read-only) -->
                    <Border BorderBrush="#888" BorderThickness="0,0,0,1">
                        <Grid Background="White">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Топлина от обитатели [W/m²]" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Column="1" Text="{Binding TotalOccupantHeatPerAreaDisplay, Mode=OneWay}"
                                    Style="{StaticResource ReadOnlyTextBoxStyle}" Width="120" TextAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Латентна топлина от обитатели W/m² (read-only) -->
                    <Border BorderBrush="#888" BorderThickness="0,0,0,1">
                        <Grid Background="White">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Латентна топлина от обитатели [W/m²]" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Column="1" Text="{Binding TotalLatentHeatPerAreaDisplay, Mode=OneWay}"
                                    Style="{StaticResource ReadOnlyTextBoxStyle}" Width="120" TextAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding CooledAreaError}"
                              Style="{StaticResource ErrorTextStyle}"
                              Visibility="{Binding HasCooledAreaError, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </Border>

            </StackPanel> <!-- End of IsEnabled wrapper -->

            <!-- Информационна бележка -->
            <Border Background="#FFF9E6" BorderBrush="#FFD700" BorderThickness="1" Padding="15" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="ℹ Забележки:" FontWeight="Bold" FontSize="12" Margin="0,0,0,5"/>
                    <TextBlock TextWrapping="Wrap" FontSize="11" LineHeight="18">
                        <Run Text="• Стойностите за топлина на човек се изчисляват автоматично чрез линейна интерполация по температура."/>
                        <LineBreak/>
                        <Run Text="• Брой обитатели се взима от секция 5 (Данни за обекта)."/>
                        <LineBreak/>
                        <Run Text="• Температура в помещението е равна на проектната температура."/>
                        <LineBreak/>
                        <Run Text="• Десетичните стойности могат да се въвеждат с ',' или '.' като разделител."/>
                        <LineBreak/>
                        <Run Text="• Стойностите в W/m² се изчисляват на база охлаждаемата площ от секция 5."/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
