<UserControl x:Class="EE.Doklad.Views.EnergyClassSectionEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <!-- Заглавие -->
            <TextBlock Text="{Binding Title, FallbackValue='Клас на енергопотребление'}"
                       FontSize="18" 
                       FontWeight="Bold" 
                       Margin="0,0,0,15"/>

            <!-- Описание -->
            <TextBlock Text="Описание:"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Margin="0,0,0,5"/>
            
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                     MinHeight="60"
                     Padding="10"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     FontSize="11"
                     Margin="0,0,0,30"
                     BorderBrush="#E0E0E0"
                     BorderThickness="1"/>

            <!-- Информационен блок -->
            <Border Background="#E3F2FD" BorderBrush="#2196F3" BorderThickness="2" 
                    Padding="20" Margin="0,0,0,20" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="ℹ Автоматично определяне на клас" 
                              FontWeight="Bold" FontSize="14" Margin="0,0,0,15"
                              Foreground="#1976D2"/>
                    
                    <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10">
                        Класът на енергопотребление се определя автоматично на база избрания <Bold>Тип сграда</Bold> 
                        от секция "Данни за обекта" и стойността на <Bold>EP (годишна специфична енергия)</Bold>.
                    </TextBlock>

                    <TextBlock TextWrapping="Wrap" FontSize="12">
                        Въведете стойността на EP по-долу, за да видите изчисления клас.
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Входни данни -->
            <Border BorderBrush="#666" BorderThickness="2" Margin="0,0,0,20" Padding="0">
                <StackPanel>
                    <!-- Header -->
                    <Border Background="#2196F3" Padding="15">
                        <TextBlock Text="Входни данни" FontSize="14" FontWeight="Bold" Foreground="White"/>
                    </Border>

                    <!-- Тип сграда (read-only, идва от ObjectData) -->
                    <Border BorderBrush="#CCC" BorderThickness="0,0,0,1">
                        <Grid Background="White">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="3*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Тип сграда:" 
                                      Padding="15,12" FontWeight="SemiBold" FontSize="12" 
                                      Background="#F0F0F0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" 
                                      Text="{Binding BuildingTypeDisplay, FallbackValue='Не е избран'}" 
                                      Padding="15,12" FontSize="12" VerticalAlignment="Center"
                                      Background="#F5F5F5"/>
                        </Grid>
                    </Border>

                    <!-- EP - Годишна специфична енергия (редактируем) -->
                    <Border BorderBrush="#CCC" BorderThickness="0,0,0,0">
                        <Grid Background="White">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="3*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="EP - Годишна специфична енергия [kWh/m²]:" 
                                      Padding="15,12" FontWeight="SemiBold" FontSize="12" 
                                      Background="#F0F0F0" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" 
                                    Text="{Binding EnergyPerformance, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" 
                                    Padding="15,12" FontSize="12" VerticalAlignment="Center"
                                    BorderThickness="0"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Резултат: Изчислен клас -->
            <Border BorderBrush="#4CAF50" BorderThickness="3" Background="#F1F8F4" 
                    Padding="25" Margin="0,0,0,20" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Резултат: Енергиен клас" 
                              FontSize="14" FontWeight="Bold" Margin="0,0,0,15"
                              Foreground="#2E7D32"/>

                    <!-- Клас (голяма буква) -->
                    <Border Background="White" BorderBrush="#4CAF50" BorderThickness="2"
                            HorizontalAlignment="Center" Padding="40,20" Margin="0,0,0,15"
                            CornerRadius="8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="КЛАС" FontSize="14" FontWeight="SemiBold" 
                                      HorizontalAlignment="Center" Foreground="#555"/>
                            <TextBlock Text="{Binding ClassDisplay, FallbackValue='—'}" 
                                      FontSize="72" FontWeight="Bold" 
                                      HorizontalAlignment="Center" Foreground="#2E7D32"/>
                        </StackPanel>
                    </Border>

                    <!-- Описание на класа -->
                    <TextBlock Text="{Binding ClassDescription, FallbackValue='Моля, попълнете данните'}" 
                              FontSize="13" TextAlignment="Center" FontWeight="SemiBold"
                              Foreground="#1B5E20" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Помощна таблица с прагове -->
            <Border Background="#FFF9E6" BorderBrush="#FFB300" BorderThickness="1" 
                    Padding="15" Margin="0,10,0,0" CornerRadius="4"
                    x:Name="ThresholdsInfoBorder">
                <StackPanel>
                    <TextBlock Text="📊 Прагове за избрания тип сграда:" 
                              FontWeight="Bold" FontSize="12" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding ThresholdsInfo, FallbackValue=''}" 
                              TextWrapping="Wrap" FontSize="11" FontFamily="Consolas"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
