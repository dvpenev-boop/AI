<UserControl x:Class="EE.Doklad.Views.VentilationSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:EE.Doklad.Converters"
             xmlns:models="clr-namespace:EE.Doklad.Models"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1200">

    <UserControl.Resources>
        <converters:FlexibleDoubleConverter x:Key="FlexibleDoubleConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,8,0,2"/>
        </Style>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        
        <!-- Style Р В Р’В·Р В Р’В° editable Р РЋР вЂљР В Р’ВµР В РўвЂР В РЎвЂўР В Р вЂ Р В Р’Вµ -->
        <Style x:Key="EditableTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource InputTextBoxStyle}"/>
        
        <!-- Style Р В Р’В·Р В Р’В° read-only Р РЋР вЂљР В Р’ВµР В РўвЂР В РЎвЂўР В Р вЂ Р В Р’Вµ -->
        <Style x:Key="ReadOnlyTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource InputTextBoxStyle}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#F9F9F9"/>
            <Setter Property="Foreground" Value="#555"/>
        </Style>

        <!-- Style Р В Р’В·Р В Р’В° ComboBox -->
        <Style x:Key="EnergyComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <!-- Compact vertical spacing: small vertical padding, single-line height -->
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="11"/>
            <!-- Ensure popup is wide enough like section 18 without changing closed ComboBox width -->
            <Setter Property="MinWidth" Value="300"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E53935"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF5F5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EnergySourceComboBoxStyle" TargetType="ComboBox">
            <!-- Match section 18 visual: slightly smaller font and larger padding -->
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <!-- Ensure drop-down items are white with black text and have a blue selected state -->
            <Setter Property="ItemContainerStyle" Value="{StaticResource EnergyComboBoxItemStyle}"/>
            <!-- Make the closed ComboBox white with dark text and a blue border for accessibility -->
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#E53935"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <!-- Limit dropdown height but allow enough space to show many items -->
            <Setter Property="MaxDropDownHeight" Value="420"/>
        </Style>
        <Style x:Key="CompactEnergyComboBoxItemStyle" TargetType="ComboBoxItem" BasedOn="{StaticResource EnergyComboBoxItemStyle}">
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>
        <Style x:Key="CompactEnergySourceComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource EnergySourceComboBoxStyle}">
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource CompactEnergyComboBoxItemStyle}"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <!-- Р В РІР‚вЂќР В Р’В°Р В РЎвЂ“Р В Р’В»Р В Р’В°Р В Р вЂ Р В РЎвЂР В Р’Вµ -->
            <TextBlock Text="13. Вентилация Отопление"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,0,15"
                       Foreground="#D32F2F"/>

            <!-- Warning text (when heating season is NOT enabled) -->
            <Border Background="#FFF3CD" BorderBrush="#FFC107" BorderThickness="2" Padding="12" Margin="0,0,0,15"
                    Visibility="{Binding HeatingSeasonWarning, Converter={StaticResource StringToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠️" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding HeatingSeasonWarning}" 
                               FontSize="13" FontWeight="SemiBold" 
                               Foreground="#856404" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Main content (disabled when heating season is NOT enabled) -->
            <StackPanel IsEnabled="{Binding IsHeatingSeasonEnabled}">

                <!-- Р В Р Р‹Р РЋРІР‚С™Р В Р’В°Р РЋРІР‚С™Р В РЎвЂР РЋРІР‚РЋР В Р’ВµР В Р вЂ¦ Р РЋРІР‚С™Р В Р’ВµР В РЎвЂќР РЋР С“Р РЋРІР‚С™ -->
            <TextBlock Text="Попълнете данните за секция: 13. Вентилация Отопление"
                       FontSize="12"
                       FontStyle="Italic"
                       Foreground="DimGray"
                       Margin="0,0,0,20"/>

            <!-- Р В РЎвЂєР РЋР С“Р В Р вЂ¦Р В РЎвЂўР В Р вЂ Р В Р вЂ¦Р В РЎвЂ Р В Р вЂ Р РЋРІР‚В¦Р В РЎвЂўР В РўвЂР В Р вЂ¦Р В РЎвЂ Р В РЎвЂ”Р В Р’В°Р РЋР вЂљР В Р’В°Р В РЎВР В Р’ВµР РЋРІР‚С™Р РЋР вЂљР В РЎвЂ -->
            <TextBlock Text="Основни параметри" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,10"/>
            <Border BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,20" Width="820" HorizontalAlignment="Left">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <!-- First column reduced by 20% (400 -> 320) -->
                        <ColumnDefinition Width="520"/>
                        <!-- Uniform value column width for all tables -->
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <!-- Header Row -->
                    <Border Grid.Row="0" Grid.Column="0" Background="#D32F2F" BorderBrush="White" BorderThickness="0,0,1,1">
                        <TextBlock Text="Параметър" FontWeight="Bold" Foreground="White" Padding="10,4" FontSize="13"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Background="#D32F2F" BorderBrush="White" BorderThickness="0,0,1,1">
                        <TextBlock Text="Стойност" FontWeight="Bold" Foreground="White" Padding="10,4" FontSize="13" HorizontalAlignment="Center"/>
                    </Border>
                    <!-- unit column removed -->

                    <!-- Row 1: Р В Р’В Р В Р’В°Р В Р’В±Р В РЎвЂўР РЋРІР‚С™Р В Р’ВµР В Р вЂ¦ Р РЋР вЂљР В Р’ВµР В Р’В¶Р В РЎвЂР В РЎВ -->
                    <Border Grid.Row="1" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Работен режим, h/week" Style="{StaticResource LabelStyle}" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBox Text="{Binding OperatingHoursPerWeek, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}" 
                                 Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" HorizontalAlignment="Stretch"/>
                    </Border>
                    

                    <!-- Row 2: Р В РІР‚СњР В Р’ВµР В Р’В±Р В РЎвЂР РЋРІР‚С™ -->
                    <Border Grid.Row="2" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Дебит, m³/h на m²" Style="{StaticResource LabelStyle}" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBox Text="{Binding AirflowRatePerM2, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}" 
                                 Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" HorizontalAlignment="Stretch"/>
                    </Border>
                    

                    <!-- Row 3: Р В РЎС›Р В Р’ВµР В РЎВР В РЎвЂ”Р В Р’ВµР РЋР вЂљР В Р’В°Р РЋРІР‚С™Р РЋРЎвЂњР РЋР вЂљР В Р’В° Р В Р вЂ¦Р В Р’В° Р В РЎвЂ”Р В РЎвЂўР В РўвЂР В Р’В°Р В Р вЂ Р В Р’В°Р В Р вЂ¦Р В Р’Вµ -->
                    <Border Grid.Row="3" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Температура на подаване, °C" Style="{StaticResource LabelStyle}" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="3" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBox Text="{Binding SupplyTemperature, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}" 
                                 Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" HorizontalAlignment="Stretch"/>
                    </Border>

                    <!-- Row 4: Р В РЎвЂєР РЋРІР‚С™Р В Р вЂ¦Р В РЎвЂўР РЋР С“Р В РЎвЂР РЋРІР‚С™Р В Р’ВµР В Р’В»Р В Р вЂ¦Р В Р’В° Р В Р вЂ Р В Р’В»Р В Р’В°Р В Р’В¶Р В Р вЂ¦Р В РЎвЂўР РЋР С“Р РЋРІР‚С™ -->
                    <Border Grid.Row="4" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Относителна влажност на подавания въздух, %" Style="{StaticResource LabelStyle}" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="4" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBox Text="{Binding RelativeHumidity, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}" 
                                 Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" HorizontalAlignment="Stretch"/>
                    </Border>

                    <!-- Row 5: Р В РІР‚СћР РЋРІР‚С›Р В Р’ВµР В РЎвЂќР РЋРІР‚С™Р В РЎвЂР В Р вЂ Р В Р вЂ¦Р В РЎвЂўР РЋР С“Р РЋРІР‚С™ Р В Р вЂ¦Р В Р’В° Р В РЎвЂ”Р РЋР вЂ°Р РЋР вЂљР В Р вЂ Р В Р’В° Р РЋР С“Р РЋРІР‚С™Р В Р’ВµР В РЎвЂ”Р В Р’ВµР В Р вЂ¦ Р В Р вЂ¦Р В Р’В° Р РЋР вЂљР В Р’ВµР В РЎвЂќР РЋРЎвЂњР В РЎвЂ”Р В Р’ВµР РЋР вЂљР В Р’В°Р РЋРІР‚В Р В РЎвЂР РЋР РЏ -->
                    <Border Grid.Row="5" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Ефективност на първа степен на рекуперация, %" Style="{StaticResource LabelStyle}" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="5" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBox Text="{Binding FirstStageRecuperationEfficiency, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}" 
                                 Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" HorizontalAlignment="Stretch"/>
                    </Border>

                    <!-- Row 6: Р В РІР‚СћР РЋРІР‚С›Р В Р’ВµР В РЎвЂќР РЋРІР‚С™Р В РЎвЂР В Р вЂ Р В Р вЂ¦Р В РЎвЂўР РЋР С“Р РЋРІР‚С™ Р В Р вЂ¦Р В Р’В° Р В Р вЂ Р РЋРІР‚С™Р В РЎвЂўР РЋР вЂљР В Р’В° Р РЋР С“Р РЋРІР‚С™Р В Р’ВµР В РЎвЂ”Р В Р’ВµР В Р вЂ¦ Р В Р вЂ¦Р В Р’В° Р РЋР вЂљР В Р’ВµР В РЎвЂќР РЋРЎвЂњР В РЎвЂ”Р В Р’ВµР РЋР вЂљР В Р’В°Р РЋРІР‚В Р В РЎвЂР РЋР РЏ -->
                    <Border Grid.Row="6" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Ефективност на втора степен на рекуперация, %" Style="{StaticResource LabelStyle}" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="6" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBox Text="{Binding SecondStageRecuperationEfficiency, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}" 
                                 Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" HorizontalAlignment="Stretch"/>
                    </Border>

                    <!-- Row 7: Р В РЎС™Р В Р’В°Р В РЎвЂќР РЋР С“. Р РЋР вЂљР В Р’В°Р В Р’В·Р В Р’В»Р В РЎвЂР В РЎвЂќР В Р’В° Р В Р вЂ¦Р В Р’В° Р РЋРІР‚С™Р В Р’ВµР В РЎВР В РЎвЂ”Р В Р’ВµР РЋР вЂљР В Р’В°Р РЋРІР‚С™Р РЋРЎвЂњР РЋР вЂљР В Р’В° Р В РЎвЂ”Р РЋР вЂљР В РЎвЂ Р В Р’В·Р В Р’В°Р В РЎвЂ“Р РЋР вЂљР РЋР РЏР В Р вЂ Р В Р’В°Р В Р вЂ¦Р В Р’Вµ -->
                    <Border Grid.Row="7" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Макс. разлика на температура при загряване на въздуха във втора степен (от 4 до 8), °C" 
                                   Style="{StaticResource LabelStyle}" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="7" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBox Text="{Binding MaxTemperatureDifferenceSecondStage, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}" 
                                 Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" HorizontalAlignment="Stretch"/>
                    </Border>

                    <!-- Row 8: Р В РЎС™Р В РЎвЂР В Р вЂ¦. Р В РЎвЂќР РЋР вЂљР В Р’В°Р В РІвЂћвЂ“Р В Р вЂ¦Р В Р’В° Р РЋРІР‚С™Р В Р’ВµР В РЎВР В РЎвЂ”Р В Р’ВµР РЋР вЂљР В Р’В°Р РЋРІР‚С™Р РЋРЎвЂњР РЋР вЂљР В Р’В° Р В Р вЂ¦Р В Р’В° Р В РЎвЂўР РЋРІР‚С™Р РЋР вЂљР В Р’В°Р В Р’В±Р В РЎвЂўР РЋРІР‚С™Р В Р’ВµР В Р вЂ¦Р В РЎвЂР РЋР РЏ Р В Р вЂ Р РЋР вЂ°Р В Р’В·Р В РўвЂР РЋРЎвЂњР РЋРІР‚В¦ -->
                    <Border Grid.Row="8" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
                        <TextBlock Text="Мин. крайна температура на отработения въздух (от 3 до 5), °C" 
                                   Style="{StaticResource LabelStyle}" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="8" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
                        <TextBox Text="{Binding MinExhaustAirTemperature, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}" 
                                 Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" HorizontalAlignment="Stretch"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Р В РІР‚СћР В Р вЂ¦Р В Р’ВµР РЋР вЂљР В РЎвЂ“Р В РЎвЂР В Р’ВµР В Р вЂ¦ Р В РЎвЂР В Р’В·Р РЋРІР‚С™Р В РЎвЂўР РЋРІР‚РЋР В Р вЂ¦Р В РЎвЂР В РЎвЂќ 1 (Р В РІР‚СћР В Р’В1) -->
            <TextBlock Text="Енергиен източник 1 (ЕИ1), %" FontSize="14" FontWeight="Bold" Margin="0,10,0,10"/>
            <Border BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,20" Width="820" HorizontalAlignment="Left">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <!-- First column reduced by 20% -->
                        <ColumnDefinition Width="520"/>
                        <!-- Uniform value column width -->
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <!-- Header Row -->
                    <Border Grid.Row="0" Grid.Column="0" Background="#E53935" BorderBrush="White" BorderThickness="0,0,1,1">
                        <TextBlock Text="Параметър" FontWeight="Bold" Foreground="White" Padding="10,4" FontSize="13"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Background="#E53935" BorderBrush="White" BorderThickness="0,0,0,1">
                        <ComboBox x:Name="EnergyCarrierCombo1"
                                  ItemsSource="{x:Static models:EnergyCarrierInfo.All}"
                                  SelectedValuePath="Code"
                                  SelectedValue="{Binding EnergySource1Carrier, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Padding="0"
                                  FontSize="10"
                                  HorizontalAlignment="Stretch"
                                  Margin="1"
                                  Style="{StaticResource CompactEnergySourceComboBoxStyle}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="10" LineHeight="13" LineStackingStrategy="BlockLineHeight" Padding="0"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                            <ComboBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="10" Foreground="#0066CC" Margin="0,2,0,1"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ComboBox.GroupStyle>
                        </ComboBox>
                    </Border>

                    <!-- Row 1: Р В РІР‚СњР РЋР РЏР В Р’В» -->
                    <Border Grid.Row="1" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Дял, %" Style="{StaticResource LabelStyle}" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <TextBox Text="{Binding EnergySource1Share, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}" 
                                 Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" HorizontalAlignment="Stretch"/>
                    </Border>

                    <!-- Row 2: Р В РІР‚СћР РЋРІР‚С›Р В Р’ВµР В РЎвЂќР РЋРІР‚С™Р В РЎвЂР В Р вЂ Р В Р вЂ¦Р В РЎвЂўР РЋР С“Р РЋРІР‚С™ Р В Р вЂ¦Р В Р’В° Р В РЎвЂўР РЋРІР‚С™Р В РўвЂР В Р’В°Р В Р вЂ Р В Р’В°Р В Р вЂ¦Р В Р’Вµ -->
                    <Border Grid.Row="2" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Ефективност на отдаване, %" Style="{StaticResource LabelStyle}" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <TextBox Text="{Binding EnergySource1EmissionEfficiency, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}" 
                                 Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" HorizontalAlignment="Stretch"/>
                    </Border>

