                    <TextBlock Grid.Row="0" Grid.Column="9" Text="Септ" Padding="6" FontWeight="Bold" FontSize="13" TextAlignment="Center" Background="#D0D0D0"/>
                    <TextBlock Grid.Row="0" Grid.Column="10" Text="Окт" Padding="6" FontWeight="Bold" FontSize="13" TextAlignment="Center" Background="#D0D0D0"/>
                    <TextBlock Grid.Row="0" Grid.Column="11" Text="Ноем" Padding="6" FontWeight="Bold" FontSize="13" TextAlignment="Center" Background="#D0D0D0"/>
                    <TextBlock Grid.Row="0" Grid.Column="12" Text="Дек" Padding="6" FontWeight="Bold" FontSize="13" TextAlignment="Center" Background="#D0D0D0"/>
