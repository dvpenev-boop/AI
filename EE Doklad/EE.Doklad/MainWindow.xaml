<Window x:Class="EE.Doklad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EE.Doklad.Views"
        xmlns:vm="clr-namespace:EE.Doklad.ViewModels"
        xmlns:converters="clr-namespace:EE.Doklad.Converters"
        mc:Ignorable="d"
        Title="EE Доклад - Енергиен доклад" Height="700" Width="1200">
    
    <Window.Resources>
        <converters:SectionTypeToVisibilityConverter x:Key="SectionTypeToVisibilityConverter"/>
    </Window.Resources>
    
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Меню -->
        <Menu Grid.Row="0">
            <MenuItem Header="_Файл">
                <MenuItem Header="_Нов доклад" Command="{Binding NewReportCommand}"/>
                <MenuItem Header="_Отвори..." Command="{Binding OpenReportCommand}"/>
                <MenuItem Header="_Запази..." Command="{Binding SaveReportCommand}"/>
                <Separator/>
                <MenuItem Header="Из_ход" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Експорт">
                <MenuItem Header="Експорт в _PDF..." Command="{Binding ExportToPdfCommand}"/>
            </MenuItem>
            <MenuItem Header="_Помощ">
                <MenuItem Header="_За програмата" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- Основен layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Лява панел - секции -->
            <Border Grid.Column="0" BorderBrush="LightGray" BorderThickness="0,0,1,0" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding CurrentReport.Title}" 
                               FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                    
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button Content="+ Добави секция" 
                                Command="{Binding AddSectionCommand}" 
                                Margin="0,0,0,5"
                                Padding="5"
                                Background="#4CAF50"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                FontWeight="SemiBold"/>
                        <Button Content="🗑 Изтрий секция" 
                                Command="{Binding DeleteSectionCommand}"
                                Padding="5"
                                Background="#F44336"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                FontWeight="SemiBold"/>
                    </StackPanel>
                    
                    <ListBox ItemsSource="{Binding CurrentReport.Sections}"
                             SelectedItem="{Binding SelectedSection}"
                             DisplayMemberPath="Title"/>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>

            <!-- Дясна панел - съдържание на секцията -->
            <ScrollViewer Grid.Column="2" 
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          x:Name="ContentScrollViewer"
                          Focusable="True"
                          PanningMode="VerticalOnly">
                <!-- Content се задава динамично от code-behind -->
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
