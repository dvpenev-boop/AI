<UserControl x:Class="EE.Doklad.Views.InternalGainsDebugView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="1000" d:DesignWidth="1200">
    <UserControl.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,14,0,5"/>
            <Setter Property="Foreground" Value="#1a1a2e"/>
        </Style>
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#555"/>
        </Style>
        <Style x:Key="ReadOnlyValue" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#374151"/>
        </Style>
        <Style x:Key="EditableValue" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="InfoCard" TargetType="Border">
            <Setter Property="Background" Value="#EFF6FF"/>
            <Setter Property="BorderBrush" Value="#BFDBFE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="White">
        <StackPanel Margin="24,16,24,32">
            <TextBlock Text="23. Vatreshni toplinni pechalbi - avtomatichno izchislenie"
                       FontSize="21" FontWeight="Bold" Foreground="#1a1a2e"/>
            <TextBlock Text="Formulи 3.32 i 3.33  |  EN ISO 52016-1  |  Otoплenie + Ohlazdane po meseci"
                       FontSize="11" Foreground="#6B7280" Margin="0,2,0,12"/>
            <Separator/>
            <TextBlock Style="{StaticResource SectionHeader}" Text="Данни от Секция 5 (само за четене)"/>
            <Border Style="{StaticResource InfoCard}">
                <TextBlock x:Name="TxtNoObjectData"
                           Text="Секция 5 не е намерена или не е попълнена."
                           Foreground="#92400E" FontSize="12" TextWrapping="Wrap"
                           Visibility="Collapsed"/>
            </Border>
            <Border Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelText}" Text="Активни режими:"/>
                    <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TxtActiveModesRO" Style="{StaticResource ReadOnlyValue}"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelText}" Text="Отопляема площ A_use [m2]:"/>
                    <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TxtAreaHeatRO" Style="{StaticResource ReadOnlyValue}"/>
                    <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource LabelText}" Text="Охлаждаема площ A_use [m2]:"/>
                    <TextBox   Grid.Row="2" Grid.Column="4" x:Name="TxtAreaCoolRO" Style="{StaticResource ReadOnlyValue}"/>
                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource LabelText}" Text="Отоплителен сезон:"/>
                    <TextBox   Grid.Row="4" Grid.Column="1" x:Name="TxtHeatSeasonRO" Style="{StaticResource ReadOnlyValue}" Grid.ColumnSpan="2"/>
                    <TextBlock Grid.Row="4" Grid.Column="3" Style="{StaticResource LabelText}" Text="Охладителен сезон:"/>
                    <TextBox   Grid.Row="4" Grid.Column="4" x:Name="TxtCoolSeasonRO" Style="{StaticResource ReadOnlyValue}" Grid.ColumnSpan="2"/>
                    <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource LabelText}" Text="График отопл. (Пн/Сб/Нд h):"/>
                    <TextBox   Grid.Row="6" Grid.Column="1" x:Name="TxtHeatSchedRO" Style="{StaticResource ReadOnlyValue}" Grid.ColumnSpan="2"/>
                    <TextBlock Grid.Row="6" Grid.Column="3" Style="{StaticResource LabelText}" Text="График охл. (Пн/Сб/Нд h):"/>
                    <TextBox   Grid.Row="6" Grid.Column="4" x:Name="TxtCoolSchedRO" Style="{StaticResource ReadOnlyValue}" Grid.ColumnSpan="2"/>
                </Grid>
            </Border>
            <TextBlock Style="{StaticResource SectionHeader}" Text="Параметри на изчислението"/>
            <Border Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelText}" Text="Използваема площ A_use [m2]:"/>
                    <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TxtAuse" Style="{StaticResource ReadOnlyValue}"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelText}" Text="Процесна топлина Phi_proc [W]:"/>
                    <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TxtProcessHeat" Style="{StaticResource EditableValue}"
                               ToolTip="+ = топлинен процес, - = охладителен процес. 0 = не участва."/>
                    <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource LabelText}" Text="Работни часове на процеса [h/год]:"/>
                    <TextBox   Grid.Row="2" Grid.Column="4" x:Name="TxtProcessHours" Style="{StaticResource EditableValue}"/>
                </Grid>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="Изчисли - всички месеци (Отопление + Охлаждане)"
                        Style="{StaticResource PrimaryBtn}"
                        Click="BtnCalculate_Click" Padding="20,9"/>
            </StackPanel>
            <Border x:Name="PanelErrors" Background="#FEF3C7" BorderBrush="#FDE68A"
                    BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,8,0,0"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="TxtErrorsTitle" Text="Предупреждения:"
                               FontWeight="SemiBold" Foreground="#92400E" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtErrors" Foreground="#92400E" TextWrapping="Wrap" FontSize="12"/>
                </StackPanel>
            </Border>
            <StackPanel x:Name="PanelResults" Visibility="Collapsed">
                <Separator Margin="0,16,0,10"/>
                <TextBlock Text="Резултати - месечни вътрешни топлинни печалби"
                           FontSize="17" FontWeight="Bold" Foreground="#1a1a2e"/>
                <TextBlock Style="{StaticResource SectionHeader}" Text="Отоплителен сезон - Q_H;int;dir;m по компоненти [kWh]"/>
                <TextBlock x:Name="TxtHeatSeasonInfo" FontSize="11" Foreground="#6B7280" Margin="0,0,0,4"/>
                <DataGrid x:Name="DgHeating"
                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          GridLinesVisibility="All" HeadersVisibility="Column"
                          BorderBrush="#E5E7EB" BorderThickness="1"
                          RowBackground="White" AlternatingRowBackground="#FFF8F0"
                          FontSize="12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Месец"      Binding="{Binding MonthName}"             Width="80"/>
                        <DataGridTextColumn Header="Oc [kWh]"   Binding="{Binding Oc,   StringFormat=F2}" Width="85"/>
                        <DataGridTextColumn Header="A [kWh]"    Binding="{Binding A,    StringFormat=F2}" Width="85"/>
                        <DataGridTextColumn Header="L [kWh]"    Binding="{Binding L,    StringFormat=F2}" Width="85"/>
                        <DataGridTextColumn Header="WA [kWh]"   Binding="{Binding WA,   StringFormat=F2}" Width="85"/>
                        <DataGridTextColumn Header="HVAC [kWh]" Binding="{Binding HVAC, StringFormat=F2}" Width="90"/>
                        <DataGridTextColumn Header="Proc [kWh]" Binding="{Binding Proc, StringFormat=F2}" Width="90"/>
                        <DataGridTextColumn Header="Total [kWh]" Binding="{Binding Total, StringFormat=F2}" Width="95"/>
                        <DataGridTextColumn Header="kWh/m2"     Binding="{Binding TotalPerM2, StringFormat=F3}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Border Style="{StaticResource CardBorder}" Background="#FFF8F0" Margin="0,4,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource LabelText}" Text="Sigma Отопление [kWh]: " Margin="0,0,4,0"/>
                        <TextBlock x:Name="TxtHeatTotal" FontSize="14" FontWeight="Bold"
                                   Foreground="#B45309" VerticalAlignment="Center"/>
                        <TextBlock Style="{StaticResource LabelText}" Text="   Специфично [kWh/m2/год]: "
                                   Margin="16,0,4,0"/>
                        <TextBlock x:Name="TxtHeatTotalPerM2" FontSize="14" FontWeight="Bold"
                                   Foreground="#92400E" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource SectionHeader}" Text="Охладителен сезон - Q_C;int;dir;m по компоненти [kWh]"/>
                <TextBlock x:Name="TxtCoolSeasonInfo" FontSize="11" Foreground="#6B7280" Margin="0,0,0,4"/>
                <DataGrid x:Name="DgCooling"
                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          GridLinesVisibility="All" HeadersVisibility="Column"
                          BorderBrush="#E5E7EB" BorderThickness="1"
                          RowBackground="White" AlternatingRowBackground="#EFF6FF"
                          FontSize="12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Месец"      Binding="{Binding MonthName}"             Width="80"/>
                        <DataGridTextColumn Header="Oc [kWh]"   Binding="{Binding Oc,   StringFormat=F2}" Width="85"/>
                        <DataGridTextColumn Header="A [kWh]"    Binding="{Binding A,    StringFormat=F2}" Width="85"/>
                        <DataGridTextColumn Header="L [kWh]"    Binding="{Binding L,    StringFormat=F2}" Width="85"/>
                        <DataGridTextColumn Header="WA [kWh]"   Binding="{Binding WA,   StringFormat=F2}" Width="85"/>
                        <DataGridTextColumn Header="HVAC [kWh]" Binding="{Binding HVAC, StringFormat=F2}" Width="90"/>
                        <DataGridTextColumn Header="Proc [kWh]" Binding="{Binding Proc, StringFormat=F2}" Width="90"/>
                        <DataGridTextColumn Header="Total [kWh]" Binding="{Binding Total, StringFormat=F2}" Width="95"/>
                        <DataGridTextColumn Header="kWh/m2"     Binding="{Binding TotalPerM2, StringFormat=F3}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Border Style="{StaticResource CardBorder}" Background="#EFF6FF" Margin="0,4,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource LabelText}" Text="Sigma Охлаждане [kWh]: " Margin="0,0,4,0"/>
                        <TextBlock x:Name="TxtCoolTotal" FontSize="14" FontWeight="Bold"
                                   Foreground="#1D4ED8" VerticalAlignment="Center"/>
                        <TextBlock Style="{StaticResource LabelText}" Text="   Специфично [kWh/m2/год]: "
                                   Margin="16,0,4,0"/>
                        <TextBlock x:Name="TxtCoolTotalPerM2" FontSize="14" FontWeight="Bold"
                                   Foreground="#1E40AF" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border x:Name="PanelFallbacks" Background="#FFFBEB" BorderBrush="#FDE68A"
                        BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,8,0,0"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Бележки / препоръки:"
                                   FontWeight="SemiBold" Foreground="#92400E" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtFallbacks" Foreground="#78350F" TextWrapping="Wrap" FontSize="11"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource InfoCard}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Легенда на компонентите" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock FontSize="11" Foreground="#374151" TextWrapping="Wrap"
                                   Text="Oc - Обитатели | A - Уреди (Сек.18) | L - Осветление (Сек.17) | WA - ВиК рег.загуби (Сек.16) | HVAC - Помпи/вентил. (Сек.15) | Proc - Процесна топлина"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>