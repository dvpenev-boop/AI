<UserControl x:Class="EE.Doklad.Views.VentilationSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:EE.Doklad.Converters"
             xmlns:models="clr-namespace:EE.Doklad.Models"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1200">

    <UserControl.Resources>
        <converters:FlexibleDoubleConverter x:Key="FlexibleDoubleConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        
        <!-- Style за editable редове -->
        <Style x:Key="EditableTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#2196F3"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        
        <!-- Style за read-only редове -->
        <Style x:Key="ReadOnlyTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource EditableTextBoxStyle}">
            <Setter Property="IsReadOnly" Value="True"/>
            <!-- Use white background (remove grey) so results display plainly -->
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
        </Style>

        <!-- Style за ComboBox -->
        <Style x:Key="EnergyComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <!-- Compact vertical spacing: small vertical padding, single-line height -->
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="11"/>
            <!-- Ensure popup is wide enough like section 18 without changing closed ComboBox width -->
            <Setter Property="MinWidth" Value="300"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1976D2"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E3F2FD"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EnergySourceComboBoxStyle" TargetType="ComboBox">
            <!-- Match section 18 visual: slightly smaller font and larger padding -->
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <!-- Ensure drop-down items are white with black text and have a blue selected state -->
            <Setter Property="ItemContainerStyle" Value="{StaticResource EnergyComboBoxItemStyle}"/>
            <!-- Make the closed ComboBox white with dark text and a blue border for accessibility -->
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <!-- Limit dropdown height but allow enough space to show many items -->
            <Setter Property="MaxDropDownHeight" Value="420"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <!-- Заглавие -->
            <TextBlock Text="12. Вентилация - отопление"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,0,15"
                       Foreground="#D32F2F"/>

            <!-- Warning text (when heating season is NOT enabled) -->
            <Border Background="#FFF3CD" BorderBrush="#FFC107" BorderThickness="2" Padding="12" Margin="0,0,0,15"
                    Visibility="{Binding HeatingSeasonWarning, Converter={StaticResource StringToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠️" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding HeatingSeasonWarning}" 
                               FontSize="13" FontWeight="SemiBold" 
                               Foreground="#856404" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Main content (disabled when heating season is NOT enabled) -->
            <StackPanel IsEnabled="{Binding IsHeatingSeasonEnabled}">

                <!-- Статичен текст -->
            <TextBlock Text="Попълнете данните за секция: 12. Вентилация"
                       FontSize="12"
                       FontStyle="Italic"
                       Foreground="DimGray"
                       Margin="0,0,0,20"/>

            <!-- Основни входни параметри -->
            <TextBlock Text="Основни параметри" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
            <Border BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <!-- First column reduced by 20% (400 -> 320) -->
                        <ColumnDefinition Width="320"/>
                        <!-- Uniform value column width for all tables -->
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>

                    <!-- Header Row -->
                    <Border Grid.Row="0" Grid.Column="0" Background="#D32F2F" BorderBrush="White" BorderThickness="0,0,1,1">
                        <TextBlock Text="Параметър" FontWeight="Bold" Foreground="White" Padding="10" FontSize="13"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Background="#D32F2F" BorderBrush="White" BorderThickness="0,0,1,1">
                        <TextBlock Text="Стойност" FontWeight="Bold" Foreground="White" Padding="10" FontSize="13" HorizontalAlignment="Center"/>
                    </Border>
                    <!-- unit column removed -->

                    <!-- Row 1: Работен режим -->
                    <Border Grid.Row="1" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Работен режим, h/week" Padding="10" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBox Text="{Binding OperatingHoursPerWeek, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}" 
                                 Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" VerticalAlignment="Center" Width="120"/>
                    </Border>
                    

                    <!-- Row 2: Дебит -->
                    <Border Grid.Row="2" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Дебит, m³/h на m²" Padding="10" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBox Text="{Binding AirflowRatePerM2, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}" 
                                 Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" VerticalAlignment="Center" Width="120"/>
                    </Border>
                    

                    <!-- Row 3: Температура на подаване -->
                    <Border Grid.Row="3" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Температура на подаване, °C" Padding="10" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="3" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBox Text="{Binding SupplyTemperature, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}" 
                                 Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" VerticalAlignment="Center" Width="120"/>
                    </Border>

                    <!-- Row 4: Относителна влажност -->
                    <Border Grid.Row="4" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Относителна влажност на подавания въздух, %" Padding="10" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="4" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBox Text="{Binding RelativeHumidity, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}" 
                                 Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" VerticalAlignment="Center" Width="120"/>
                    </Border>

                    <!-- Row 5: Ефективност на първа степен на рекуперация -->
                    <Border Grid.Row="5" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Ефективност на първа степен на рекуперация, %" Padding="10" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="5" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBox Text="{Binding FirstStageRecuperationEfficiency, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}" 
                                 Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" VerticalAlignment="Center" Width="120"/>
                    </Border>

                    <!-- Row 6: Ефективност на втора степен на рекуперация -->
                    <Border Grid.Row="6" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Ефективност на втора степен на рекуперация, %" Padding="10" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="6" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBox Text="{Binding SecondStageRecuperationEfficiency, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}" 
                                 Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" VerticalAlignment="Center" Width="120"/>
                    </Border>

                    <!-- Row 7: Макс. разлика на температура при загряване -->
                    <Border Grid.Row="7" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Макс. разлика на температура при загряване на въздуха във втора степен(от 4 до 8), °C" 
                                   Padding="10" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="7" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBox Text="{Binding MaxTemperatureDifferenceSecondStage, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}" 
                                 Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" VerticalAlignment="Center" Width="120"/>
                    </Border>

                    <!-- Row 8: Мин. крайна температура на отработения въздух -->
                    <Border Grid.Row="8" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
                        <TextBlock Text="Мин. крайна температура на отработения въздух(от 3 до 5), °C" 
                                   Padding="10" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="8" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
                        <TextBox Text="{Binding MinExhaustAirTemperature, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}" 
                                 Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" VerticalAlignment="Center" Width="120"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Енергиен източник 1 (ЕИ1) -->
            <TextBlock Text="Енергиен източник 1 (ЕИ1), %" FontSize="14" FontWeight="Bold" Margin="0,10,0,10"/>
            <Border BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <!-- First column reduced by 20% -->
                        <ColumnDefinition Width="320"/>
                        <!-- Uniform value column width -->
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>

                    <!-- Header Row -->
                    <Border Grid.Row="0" Grid.Column="0" Background="#1976D2" BorderBrush="White" BorderThickness="0,0,1,1">
                        <TextBlock Text="Параметър" FontWeight="Bold" Foreground="White" Padding="10" FontSize="13"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Background="#1976D2" BorderBrush="White" BorderThickness="0,0,0,1">
                        <ComboBox x:Name="EnergyCarrierCombo1"
                                  ItemsSource="{x:Static models:EnergyCarrierInfo.All}"
                                  SelectedValuePath="Code"
                                  SelectedValue="{Binding EnergySource1Carrier, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Padding="6,2"
                                  FontSize="11"
                                  HorizontalAlignment="Stretch"
                                  Margin="2"
                                  Style="{StaticResource EnergySourceComboBoxStyle}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="11" LineHeight="13" LineStackingStrategy="BlockLineHeight" Padding="0"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                            <ComboBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11" Foreground="#0066CC" Margin="0,2,0,1"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ComboBox.GroupStyle>
                        </ComboBox>
                    </Border>

                    <!-- Row 1: Дял -->
                    <Border Grid.Row="1" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Дял, %" Padding="10" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <TextBox Text="{Binding EnergySource1Share, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}" 
                                 Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" Width="120"/>
                    </Border>

                    <!-- Row 2: Ефективност на отдаване -->
                    <Border Grid.Row="2" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Ефективност на отдаване, %" Padding="10" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <TextBox Text="{Binding EnergySource1EmissionEfficiency, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}" 
                                 Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" Width="120"/>
                    </Border>

                    <!-- Row 3: Ефективност на разпределителната мрежа -->
                    <Border Grid.Row="3" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Ефективност на разпределителната мрежа, %" Padding="10" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="3" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <TextBox Text="{Binding EnergySource1DistributionEfficiency, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}" 
                                 Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" Width="120"/>
                    </Border>

                    <!-- Row 4: Автоматично управление -->
                    <Border Grid.Row="4" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Автоматично управление, %" Padding="10" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="4" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <TextBox Text="{Binding EnergySource1AutomaticControl, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}" 
                                 Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" Width="120"/>
                    </Border>

                    <!-- Row 5: Енергиен мениджмънт -->
                    <Border Grid.Row="5" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Енергиен мениджмънт (ЕМ) и поддръжка, %" Padding="10" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="5" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <TextBox Text="{Binding EnergySource1EnergyManagement, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}" 
                                 Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" Width="120"/>
                    </Border>

                    <!-- Row 6: Ефективност на генератора на топлина -->
                    <Border Grid.Row="6" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0">
                        <TextBlock Text="Ефективност на генератора на топлина, %" Padding="10" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="6" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,0,0">
                        <TextBox Text="{Binding EnergySource1GenerationEfficiency, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}" 
                                 Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" Width="120"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Енергиен източник 2 (ЕИ2) - опционален -->
            <CheckBox Content="Използвай втори енергиен източник (ЕИ2)" 
                      IsChecked="{Binding UseSecondEnergySource}" 
                      FontWeight="Bold" 
                      Margin="0,0,0,10"/>

            <Border BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,20" 
                    Visibility="{Binding UseSecondEnergySource, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>

                    <!-- Header Row -->
                    <Border Grid.Row="0" Grid.Column="0" Background="#1976D2" BorderBrush="White" BorderThickness="0,0,1,1">
                        <TextBlock Text="Параметър" FontWeight="Bold" Foreground="White" Padding="10" FontSize="13"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Background="#1976D2" BorderBrush="White" BorderThickness="0,0,0,1">
                        <ComboBox x:Name="EnergyCarrierCombo2"
                                  ItemsSource="{x:Static models:EnergyCarrierInfo.All}"
                                  SelectedValuePath="Code"
                                  SelectedValue="{Binding EnergySource2Carrier, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Padding="6,2"
                                  FontSize="11"
                                  HorizontalAlignment="Stretch"
                                  Margin="2"
                                  Style="{StaticResource EnergySourceComboBoxStyle}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="11" LineHeight="13" LineStackingStrategy="BlockLineHeight" Padding="0"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                            <ComboBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11" Foreground="#0066CC" Margin="0,2,0,1"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ComboBox.GroupStyle>
                        </ComboBox>
                    </Border>

                    <!-- Row 1: Дял -->
                    <Border Grid.Row="1" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Дял, %" Padding="10" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <TextBox Text="{Binding EnergySource2Share, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}" 
                                 Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" Width="120"/>
                    </Border>

                    <!-- Row 2: Ефективност на отдаване -->
                    <Border Grid.Row="2" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Ефективност на отдаване, %" Padding="10" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <TextBox Text="{Binding EnergySource2EmissionEfficiency, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}" 
                                 Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" Width="120"/>
                    </Border>

                    <!-- Row 3: Ефективност на разпределителната мрежа -->
                    <Border Grid.Row="3" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Ефективност на разпределителната мрежа, %" Padding="10" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="3" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <TextBox Text="{Binding EnergySource2DistributionEfficiency, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}" 
                                 Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" Width="120"/>
                    </Border>
                    <Border Grid.Row="4" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Автоматично управление, %" Padding="10" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Row="4" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <TextBox Text="{Binding EnergySource2AutomaticControl, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}" 
                                 Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" Width="120"/>
                    </Border>
                    <Border Grid.Row="5" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Енергиен мениджмънт (ЕМ) и поддръжка, %" Padding="10" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Row="5" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <TextBox Text="{Binding EnergySource2EnergyManagement, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}" 
                                 Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" Width="120"/>
                    </Border>
                    <Border Grid.Row="6" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,0,0">
                        <TextBlock Text="Ефективност на генератора на топлина, %" Padding="10" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="6" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,0,0">
                        <TextBox Text="{Binding EnergySource2GenerationEfficiency, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}" 
                               Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" Width="120"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Резултати -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,10,0,10">
                <TextBlock Text="Резултати" FontSize="14" FontWeight="Bold" Foreground="#4CAF50" VerticalAlignment="Center" />
                <CheckBox Content="Debug (временно): Покажи вътрешни променливи" Margin="20,0,0,0" VerticalAlignment="Center"
                          IsChecked="{Binding ShowDebug, Mode=TwoWay}" />
            </StackPanel>
            <Border BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <!-- First column reduced by 20% -->
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>

                    <!-- Header Row -->
                    <Border Grid.Row="0" Grid.Column="0" Background="#4CAF50" BorderBrush="White" BorderThickness="0,0,1,1">
                        <TextBlock Text="Параметър" FontWeight="Bold" Foreground="White" Padding="10" FontSize="13"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Background="#4CAF50" BorderBrush="White" BorderThickness="0,0,1,1">
                        <TextBlock Text="Разход на м² (kWh/m²)" FontWeight="Bold" Foreground="White" Padding="10" FontSize="13" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="2" Background="#4CAF50" BorderBrush="White" BorderThickness="0,0,0,1">
                        <TextBlock Text="Потребна енергия (kWh)" FontWeight="Bold" Foreground="White" Padding="10" FontSize="13" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Row 1: Енергия за загряване на въздуха (нетна) -->
                    <Border Grid.Row="1" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Енергия за загряване на въздуха (нетна)" Padding="10" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBox Text="{Binding SpecificVentilationHeatingEnergy_kWh_m2a, Mode=OneWay, StringFormat=0.00}" 
                                 Style="{StaticResource ReadOnlyTextBoxStyle}" 
                                 FontWeight="SemiBold" 
                                 TextAlignment="Center" HorizontalAlignment="Center" Width="120"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="2" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <TextBox Text="{Binding AnnualVentilationHeatingEnergy_kWh, Mode=OneWay, StringFormat=N2}" 
                                 Style="{StaticResource ReadOnlyTextBoxStyle}" 
                                 FontWeight="SemiBold" 
                                 TextAlignment="Center" HorizontalAlignment="Center" Width="120"/>
                    </Border>

                    <!-- Row 2: Принос към отоплението от вентилация (нетен) - NEW -->
                    <Border Grid.Row="2" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Принос към отоплението от вентилация (нетен)" Padding="10" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBox Text="{Binding VentilationHeatingNetContribution_kWh_m2a, Mode=OneWay, StringFormat=0.00}" 
                                 Style="{StaticResource ReadOnlyTextBoxStyle}" 
                                 FontWeight="SemiBold" 
                                 TextAlignment="Center" HorizontalAlignment="Center" Width="120"/>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="2" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <TextBox Text="{Binding VentilationHeatingNetContribution_kWh, Mode=OneWay, StringFormat=N2}" 
                                 Style="{StaticResource ReadOnlyTextBoxStyle}" 
                                 FontWeight="SemiBold" 
                                 TextAlignment="Center" HorizontalAlignment="Center" Width="120"/>
                    </Border>

                    <!-- Row 3: Потребна енергия (ЕИ1) -->
                    <Border Grid.Row="3" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Потребна енергия (ЕИ1)" Padding="10" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Row="3" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBox Text="{Binding FinalEnergySource1_kWh_per_m2, Mode=OneWay, StringFormat=0.00}" 
                                 Style="{StaticResource ReadOnlyTextBoxStyle}" TextAlignment="Center" HorizontalAlignment="Center" Width="120"/>
                    </Border>
                    <Border Grid.Row="3" Grid.Column="2" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <TextBox Text="{Binding FinalEnergySource1_kWh, Mode=OneWay, StringFormat=N2}" 
                                 Style="{StaticResource ReadOnlyTextBoxStyle}" TextAlignment="Center" HorizontalAlignment="Center" Width="120"/>
                    </Border>

                    <!-- Row 4: Потребна енергия (ЕИ2) -->
                    <Border Grid.Row="4" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Потребна енергия (ЕИ2)" Padding="10" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Row="4" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBox Text="{Binding FinalEnergySource2_kWh_per_m2, Mode=OneWay, StringFormat=0.00}" 
                                 Style="{StaticResource ReadOnlyTextBoxStyle}" TextAlignment="Center" HorizontalAlignment="Center" Width="120"/>
                    </Border>
                    <Border Grid.Row="4" Grid.Column="2" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <TextBox Text="{Binding FinalEnergySource2_kWh, Mode=OneWay, StringFormat=N2}" 
                                 Style="{StaticResource ReadOnlyTextBoxStyle}" TextAlignment="Center" HorizontalAlignment="Center" Width="120"/>
                    </Border>

                    <!-- Row 5: Обща потребна енергия (след преустройства/ефективности) -->
                    <Border Grid.Row="5" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Обща потребна енергия" Padding="10" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </Border>
                    <!-- Покажи общата крайна енергия след преобразуване (ЕИ1+ЕИ2) на m² -->
                    <Border Grid.Row="5" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBox Text="{Binding SpecificFinalEnergy_kWh_m2a, Mode=OneWay, StringFormat=0.00}" 
                                 Style="{StaticResource ReadOnlyTextBoxStyle}" TextAlignment="Center" HorizontalAlignment="Center" Width="120"/>
                    </Border>
                    <!-- Общата енергия в kWh/a (както беше) -->
                    <Border Grid.Row="5" Grid.Column="2" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <TextBox Text="{Binding TotalFinalEnergy_kWh_a, Mode=OneWay, StringFormat=N2}" 
                                 Style="{StaticResource ReadOnlyTextBoxStyle}" TextAlignment="Center" HorizontalAlignment="Center" Width="120"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Debug output (temporary) -->
            <Border BorderBrush="#BDBDBD" BorderThickness="1" Padding="8" Margin="0,0,0,20" Visibility="{Binding ShowDebug, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBox Text="{Binding DebugText, Mode=OneWay}" Style="{StaticResource ReadOnlyTextBoxStyle}" FontFamily="Consolas" FontSize="12" 
                         TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" Height="300"/>
            </Border>

            </StackPanel> <!-- End of IsEnabled wrapper -->

            <!-- Информационна бележка -->
            <Border Background="#FFEBEE" BorderBrush="#D32F2F" BorderThickness="1" Padding="15" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="ℹ Забележки:" FontWeight="Bold" Foreground="#C62828" Margin="0,0,0,10"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#B71C1C" FontSize="11">
                        <Run Text="• Изчислението следва Наредба RD-02-20-3, Секция 12 – Вентилация (формули 3.26, 3.27, 3.28 и item 3.5)."/>
                        <LineBreak/>
                        <Run Text="• Методология: BG (Българска) - пълно имплементиране; DIN - не е имплементирана."/>
                        <LineBreak/>
                        <Run Text="• Изчисленията включват само енергия за отопление на вентилационния въздух (месечно изчисление)."/>
                        <LineBreak/>
                        <Run Text="• Ефективностите по подразбиране са 100%. Стойностите трябва да бъдат въведени ръчно."/>
                        <LineBreak/>
                        <Run Text="• Няма вградени таблици за вентилация или рекуперация - всички параметри се въвеждат ръчно."/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Error message (if any) -->
            <Border Background="#FFCDD2" BorderBrush="#D32F2F" BorderThickness="1" Padding="15" Margin="0,10,0,0"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="⚠ Грешка при изчислението:" FontWeight="Bold" Foreground="#C62828" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="#B71C1C" FontSize="11"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
