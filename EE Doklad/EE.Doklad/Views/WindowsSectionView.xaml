<UserControl x:Class="EE.Doklad.Views.WindowsSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EE.Doklad.Views"
             xmlns:converters="clr-namespace:EE.Doklad.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <converters:OrientationConverter x:Key="OrientationConverter"/>
    </UserControl.Resources>
    
    <StackPanel Margin="20">
        <!-- Header -->
        <TextBlock Text="9. Прозорци и врати" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
        
        <!-- Description -->
        <TextBlock Text="{Binding Description}" 
                   TextWrapping="Wrap" 
                   Foreground="Gray" 
                   Margin="0,0,0,20"/>

        <!-- Toolbar -->
        <WrapPanel Margin="0,0,0,10" HorizontalAlignment="Left">
            <Button Content="+ Добави прозорец/врата" 
                    Background="#4CAF50"
                    Foreground="White"
                    Command="{Binding AddWindowCommand}"
                    Padding="12,6"
                    Margin="0,0,5,0"
                    BorderThickness="0"
                    Cursor="Hand"
                    FontWeight="SemiBold"/>
            
            <Button Content="Редактирай избраното" 
                    Background="#2196F3"
                    Foreground="White"
                    Command="{Binding EditSelectedCommand}"
                    Padding="12,6"
                    Margin="0,0,5,0"
                    BorderThickness="0"
                    Cursor="Hand"/>
            
            <Button Content="Изтрий" 
                    Background="#F44336"
                    Foreground="White"
                    Command="{Binding DeleteSelectedCommand}"
                    Padding="12,6"
                    Margin="0,0,5,0"
                    BorderThickness="0"
                    Cursor="Hand"/>
            
            <Button Content="Импорт от Excel" 
                    Background="LightGray"
                    Foreground="DarkGray"
                    IsEnabled="False"
                    Padding="12,6"
                    Margin="0,0,5,0"
                    BorderThickness="0"
                    ToolTip="Следваща версия"/>
        </WrapPanel>

        <!-- Summary Tables (Matrix view – Отопление и/или Охлаждане) -->
        <GroupBox Header="Обобщение по системи" Margin="0,0,0,12">
            <DataGrid ItemsSource="{Binding SystemLossRows}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      Margin="0,6,0,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Система" Binding="{Binding SystemLabel}" IsReadOnly="True" Width="150"/>
                    <DataGridTextColumn Header="Брой" Binding="{Binding TotalCount}" IsReadOnly="True" Width="55"/>
                    <DataGridTextColumn Header="A общо [m²]" Binding="{Binding TotalArea, StringFormat=F3}" IsReadOnly="True" Width="95"/>
                    <DataGridTextColumn Header="Uw ср." Binding="{Binding AverageUw, StringFormat=F3}" IsReadOnly="True" Width="80"/>
                    <DataGridTextColumn Header="Режим ТМ" Binding="{Binding ThermalBridgeModeLabel}" IsReadOnly="True" Width="85"/>
                    <DataGridTemplateColumn Header="Глобален ТМ" Width="210">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding ThermalBridgeOptions}"
                                          DisplayMemberPath="DisplayLabel"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding SelectedGlobalThermalBridgeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Width="190"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Приложи"
                                        Padding="6,2"
                                        Click="ApplySystemThermalBridge_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Htb [W/K]" Binding="{Binding Htb, StringFormat=F3}" IsReadOnly="True" Width="85"/>
                    <DataGridTextColumn Header="Hel [W/K]" Binding="{Binding Hel, StringFormat=F3}" IsReadOnly="True" Width="85"/>
                    <DataGridTextColumn Header="Htotal [W/K]" Binding="{Binding Htotal, StringFormat=F3}" IsReadOnly="True" Width="95"/>
                    <DataGridTemplateColumn Header="" Width="40">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="→"
                                        FontWeight="Bold"
                                        Padding="4,1"
                                        Click="OpenSystemDetails_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <local:MatrixSummaryView Batches="{Binding WindowBatches}"
                                 HeatingEnabled="{Binding HeatingEnabled}"
                                 CoolingEnabled="{Binding CoolingEnabled}"
                                 ClimateZone="{Binding ClimateZone}"
                                 CoolingStartMonth="{Binding CoolingStartMonth}"
                                 CoolingEndMonth="{Binding CoolingEndMonth}"
                                 Margin="0,5,0,20"/>

        <!-- Info panel -->
        <Border Background="#E3F2FD" Padding="10" CornerRadius="4" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="ℹ Информація" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock TextWrapping="Wrap">
                    • Партидите се групират автоматично по фасада и тип прозорец.<LineBreak/>
                    • g се изчислява по формули 3.41/3.42 с отчитане на щори (Табл. 4).<LineBreak/>
                    • За детайли на партидите натиснете "Details >" на избрана група.
                </TextBlock>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
