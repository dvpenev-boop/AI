<Window x:Class="EE.Doklad.Views.FloorTypeSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Избор на тип под"
        Height="300"
        Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Изберете тип под:" FontWeight="Bold" Margin="0,0,0,10"/>
        
        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,0,0,10">
            <Button Content="Под към външен въздух" Height="35" Margin="0,0,0,8" Click="ExternalAir_Click"/>
            <Button Content="Под към земя" Height="35" Margin="0,0,0,8" Click="Ground_Click"/>
            <Button Content="Под към неотопляемо помещение" Height="35" Margin="0,0,0,8" Click="UnheatedSpace_Click"/>
            <Button Content="Под над отопляем сутерен" Height="35" Click="HeatedBasement_Click"/>
        </StackPanel>
        
        <Button Grid.Row="2" Content="Отказ" Width="80" HorizontalAlignment="Right" Click="Cancel_Click"/>
    </Grid>
</Window>
