            <!-- Calculated Results Panel (moved inside main StackPanel) -->
<UserControl x:Class="EE.Doklad.Views.FloorPanels.FloorGroundPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:EE.Doklad.Models"
             xmlns:converters="clr-namespace:EE.Doklad.Converters">
    <UserControl.Resources>
        <converters:FlexibleDoubleConverter x:Key="FlexibleDoubleConverter"/>
        <converters:EdgeInsulationVisibilityConverter x:Key="EdgeInsulationVisibilityConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:AttachmentToVisibilityConverter x:Key="AttachmentToVisibilityConverter"/>
        <converters:AttachmentToImageSourceConverter x:Key="AttachmentToImageSourceConverter"/>
    </UserControl.Resources>
    <Border BorderBrush="#CCCCCC" BorderThickness="1" Padding="10" Margin="0,0,0,15">
        <StackPanel>
            <TextBlock Text="Под към земя" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>

            <TextBlock Text="Основни параметри" FontWeight="SemiBold" Margin="0,6,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Площ A (m²):" VerticalAlignment="Center" Margin="0,0,5,0" Width="150"/>
                <TextBox Width="100" Text="{Binding Area, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Периметър P (m):" VerticalAlignment="Center" Margin="0,0,5,0" Width="150"/>
                <TextBox Width="100" Text="{Binding Perimeter, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="dw,e (дебелина на външните стени на нивото на терена, m):" VerticalAlignment="Center" Margin="0,0,5,0" Width="320"/>
                <TextBox Width="80" Text="{Binding WallThickness, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.00}"/>
            </StackPanel>

            <TextBlock Text="Земна основа" FontWeight="SemiBold" Margin="0,6,0,4"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center">
                <TextBlock Text="λg (W/mK):" VerticalAlignment="Center" Margin="0,0,5,0" Width="150"/>
                <TextBox Width="100" Text="{Binding LambdaGround, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.0}" VerticalAlignment="Center"/>
                <Border BorderBrush="#B0B0B0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="20,0,0,0" Background="#FAFAFA" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Проектни стойности за земна основа (ISO 13370)" FontWeight="Bold" FontSize="12" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Тип почва" FontWeight="SemiBold" Grid.Row="0" Grid.Column="0"/>
                            <TextBlock Text="λg [W/(m·K)]" FontWeight="SemiBold" Grid.Row="0" Grid.Column="1" Margin="10,0,0,0"/>
                            <TextBlock Text="Глина" Grid.Row="1" Grid.Column="0"/>
                            <TextBlock Text="1.5" Grid.Row="1" Grid.Column="1" Margin="10,0,0,0"/>
                            <TextBlock Text="Пясък или чакъл" Grid.Row="2" Grid.Column="0"/>
                            <TextBlock Text="2.0" Grid.Row="2" Grid.Column="1" Margin="10,0,0,0"/>
                            <TextBlock Text="Скална основа" Grid.Row="3" Grid.Column="0"/>
                            <TextBlock Text="3.5" Grid.Row="3" Grid.Column="1" Margin="10,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>


            <TextBlock Text="Тип изолация" FontWeight="SemiBold" Margin="0,6,0,4"/>
            <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding InsulationType, Mode=TwoWay}" Margin="0,0,0,6" Width="200" HorizontalAlignment="Left">
                <ComboBoxItem Content="Без периферна изолация" Tag="{x:Static models:GroundInsulationType.None}"/>
                <ComboBoxItem Content="Хоризонтална периферна изолация" Tag="{x:Static models:GroundInsulationType.Edge}"/>
                <ComboBoxItem Content="Вертикална периферна изолация" Tag="{x:Static models:GroundInsulationType.UnderSlab}"/>
            </ComboBox>

            <!-- Параметри за периферна изолация -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6" Visibility="{Binding InsulationType, Converter={StaticResource EdgeInsulationVisibilityConverter}}">
                <TextBlock Text="D (широчина/дълбочина, m):" VerticalAlignment="Center" Margin="0,0,5,0" Width="200"/>
                <TextBox Width="80" Text="{Binding InsulationWidth, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.00}"/>
                <TextBlock Text="dn (дебелина, m):" VerticalAlignment="Center" Margin="10,0,5,0" Width="120"/>
                <TextBox Width="80" Text="{Binding InsulationThickness, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.00}"/>
                <TextBlock Text="λ_ins (W/mK):" VerticalAlignment="Center" Margin="10,0,5,0" Width="150"/>
                <TextBox Width="80" Text="{Binding InsulationLambda, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.00}"/>
            </StackPanel>






            <!-- Debug и грешки -->
            <TextBlock Text="Грешка:" Foreground="Red" FontWeight="Bold" Visibility="{Binding Error, Converter={StaticResource StringToVisibilityConverter}}"/>
            <TextBlock Text="{Binding Error}" Foreground="Red" TextWrapping="Wrap" Visibility="{Binding Error, Converter={StaticResource StringToVisibilityConverter}}"/>
            <GroupBox Header="Информационни резултати" Margin="0,10,0,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Rn" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding ResultRn, StringFormat=0.000}" IsReadOnly="True" Width="70"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="R'" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding ResultRPrime, StringFormat=0.000}" IsReadOnly="True" Width="70"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="d'" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding ResultDPrime, StringFormat=0.000}" IsReadOnly="True" Width="70"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="arg1" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding ResultArg1, StringFormat=0.000}" IsReadOnly="True" Width="70"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="arg2" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding ResultArg2, StringFormat=0.000}" IsReadOnly="True" Width="70"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="B" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding ResultB, StringFormat=0.000}" IsReadOnly="True" Width="70"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Rf" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding ResultRf, StringFormat=0.000}" IsReadOnly="True" Width="70"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="df" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding ResultDf, StringFormat=0.000}" IsReadOnly="True" Width="70"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Psi_g_ed" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding ResultPsiGed, StringFormat=0.000}" IsReadOnly="True" Width="70"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="U₀" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding ResultU0, StringFormat=0.000}" IsReadOnly="True" Width="70"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="U" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding ResultU, StringFormat=0.000}" IsReadOnly="True" Width="70"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <TextBlock Text="Топлинно съпротивление" FontWeight="SemiBold" Margin="0,6,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <StackPanel Width="520">
                    <TextBlock Text="Слоеве" FontWeight="SemiBold" Margin="0,10,0,4"/>
                    <DataGrid ItemsSource="{Binding Layers}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              Margin="0,0,0,5">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Материал" Binding="{Binding Material, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTextColumn Header="δ (m)" Binding="{Binding Thickness, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}" Width="90"/>
                            <DataGridTextColumn Header="λ (W/mK)" Binding="{Binding Lambda, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}" Width="90"/>
                            <DataGridTextColumn Header="R" Binding="{Binding R, StringFormat=0.000}" IsReadOnly="True" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="+ Слой" Padding="6,2" Margin="0,0,10,0" Background="#4CAF50" Foreground="White" BorderThickness="0"
                                Click="AddLayer_Click"/>
                        <Button Content="Премахни слой" Padding="6,2" Background="#F44336" Foreground="White" BorderThickness="0"
                                Click="RemoveLayer_Click"/>
                    </StackPanel>
                </StackPanel>
                <Border BorderBrush="#AAAAAA" BorderThickness="1" Margin="20,0,0,0" Padding="8" Width="220" Height="220">
                    <StackPanel>
                        <TextBlock Text="Схема" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <Border BorderBrush="#DDDDDD" BorderThickness="1" Height="130" VerticalAlignment="Center">
                            <Grid>
                                <Image Stretch="Uniform"
                                       Visibility="{Binding GroundSchemeAttachment, Converter={StaticResource AttachmentToVisibilityConverter}}"
                                       Source="{Binding GroundSchemeAttachment, Converter={StaticResource AttachmentToImageSourceConverter}}"/>
                                <TextBlock Text="Няма изображение" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding GroundSchemeAttachment, Converter={StaticResource AttachmentToVisibilityConverter}, ConverterParameter=Inverse}"/>
                            </Grid>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                            <Button Content="Качи" Padding="6,2" Margin="0,0,8,0" Background="#2196F3" Foreground="White" BorderThickness="0"
                                    Click="UploadGroundScheme_Click"/>
                            <Button Content="Премахни" Padding="6,2" Background="#F44336" Foreground="White" BorderThickness="0"
                                    Click="RemoveGroundScheme_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
