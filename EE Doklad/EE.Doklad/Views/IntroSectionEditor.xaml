<UserControl x:Class="EE.Doklad.Views.IntroSectionEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:EE.Doklad.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid Background="White">
        <StackPanel Orientation="Vertical" Margin="10">
            <!-- Заглавие -->
            <TextBlock Text="4. Въведение" 
                       FontSize="18" 
                       FontWeight="Bold" 
                       Margin="0,0,0,20"/>

            <!-- Текстова част - ОТГОРЕ -->
            <TextBlock Text="Описание на извършените дейности" 
                       FontSize="14" 
                       FontWeight="Bold" 
                       Margin="0,0,0,10"/>

            <TextBox Text="{Binding StaticText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     Height="200"
                     Padding="10"
                     FontSize="12"
                     Margin="0,0,0,20"/>

            <!-- Таблица с проверени елементи - ОТДОЛУ -->
            <TextBlock Text="Проверени елементи в проекта" 
                       FontSize="14" 
                       FontWeight="Bold" 
                       Margin="0,0,0,10"/>

            <DataGrid x:Name="IntroTableGrid"
                      ItemsSource="{Binding Tables[0].Rows}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      IsReadOnly="False"
                      Height="300"
                      Margin="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Проверени елементи в проекта" 
                                        Binding="{Binding Cells[0].Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                        Width="2*"
                                        MinWidth="200"/>
                    <DataGridTextColumn Header="Констатации" 
                                        Binding="{Binding Cells[1].Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                        Width="3*"
                                        MinWidth="250"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>
</UserControl>
