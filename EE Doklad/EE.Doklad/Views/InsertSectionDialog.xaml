<Window x:Class="EE.Doklad.Views.InsertSectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вмъкване на нова секция"
        Height="280"
        Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заглавие -->
        <TextBlock Grid.Row="0" 
                   Text="Вмъкване на нова секция"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,15"/>

        <!-- Номер на секцията -->
        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="Номер на секцията:" Margin="0,0,0,5"/>
            <TextBox x:Name="SectionNumberTextBox"
                     FontSize="14"
                     Padding="8"
                     TextChanged="SectionNumberTextBox_TextChanged"/>
        </StackPanel>

        <!-- Име на секцията -->
        <StackPanel Grid.Row="2" Margin="0,0,0,15">
            <TextBlock Text="Заглавие на секция:" Margin="0,0,0,5"/>
            <TextBox x:Name="SectionNameTextBox"
                     FontSize="14"
                     Padding="8"
                     TextChanged="SectionNameTextBox_TextChanged"/>
        </StackPanel>

        <!-- Grid.Row="3" е празен ред за spacing -->

        <!-- Бутони -->
        <StackPanel Grid.Row="4" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right">
            <Button Content="OK" 
                    Width="100" 
                    Height="35"
                    Margin="0,0,10,0"
                    Click="OK_Click"
                    IsDefault="True"
                    x:Name="OkButton"
            IsEnabled="False"
                    Background="#4CAF50"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    FontWeight="SemiBold"/>
            <Button Content="Отказ" 
                    Width="100" 
                    Height="35"
                    Click="Cancel_Click"
                    IsCancel="True"
                    Background="#757575"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
