<UserControl x:Class="EE.Doklad.Views.Controls.RoofSurfaceParamsEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:EE.Doklad.Converters"
             mc:Ignorable="d"
             d:DesignHeight="160" d:DesignWidth="700">

    <UserControl.Resources>
        <!-- Help button style – round blue circle, tooltip shown on hover -->
        <Style x:Key="HelpButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Validated TextBox style (red border on validation error) -->
        <Style x:Key="NumericInputStyle" TargetType="TextBox">
            <Setter Property="Width" Value="65"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#AAAAAA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="BorderBrush" Value="#D32F2F"/>
                    <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self},
                        Path=(Validation.Errors)[0].ErrorContent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- Root bound to WallSurfaceProperties instance (UseOrientationOverride always false for roofs) -->
    <Border Background="#F8F9FA" BorderBrush="#BBDEFB" BorderThickness="1"
            Padding="12,10" Margin="0,4,0,0">
        <StackPanel>

            <!-- Header -->
            <TextBlock Text="Повърхностни параметри" FontWeight="Bold" FontSize="12"
                       Foreground="#1565C0" Margin="0,0,0,8"/>

            <!-- Alpha row -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Alpha (α_sol):" VerticalAlignment="Center" Width="110" FontSize="12"/>
                <TextBox x:Name="AlphaDefaultBox"
                         Style="{StaticResource NumericInputStyle}"
                         Text="{Binding AlphaDefault, UpdateSourceTrigger=LostFocus, StringFormat=0.00}"
                         LostFocus="AlphaDefaultBox_LostFocus"
                         PreviewTextInput="NumericInput_PreviewTextInput"/>
                <Button x:Name="AlphaHelpButton" Style="{StaticResource HelpButtonStyle}"
                        Content="?" Margin="6,0,0,0" Click="AlphaHelp_Click"
                        VerticalAlignment="Center"
                        ToolTip="Кликнете за помощ относно коефициента α_sol"/>
                <TextBlock x:Name="AlphaValidationMsg" Text="" Foreground="#D32F2F"
                           FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>

            <!-- Epsilon row -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Emissivity (ε):" VerticalAlignment="Center" Width="110" FontSize="12"/>
                <TextBox x:Name="EpsilonDefaultBox"
                         Style="{StaticResource NumericInputStyle}"
                         Text="{Binding EpsilonDefault, UpdateSourceTrigger=LostFocus, StringFormat=0.00}"
                         LostFocus="EpsilonDefaultBox_LostFocus"
                         PreviewTextInput="NumericInput_PreviewTextInput"/>
                <Button x:Name="EpsilonHelpButton" Style="{StaticResource HelpButtonStyle}"
                        Content="?" Margin="6,0,0,0" Click="EpsilonHelp_Click"
                        VerticalAlignment="Center"
                        ToolTip="Кликнете за помощ относно топлинната излъчваемост ε"/>
                <TextBlock x:Name="EpsilonValidationMsg" Text="" Foreground="#D32F2F"
                           FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>

            <!-- Typical values dropdown (roof-specific presets) -->
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="Типични стойности:" VerticalAlignment="Center"
                           FontSize="11" Margin="0,0,6,0"/>
                <ComboBox x:Name="TypicalValuesCombo"
                          Width="260" FontSize="11"
                          SelectionChanged="TypicalValuesCombo_SelectionChanged">
                    <ComboBoxItem Content="--- изберете ---" IsEnabled="False" IsSelected="True"/>
                    <ComboBoxItem Content="Керамични/бетонни керемиди  α=0.60  ε=0.90"  Tag="0.60|0.90"/>
                    <ComboBoxItem Content="Битумни керемиди/мембрана    α=0.85  ε=0.90"  Tag="0.85|0.90"/>
                    <ComboBoxItem Content="Полимерна мембрана (PVC/TPO) α=0.50  ε=0.90"  Tag="0.50|0.90"/>
                    <ComboBoxItem Content="Боядисан метален покрив      α=0.60  ε=0.85"  Tag="0.60|0.85"/>
                    <ComboBoxItem Content="Поцинкован стоманен покрив   α=0.65  ε=0.30"  Tag="0.65|0.30"/>
                    <ComboBoxItem Content="Полиран алуминиев покрив     α=0.30  ε=0.05"  Tag="0.30|0.05"/>
                </ComboBox>
            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>
