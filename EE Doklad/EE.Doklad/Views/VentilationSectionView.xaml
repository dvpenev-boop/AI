                                 Style="{StaticResource ReadOnlyTextBoxStyle}" TextAlignment="Center" HorizontalAlignment="Stretch"/>
                    </Border>

                    <!-- Row 5: Р В РЎвЂєР В Р’В±Р РЋРІР‚В°Р В Р’В° Р В РЎвЂ”Р В РЎвЂўР РЋРІР‚С™Р РЋР вЂљР В Р’ВµР В Р’В±Р В Р вЂ¦Р В Р’В° Р В Р’ВµР В Р вЂ¦Р В Р’ВµР РЋР вЂљР В РЎвЂ“Р В РЎвЂР РЋР РЏ (Р РЋР С“Р В Р’В»Р В Р’ВµР В РўвЂ Р В РЎвЂ”Р РЋР вЂљР В Р’ВµР РЋРЎвЂњР РЋР С“Р РЋРІР‚С™Р РЋР вЂљР В РЎвЂўР В РІвЂћвЂ“Р РЋР С“Р РЋРІР‚С™Р В Р вЂ Р В Р’В°/Р В Р’ВµР РЋРІР‚С›Р В Р’ВµР В РЎвЂќР РЋРІР‚С™Р В РЎвЂР В Р вЂ Р В Р вЂ¦Р В РЎвЂўР РЋР С“Р РЋРІР‚С™Р В РЎвЂ) -->
                    <Border Grid.Row="5" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Обща потребна енергия" Style="{StaticResource LabelStyle}" FontWeight="SemiBold"/>
                    </Border>
                    <!-- Р В РЎСџР В РЎвЂўР В РЎвЂќР В Р’В°Р В Р’В¶Р В РЎвЂ Р В РЎвЂўР В Р’В±Р РЋРІР‚В°Р В Р’В°Р РЋРІР‚С™Р В Р’В° Р В РЎвЂќР РЋР вЂљР В Р’В°Р В РІвЂћвЂ“Р В Р вЂ¦Р В Р’В° Р В Р’ВµР В Р вЂ¦Р В Р’ВµР РЋР вЂљР В РЎвЂ“Р В РЎвЂР РЋР РЏ Р РЋР С“Р В Р’В»Р В Р’ВµР В РўвЂ Р В РЎвЂ”Р РЋР вЂљР В Р’ВµР В РЎвЂўР В Р’В±Р РЋР вЂљР В Р’В°Р В Р’В·Р РЋРЎвЂњР В Р вЂ Р В Р’В°Р В Р вЂ¦Р В Р’Вµ (Р В РІР‚СћР В Р’В1+Р В РІР‚СћР В Р’В2) Р В Р вЂ¦Р В Р’В° mР вЂ™Р вЂ  -->
                    <Border Grid.Row="5" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBox Text="{Binding SpecificFinalEnergy_kWh_m2a, Mode=OneWay, StringFormat=0.00}" 
                                 Style="{StaticResource ReadOnlyTextBoxStyle}" TextAlignment="Center" HorizontalAlignment="Stretch"/>
                    </Border>
                    <!-- Р В РЎвЂєР В Р’В±Р РЋРІР‚В°Р В Р’В°Р РЋРІР‚С™Р В Р’В° Р В Р’ВµР В Р вЂ¦Р В Р’ВµР РЋР вЂљР В РЎвЂ“Р В РЎвЂР РЋР РЏ Р В Р вЂ  kWh/a (Р В РЎвЂќР В Р’В°Р В РЎвЂќР РЋРІР‚С™Р В РЎвЂў Р В Р’В±Р В Р’ВµР РЋРІвЂљВ¬Р В Р’Вµ) -->
                    <Border Grid.Row="5" Grid.Column="2" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <TextBox Text="{Binding TotalFinalEnergy_kWh_a, Mode=OneWay, StringFormat=N2}" 
                                 Style="{StaticResource ReadOnlyTextBoxStyle}" TextAlignment="Center" HorizontalAlignment="Stretch"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Debug output (temporary) -->
            <Border BorderBrush="#BDBDBD" BorderThickness="1" Padding="8" Margin="0,0,0,20" Visibility="{Binding ShowDebug, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBox Text="{Binding DebugText, Mode=OneWay}" Style="{StaticResource ReadOnlyTextBoxStyle}" FontFamily="Consolas" FontSize="12" 
                         TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" Height="300"/>
            </Border>

            </StackPanel> <!-- End of IsEnabled wrapper -->

            <!-- Р В Р’ВР В Р вЂ¦Р РЋРІР‚С›Р В РЎвЂўР РЋР вЂљР В РЎВР В Р’В°Р РЋРІР‚В Р В РЎвЂР В РЎвЂўР В Р вЂ¦Р В Р вЂ¦Р В Р’В° Р В Р’В±Р В Р’ВµР В Р’В»Р В Р’ВµР В Р’В¶Р В РЎвЂќР В Р’В° -->
            <Border Background="#FFEBEE" BorderBrush="#D32F2F" BorderThickness="1" Padding="15" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="ℹ Забележки:" FontWeight="Bold" Foreground="#C62828" Margin="0,0,0,10"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#B71C1C" FontSize="10">
                        <Run Text="• Изчислението следва Наредба RD-02-20-3, Секция 13 – Вентилация Отопление."/>
                        <LineBreak/>
                        <Run Text="• Методология: BG (Българска) - пълно имплементиране; DIN - не е имплементирана."/>
                        <LineBreak/>
                        <Run Text="• Изчисленията включват само енергия за отопление на вентилационния въздух (месечно изчисление)."/>
                        <LineBreak/>
                        <Run Text="• Ефективностите по подразбиране са 100%. Стойностите трябва да бъдат въведени ръчно."/>
                        <LineBreak/>
                        <Run Text="• Няма вградени таблици за вентилация или рекуперация - всички параметри се въвеждат ръчно."/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Error message (if any) -->
            <Border Background="#FFCDD2" BorderBrush="#D32F2F" BorderThickness="1" Padding="15" Margin="0,10,0,0"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="⚠ Грешка при изчислението:" FontWeight="Bold" Foreground="#C62828" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="#B71C1C" FontSize="10"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
