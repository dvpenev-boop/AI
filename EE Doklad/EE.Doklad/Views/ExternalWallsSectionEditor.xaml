<UserControl x:Class="EE.Doklad.Views.ExternalWallsSectionEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:EE.Doklad.Converters"
             xmlns:controls="clr-namespace:EE.Doklad.Views.Controls"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900">

    <UserControl.Resources>
        <converters:AttachmentToImageSourceConverter x:Key="AttachmentToImageSourceConverter"/>
        <converters:AttachmentToVisibilityConverter x:Key="AttachmentToVisibilityConverter"/>
        <converters:BoolToVisibilityInverseConverter x:Key="BoolToVisibilityInverseConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
    <!-- Orientation breakdown popup – opens when user clicks an α or ε cell -->
    <Popup x:Name="OrientationPopup"
           AllowsTransparency="True"
           StaysOpen="False"
           Placement="MousePoint"
           PopupAnimation="Fade">
        <Border Background="White" BorderBrush="#90CAF9" BorderThickness="1"
                CornerRadius="4" Padding="12" Effect="{x:Null}">
            <StackPanel MinWidth="380">
                <TextBlock x:Name="PopupTitle" FontWeight="Bold" FontSize="12"
                           Foreground="#1565C0" Margin="0,0,0,8"
                           Text="Повърхностни параметри по ориентации"/>
                <!-- Breakdown table -->
                <DataGrid x:Name="OrientationBreakdownGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          FontSize="11"
                          Margin="0,0,0,10"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ориент." Binding="{Binding Label}" Width="60"/>
                        <DataGridTextColumn Header="α"       Binding="{Binding Alpha, StringFormat=0.00}" Width="60"/>
                        <DataGridTextColumn Header="ε"       Binding="{Binding Epsilon, StringFormat=0.00}" Width="60"/>
                        <DataGridTextColumn Header="A (m²)"  Binding="{Binding Area, StringFormat=0.000}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
                <!-- Actions -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Редактирай стойностите" Padding="8,3" FontSize="11"
                            Background="#1976D2" Foreground="White" BorderThickness="0"
                            Margin="0,0,8,0" Click="PopupEditValues_Click"/>
                    <Button Content="Копирай default навсякъде" Padding="8,3" FontSize="11"
                            Background="#EF6C00" Foreground="White" BorderThickness="0"
                            Click="PopupCopyDefault_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Popup>

    <!-- Thermal Bridges summary popup – opens when user clicks the „Режим ТМ" cell -->
    <Popup x:Name="ThermalBridgesPopup"
           AllowsTransparency="True"
           StaysOpen="False"
           Placement="MousePoint"
           PopupAnimation="Fade">
        <Border Background="White" BorderBrush="#CE93D8" BorderThickness="1"
                CornerRadius="4" Padding="12" Effect="{x:Null}">
            <StackPanel MinWidth="300">
                <TextBlock x:Name="TbPopupTitle" FontWeight="Bold" FontSize="12"
                           Foreground="#4A148C" Margin="0,0,0,8"
                           Text="Топлинни мостове"/>
                <StackPanel Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Режим:"   FontSize="11" Width="90" Foreground="#555"/>
                        <TextBlock x:Name="TbPopupMode" FontSize="11" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                x:Name="TbPopupPercentRow" Visibility="Collapsed">
                        <TextBlock Text="Процент:" FontSize="11" Width="90" Foreground="#555"/>
                        <TextBlock x:Name="TbPopupPercent" FontSize="11"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                x:Name="TbPopupCountRow" Visibility="Collapsed">
                        <TextBlock Text="Брой ТМ:" FontSize="11" Width="90" Foreground="#555"/>
                        <TextBlock x:Name="TbPopupCount" FontSize="11"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Hel:"     FontSize="11" Width="90" Foreground="#555"/>
                        <TextBlock x:Name="TbPopupHel" FontSize="11"/>
                        <TextBlock Text=" W/K"     FontSize="10" Foreground="#999"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Htb:"     FontSize="11" Width="90" Foreground="#555"/>
                        <TextBlock x:Name="TbPopupHtb" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Text=" W/K"     FontSize="10" Foreground="#999"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Htotal:"  FontSize="11" Width="90" Foreground="#555"/>
                        <TextBlock x:Name="TbPopupHtotal" FontSize="11" FontWeight="Bold" Foreground="#4A148C"/>
                        <TextBlock Text=" W/K"     FontSize="10" Foreground="#999"/>
                    </StackPanel>
                </StackPanel>
                <Button Content="Отиди към строителния елемент" Padding="8,4" FontSize="11"
                        Background="#7B1FA2" Foreground="White" BorderThickness="0"
                        HorizontalAlignment="Right"
                        Click="TbPopupNavigate_Click"/>
            </StackPanel>
        </Border>
    </Popup>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="{Binding Title, FallbackValue='Външни стени'}"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,0,15"/>

            <TextBlock Text="Описание:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                     MinHeight="80"
                     Padding="10"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     FontSize="11"
                     Margin="0,0,0,20"
                     BorderBrush="#E0E0E0"
                     BorderThickness="1"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="+ Добави тип стена" Margin="0,0,10,0" Padding="6,4"
                        Background="#4CAF50" Foreground="White" BorderThickness="0"
                        Click="AddWallType_Click"/>
                <Button Content="Премахни тип" Margin="0,0,10,0" Padding="6,4"
                        Background="#F44336" Foreground="White" BorderThickness="0"
                        Click="RemoveWallType_Click"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="ShowCardinalCheckBox" Content="Покажи чисти фасади (И, С, З, Ю)" Margin="0,0,10,0"
                              IsChecked="{Binding ShowFacadeDistribution, UpdateSourceTrigger=PropertyChanged}"
                              Checked="FacadeOptions_Changed" Unchecked="FacadeOptions_Changed"/>
                    <CheckBox x:Name="ShowRotatedCheckBox" Content="Покажи завъртени фасади (СИ, СЗ, ЮИ, ЮЗ)" Margin="0,0,10,0"
                              IsChecked="True"
                              Checked="FacadeOptions_Changed" Unchecked="FacadeOptions_Changed"/>
                    <CheckBox x:Name="HideEmptyColumnsCheckBox" Content="Скрий празни колони" Margin="0,0,10,0"
                              Checked="HideEmptyColumns_Changed" Unchecked="HideEmptyColumns_Changed"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Обобщаваща таблица: Фасади / Външни стени"
                       FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

            <DataGrid x:Name="SummaryGrid"
                      ItemsSource="{Binding WallTypes}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      Margin="0,0,0,20">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="№" Binding="{Binding Index}" IsReadOnly="True" Width="40"/>
                    <DataGridTextColumn Header="Тип стена" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                    <DataGridTextColumn Header="A (m²)" Binding="{Binding Area, UpdateSourceTrigger=PropertyChanged, StringFormat=0.000}" Width="90"/>
                    <DataGridTextColumn Header="U (W/m²K)" Binding="{Binding Uw, StringFormat=0.000}" IsReadOnly="True" Width="90"/>
                    <!-- α column – shows α_eff; entire cell is a clickable button -->
                    <DataGridTemplateColumn x:Name="AlphaColumn" Header="α" IsReadOnly="True" Width="65">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Click="AlphaEpsilonCell_Click"
                                        Tag="Alpha"
                                        Cursor="Hand"
                                        BorderThickness="0"
                                        Padding="4,2"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Background="Transparent">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#E3F2FD"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding AlphaEff, StringFormat=0.00}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock VerticalAlignment="Center" Margin="3,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value=""/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SurfaceProperties.UseOrientationOverride}" Value="True">
                                                            <Setter Property="Text" Value="▾"/>
                                                            <Setter Property="Foreground" Value="#E65100"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!-- ε column – shows ε_eff; entire cell is a clickable button -->
                    <DataGridTemplateColumn x:Name="EpsilonColumn" Header="ε" IsReadOnly="True" Width="65">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Click="AlphaEpsilonCell_Click"
                                        Tag="Epsilon"
                                        Cursor="Hand"
                                        BorderThickness="0"
                                        Padding="4,2"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Background="Transparent">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#E3F2FD"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding EpsilonEff, StringFormat=0.00}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock VerticalAlignment="Center" Margin="3,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value=""/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SurfaceProperties.UseOrientationOverride}" Value="True">
                                                            <Setter Property="Text" Value="▾"/>
                                                            <Setter Property="Foreground" Value="#E65100"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn x:Name="EastColumn" Header="И" Binding="{Binding FacadeEast, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}" Width="60"/>
                    <DataGridTextColumn x:Name="NorthColumn" Header="С" Binding="{Binding FacadeNorth, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}" Width="60"/>
                    <DataGridTextColumn x:Name="WestColumn" Header="З" Binding="{Binding FacadeWest, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}" Width="60"/>
                    <DataGridTextColumn x:Name="SouthColumn" Header="Ю" Binding="{Binding FacadeSouth, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}" Width="60"/>
                    <DataGridTextColumn x:Name="NorthEastColumn" Header="СИ" Binding="{Binding FacadeNorthEast, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}" Width="60"/>
                    <DataGridTextColumn x:Name="NorthWestColumn" Header="СЗ" Binding="{Binding FacadeNorthWest, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}" Width="60"/>
                    <DataGridTextColumn x:Name="SouthWestColumn" Header="ЮЗ" Binding="{Binding FacadeSouthWest, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}" Width="60"/>
                    <DataGridTextColumn x:Name="SouthEastColumn" Header="ЮИ" Binding="{Binding FacadeSouthEast, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}" Width="60"/>
                    <!-- Thermal bridges summary column – clickable аналогично на α/ε -->
                    <DataGridTemplateColumn x:Name="ThermalBridgeModeColumn" Header="Режим ТМ" IsReadOnly="True" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Click="ThermalBridgeModeCell_Click"
                                        Cursor="Hand" BorderThickness="0" Padding="4,2"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Background="Transparent">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#EDE7F6"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center" FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Няма"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ThermalBridges.Mode}" Value="GlobalPercentage">
                                                            <Setter Property="Text" Value="Глобален %"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ThermalBridges.Mode}" Value="Manual">
                                                            <Setter Property="Text" Value="Детайлно"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="▾" VerticalAlignment="Center" Margin="3,0,0,0"
                                                   FontSize="10" Foreground="#7B1FA2">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ThermalBridges.Mode}" Value="GlobalPercentage">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ThermalBridges.Mode}" Value="Manual">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Htb (W/K)"    Binding="{Binding ThermalBridges.Htb,    StringFormat=0.000}" IsReadOnly="True" Width="80"/>
                    <DataGridTextColumn Header="Hel (W/K)"    Binding="{Binding ThermalBridges.Hel,    StringFormat=0.000}" IsReadOnly="True" Width="80"/>
                    <DataGridTextColumn Header="Htotal (W/K)" Binding="{Binding ThermalBridges.Htotal, StringFormat=0.000}" IsReadOnly="True" Width="90"/>
                    <!-- Премахни – last column, after all facade directions -->
                    <DataGridTemplateColumn Header="" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Премахни" Background="#e53935" Foreground="White" Padding="8,2" BorderThickness="0"
                                        Tag="{Binding}" Click="RemoveWallType_Click" MinWidth="80"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <ItemsControl x:Name="WallTypesItemsControl" ItemsSource="{Binding WallTypes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#CCCCCC" BorderThickness="1" Padding="10" Margin="0,0,0,15">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Index, StringFormat=СТЕНА ТИП {0}}" FontWeight="Bold" FontSize="13"/>
                    <Button DockPanel.Dock="Right" Content="Премахни" Padding="8,2" Background="#e53935" Foreground="White" BorderThickness="0"
                        MinWidth="80" HorizontalAlignment="Right" Tag="{Binding}" Click="RemoveWallType_Click"/>
                                </DockPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="Rsi:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Width="60" Text="{Binding Rsi, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="Rse:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Width="60" Text="{Binding Rse, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="Rw:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding Rw, StringFormat=0.000}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="Rtotal:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding Rtotal, StringFormat=0.000}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="Uw:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding Uw, StringFormat=0.000}" VerticalAlignment="Center" FontWeight="Bold"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Width="520">
                                        <DataGrid ItemsSource="{Binding Layers}"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  HeadersVisibility="Column"
                                                  Margin="0,0,0,5">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="Материал" Width="*">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <ComboBox ItemsSource="{Binding MaterialOptions}"
                                                                      SelectedValuePath="Id"
                                                                      DisplayMemberPath="Display"
                                                                      SelectedValue="{Binding SelectedMaterialId, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                                      IsEditable="True"
                                                                      IsTextSearchEnabled="True"
                                                                      StaysOpenOnEdit="True"
                                                                      TextSearch.TextPath="Display"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="δ (m)" Binding="{Binding Thickness, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}" Width="90"/>
                                                <DataGridTextColumn Header="λ (W/mK)" Binding="{Binding Lambda, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}" Width="90" IsReadOnly="True"/>
                                                <DataGridTextColumn Header="R" Binding="{Binding R, StringFormat=0.000}" IsReadOnly="True" Width="90"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="+ Слой" Padding="6,2" Margin="0,0,10,0" Background="#4CAF50" Foreground="White" BorderThickness="0"
                                                    Tag="{Binding}" Click="AddLayer_Click"/>
                        <Button Content="Премахни слой" Padding="8,2" Background="#e53935" Foreground="White" BorderThickness="0"
                            MinWidth="80" Tag="{Binding}" Click="RemoveLayer_Click"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Border BorderBrush="#AAAAAA" BorderThickness="1" Margin="20,0,0,0" Padding="8" Width="220" Height="220">
                                        <StackPanel>
                                            <TextBlock Text="Схема" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                            <Border BorderBrush="#DDDDDD" BorderThickness="1" Height="130" VerticalAlignment="Center">
                                                <Grid>
                                                    <Image Stretch="Uniform"
                                                           Visibility="{Binding SchemeAttachment, Converter={StaticResource AttachmentToVisibilityConverter}}"
                                                           Source="{Binding SchemeAttachment, Converter={StaticResource AttachmentToImageSourceConverter}}"/>
                                                    <TextBlock Text="Няма изображение" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding SchemeAttachment, Converter={StaticResource AttachmentToVisibilityConverter}, ConverterParameter=Inverse}"/>
                                                </Grid>
                                            </Border>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                                <Button Content="Качи" Padding="6,2" Margin="0,0,8,0" Background="#2196F3" Foreground="White" BorderThickness="0"
                                                        Tag="{Binding}" Click="UploadScheme_Click"/>
                                                <Button Content="Премахни" Padding="6,2" Background="#F44336" Foreground="White" BorderThickness="0"
                                                        Tag="{Binding}" Click="RemoveScheme_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- ══════ Surface Parameters Expander ══════ -->
                                <Expander Margin="0,12,0,0"
                                          IsExpanded="{Binding SurfaceProperties.IsExpanded,
                                                               Mode=TwoWay,
                                                               FallbackValue=False}">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Повърхностни параметри (α_sol, ε)"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="#1565C0" VerticalAlignment="Center"/>
                                            <!-- Indicator badge -->
                                            <Border Background="#E3F2FD" CornerRadius="4"
                                                    Padding="5,1" Margin="8,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock FontSize="10" Foreground="#1565C0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="αε: default"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SurfaceProperties.UseOrientationOverride}" Value="True">
                                                                    <Setter Property="Text" Value="αε: ориент."/>
                                                                    <Setter Property="Foreground" Value="#E65100"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>
                                    </Expander.Header>
                                    <controls:WallSurfaceParamsEditor
                                        DataContext="{Binding SurfaceProperties}"/>
                                </Expander>

                                <!-- ══════ Thermal Bridges Expander ══════ -->
                                <Expander x:Name="ThermalBridgesExpander"
                                          Margin="0,8,0,0"
                                          IsExpanded="{Binding ThermalBridges.IsExpanded, Mode=TwoWay, FallbackValue=False}">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Топлинни мостове"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="#4A148C" VerticalAlignment="Center"/>
                                            <!-- Mode badge -->
                                            <Border Background="#EDE7F6" CornerRadius="4"
                                                    Padding="5,1" Margin="8,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock FontSize="10" Foreground="#4A148C">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Няма"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ThermalBridges.Mode}" Value="GlobalPercentage">
                                                                    <Setter Property="Text" Value="Глобален %"/>
                                                                    <Setter Property="Foreground" Value="#E65100"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ThermalBridges.Mode}" Value="Manual">
                                                                    <Setter Property="Text" Value="Детайлно"/>
                                                                    <Setter Property="Foreground" Value="#1B5E20"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>
                                    </Expander.Header>

                                    <Border Padding="10,8,10,10" Background="#FAF5FF">
                                        <StackPanel DataContext="{Binding ThermalBridges}">

                                            <!-- ── Режим ComboBox ── -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <TextBlock Text="Режим:" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <ComboBox x:Name="TbModeComboBox"
                                                          SelectedValue="{Binding Mode, Mode=TwoWay}"
                                                          SelectedValuePath="Tag"
                                                          Width="200" FontSize="12"
                                                          Tag="{Binding}"
                                                          SelectionChanged="TbMode_SelectionChanged">
                                                    <ComboBoxItem Content="Няма"             Tag="None"/>
                                                    <ComboBoxItem Content="Глобална стойност" Tag="GlobalPercentage"/>
                                                    <ComboBoxItem Content="Детайлно въвеждане"   Tag="Manual"/>
                                                </ComboBox>
                                            </StackPanel>

                                            <!-- ── Панел: Няма ── -->
                                            <StackPanel Margin="0,0,0,4">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Mode}" Value="None">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock FontSize="11" Foreground="#555"
                                                           Text="Htb = 0  |  Htotal = Hel = U × A"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <TextBlock Text="Hel =" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Hel, StringFormat=0.000}" FontSize="12" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="W/K" FontSize="11" Foreground="#777" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- ── Панел: Глобална стойност ── -->
                                            <StackPanel Margin="0,0,0,4">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Mode}" Value="GlobalPercentage">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <TextBlock Text="Процент (0–10 %):" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBox Text="{Binding GlobalPercent, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.0}"
                                                             Width="70" FontSize="12" Padding="5,3"
                                                             BorderBrush="#7B1FA2" BorderThickness="1"
                                                             LostFocus="TbGlobalPercent_LostFocus"/>
                                                    <TextBlock Text=" %" FontSize="12" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Hel ="   FontSize="12" Margin="0,0,4,0"  VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Hel,    StringFormat=0.000}" FontSize="12" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Htb ="   FontSize="12" Margin="0,0,4,0"  VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Htb,    StringFormat=0.000}" FontSize="12" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Htotal =" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Htotal, StringFormat=0.000}" FontSize="12" FontWeight="Bold" Margin="0,0,4,0"  VerticalAlignment="Center"/>
                                                    <TextBlock Text="W/K" FontSize="11" Foreground="#777" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- ── Панел: Ръчно въвеждане ── -->
                                            <StackPanel>
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Mode}" Value="Manual">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>

                                                <!-- Таблица термомостове -->
                                                <DataGrid x:Name="ThermalBridgesGrid"
                                                          ItemsSource="{Binding Items}"
                                                          AutoGenerateColumns="False"
                                                          CanUserAddRows="False"
                                                          IsReadOnly="True"
                                                          HeadersVisibility="Column"
                                                          SelectionMode="Single"
                                                          FontSize="11"
                                                          Margin="0,0,0,6"
                                                          MaxHeight="240"
                                                          VerticalScrollBarVisibility="Auto"
                                                          Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Border}}"
                                                          SelectionChanged="TbGrid_SelectionChanged">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Тип"      Binding="{Binding Type}"                                    Width="*"/>
                                                        <DataGridTextColumn Header="L (m)"    Binding="{Binding Length, StringFormat=0.000}"               Width="65"/>
                                                        <DataGridTextColumn Header="Ψ (W/mK)" Binding="{Binding Psi,    StringFormat=0.000}"               Width="75"/>
                                                        <DataGridTextColumn Header="χ (W/K)"  Binding="{Binding Chi,    StringFormat=0.000}"               Width="65"/>
                                                        <!-- Фасади – checkbox колони (read-only display) -->
                                                        <DataGridCheckBoxColumn Header="С"    Binding="{Binding FacadeNorth}"     Width="34" IsReadOnly="True"/>
                                                        <DataGridCheckBoxColumn Header="СИ"   Binding="{Binding FacadeNorthEast}" Width="34" IsReadOnly="True"/>
                                                        <DataGridCheckBoxColumn Header="И"    Binding="{Binding FacadeEast}"      Width="34" IsReadOnly="True"/>
                                                        <DataGridCheckBoxColumn Header="ЮИ"   Binding="{Binding FacadeSouthEast}" Width="34" IsReadOnly="True"/>
                                                        <DataGridCheckBoxColumn Header="Ю"    Binding="{Binding FacadeSouth}"     Width="34" IsReadOnly="True"/>
                                                        <DataGridCheckBoxColumn Header="ЮЗ"   Binding="{Binding FacadeSouthWest}" Width="34" IsReadOnly="True"/>
                                                        <DataGridCheckBoxColumn Header="З"    Binding="{Binding FacadeWest}"      Width="34" IsReadOnly="True"/>
                                                        <DataGridCheckBoxColumn Header="СЗ"   Binding="{Binding FacadeNorthWest}" Width="34" IsReadOnly="True"/>
                                                        <DataGridTextColumn Header="L×Ψ"     Binding="{Binding LinearLoss, StringFormat=0.000}"            Width="65" IsReadOnly="True"/>
                                                        <DataGridTextColumn Header="n"        Binding="{Binding FacadeCount}"                               Width="30" IsReadOnly="True"/>
                                                        <DataGridTextColumn Header="Общо×n"   Binding="{Binding TotalLoss,  StringFormat=0.000}"            Width="70" IsReadOnly="True"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>

                                                <!-- Бутони Добави / Редактирай / Изтрий -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <Button Content="+ Добави"     Padding="8,3" Margin="0,0,8,0"
                                                            Background="#4CAF50" Foreground="White" BorderThickness="0"
                                                            Tag="{Binding}"
                                                            Click="TbAdd_Click"/>
                                                    <Button Content="Редактирай"  Padding="8,3" Margin="0,0,8,0"
                                                            Background="#1976D2" Foreground="White" BorderThickness="0"
                                                            Tag="{Binding}"
                                                            Click="TbEdit_Click"/>
                                                    <Button Content="Изтрий"      Padding="8,3"
                                                            Background="#e53935" Foreground="White" BorderThickness="0"
                                                            Tag="{Binding}"
                                                            Click="TbDelete_Click"/>
                                                </StackPanel>

                                                <!-- Summary -->
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Hel ="   FontSize="12" Margin="0,0,4,0"  VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Hel,    StringFormat=0.000}" FontSize="12" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Htb ="   FontSize="12" Margin="0,0,4,0"  VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Htb,    StringFormat=0.000}" FontSize="12" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Htotal =" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Htotal, StringFormat=0.000}" FontSize="12" FontWeight="Bold" Margin="0,0,4,0"  VerticalAlignment="Center"/>
                                                    <TextBlock Text="W/K" FontSize="11" Foreground="#777" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>

                                        </StackPanel>
                                    </Border>
                                </Expander>

                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
    </Grid>
</UserControl>
