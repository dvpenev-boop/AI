<Window x:Class="EE.Doklad.Views.WallThermalBridgeItemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:EE.Doklad.Converters"
        Title="Топлинен мост"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <converters:FlexibleDoubleConverter x:Key="FlexibleDoubleConverter"/>
    </Window.Resources>

    <StackPanel Margin="20">
        <!-- Тип / наименование -->
        <TextBlock Text="Тип / наименование:" FontSize="12" Margin="0,0,0,4"/>
        <TextBox x:Name="TypeBox"
                 FontSize="12" Padding="6,4" Margin="0,0,0,14"
                 BorderBrush="#2196F3" BorderThickness="1"/>

        <!-- L, ψ, χ -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="L (m):" FontSize="11" Margin="0,0,0,3"/>
                <TextBox x:Name="LengthBox" FontSize="12" Padding="5,3"
                         BorderBrush="#2196F3" BorderThickness="1"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Ψ (W/mK):" FontSize="11" Margin="0,0,0,3"/>
                <TextBox x:Name="PsiBox" FontSize="12" Padding="5,3"
                         BorderBrush="#2196F3" BorderThickness="1"/>
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="χ (W/K):" FontSize="11" Margin="0,0,0,3"/>
                <TextBox x:Name="ChiBox" FontSize="12" Padding="5,3"
                         BorderBrush="#2196F3" BorderThickness="1"/>
            </StackPanel>
        </Grid>

        <!-- Фасади – CheckBox матрица -->
        <TextBlock x:Name="FacadesLabel" Text="Фасади:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <WrapPanel x:Name="FacadesPanel" Margin="0,0,0,14">
            <CheckBox x:Name="CbNorth"     Content="С"  Margin="4" FontSize="12"/>
            <CheckBox x:Name="CbNorthEast" Content="СИ" Margin="4" FontSize="12"/>
            <CheckBox x:Name="CbEast"      Content="И"  Margin="4" FontSize="12"/>
            <CheckBox x:Name="CbSouthEast" Content="ЮИ" Margin="4" FontSize="12"/>
            <CheckBox x:Name="CbSouth"     Content="Ю"  Margin="4" FontSize="12"/>
            <CheckBox x:Name="CbSouthWest" Content="ЮЗ" Margin="4" FontSize="12"/>
            <CheckBox x:Name="CbWest"      Content="З"  Margin="4" FontSize="12"/>
            <CheckBox x:Name="CbNorthWest" Content="СЗ" Margin="4" FontSize="12"/>
        </WrapPanel>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Запази" Width="90" Padding="6,4" Margin="0,0,10,0"
                    Background="#1976D2" Foreground="White" BorderThickness="0"
                    Click="Save_Click"/>
            <Button Content="Отказ" Width="90" Padding="6,4"
                    Background="#9E9E9E" Foreground="White" BorderThickness="0"
                    Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
