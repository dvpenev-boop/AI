<UserControl x:Class="EE.Doklad.Views.HeatingSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:EE.Doklad.Converters"
             xmlns:models="clr-namespace:EE.Doklad.Models"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="900">

    <UserControl.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>

        <!-- Note: energy-related styles and converters are defined at Application scope (App.xaml)
             to ensure ComboBox item container styles are available to the popup visual root on first show.
             Keep section-specific styles here. -->

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,8,0,2"/>
        </Style>
        
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        
        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        
        <!-- Backwards-compatible alias used across views: ensure editable textboxes are vertically centered -->
        <Style x:Key="EditableTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource InputTextBoxStyle}">
            <!-- keep defaults from InputTextBoxStyle; individual TextBoxes set Width/TextAlignment -->
        </Style>
        
        <Style x:Key="ReadOnlyTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource InputTextBoxStyle}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#F9F9F9"/>
            <Setter Property="Foreground" Value="#555"/>
        </Style>

        <Style x:Key="CompactEnergyComboBoxItemStyle" TargetType="ComboBoxItem" BasedOn="{StaticResource EnergyComboBoxItemStyle}">
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>

        <Style x:Key="CompactEnergySourceComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource EnergySourceComboBoxStyle}">
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource CompactEnergyComboBoxItemStyle}"/>
        </Style>
        
        <Style x:Key="ErrorTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Red"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="4,1,0,0"/>
        </Style>

        <Style x:Key="HeatingSummaryHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#E53935"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style x:Key="HeatingSummaryCellTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="HeatingSummaryRowStyle" TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#FFF5F5"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsTotal}" Value="True">
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Background" Value="#FFF0E6"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                    <Setter Property="Background" Value="#FFE6F4EA"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                    <Setter Property="MinHeight" Value="6"/>
                    <Setter Property="MaxHeight" Value="6"/>
                    <Setter Property="Background" Value="#FFD8D8D8"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="IsHitTestVisible" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <!-- Заглавие -->
            <TextBlock Text="11. Отопление"
                       FontSize="18" 
                       FontWeight="Bold" 
                       Margin="0,0,0,15"/>

            <!-- Warning text (when heating season is NOT enabled) -->
            <Border Background="#FFF3CD" BorderBrush="#FFC107" BorderThickness="2" Padding="12" Margin="0,0,0,15"
                    Visibility="{Binding HeatingSeasonWarning, Converter={StaticResource StringToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠️" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding HeatingSeasonWarning}" 
                               FontSize="13" FontWeight="SemiBold" 
                               Foreground="#856404" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Main content (disabled when heating season is NOT enabled) -->
            <StackPanel IsEnabled="{Binding IsHeatingSeasonEnabled}">

                <!-- Описание (свободен текст) -->
                <TextBlock Text="Описание:"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>
                
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         MinHeight="80"
                         Padding="10"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         FontSize="11"
                         Margin="0,0,0,20"
                         BorderBrush="#E0E0E0"
                         BorderThickness="1"/>

            <TextBlock Text="Часове работа на инсталацията" Style="{StaticResource SectionHeaderStyle}"/>
            <Border BorderBrush="#E0E0E0" BorderThickness="1" Margin="0" Width="820" HorizontalAlignment="Left">
                <Grid Background="White">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="520"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Background="#E53935" BorderBrush="White" BorderThickness="0,0,1,1">
                        <TextBlock Text="Параметър" FontWeight="Bold" Foreground="White" Padding="10,4" FontSize="13"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Background="#E53935" BorderBrush="White" BorderThickness="0,0,0,1">
                        <TextBlock Text="Актуално състояние" FontWeight="Bold" Foreground="White" Padding="10,4" FontSize="13"/>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
                        <TextBlock Text="t_H [h/год]" Style="{StaticResource LabelStyle}"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0">
                        <TextBox Text="{Binding HeatingInstallationHoursDisplay, Mode=OneWay}"
                                 Style="{StaticResource ReadOnlyTextBoxStyle}"
                                 TextAlignment="Center"
                                 HorizontalAlignment="Stretch"/>
                    </Border>
                </Grid>
            </Border>

            <!-- СЕКЦИЯ 1: РЪЧНИ ПАРАМЕТРИ -->
            <TextBlock Text="Топлинни характеристики" Style="{StaticResource SectionHeaderStyle}"/>
            <Border BorderBrush="#E0E0E0" BorderThickness="1" Margin="0" HorizontalAlignment="Left">
                <DataGrid ItemsSource="{Binding ThermalCharacteristicsRows}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          CanUserResizeRows="False"
                          CanUserSortColumns="False"
                          HeadersVisibility="Column"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          AlternationCount="2"
                          AlternatingRowBackground="#FFF5F5"
                          RowStyle="{StaticResource HeatingSummaryRowStyle}"
                          ColumnHeaderStyle="{StaticResource HeatingSummaryHeaderStyle}"
                          BorderThickness="0"
                          Background="White"
                          MinWidth="820">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Параметър" Binding="{Binding Parameter}" Width="344"/>
                        <DataGridTemplateColumn Header="U (W/m²K)" Width="88">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding UDisplay}" Style="{StaticResource HeatingSummaryCellTextStyle}" ToolTip="{Binding UToolTip}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="A (m²)" Width="88">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ADisplay}" Style="{StaticResource HeatingSummaryCellTextStyle}" ToolTip="{Binding AToolTip}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="H (W/K)" Binding="{Binding HDisplay}" Width="88" ElementStyle="{StaticResource HeatingSummaryCellTextStyle}"/>
                        <DataGridTextColumn Header="kWh/m²" Binding="{Binding KwhPerAreaDisplay}" Width="88" ElementStyle="{StaticResource HeatingSummaryCellTextStyle}"/>
                        <DataGridTextColumn Header="kWh" Binding="{Binding KwhDisplay}" Width="124" ElementStyle="{StaticResource HeatingSummaryCellTextStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <TextBlock Text="Параметри сграда Отопление" Style="{StaticResource SectionHeaderStyle}"/>
             
            <Border BorderBrush="#E0E0E0" BorderThickness="1" Margin="0" Width="820" HorizontalAlignment="Left">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="520"/>
                            <ColumnDefinition Width="300"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#E53935" BorderBrush="White" BorderThickness="0,0,1,1">
                            <TextBlock Text="Параметър" FontWeight="Bold" Foreground="White" Padding="10,4" FontSize="13"/>
                        </Border>
                        <Border Grid.Column="1" Background="#E53935" BorderBrush="White" BorderThickness="0,0,0,1">
                            <TextBlock Text="Актуално състояние" FontWeight="Bold" Foreground="White" Padding="10,4" FontSize="13"/>
                        </Border>
                    </Grid>

                    <!-- Keep only the first three manual inputs -->
                    <!-- Инфилтрация -->
                    <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <Grid Background="White">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="520"/>
                                <ColumnDefinition Width="300"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Инфилтрация [1/ч]" Style="{StaticResource LabelStyle}"/>
                            <StackPanel Grid.Column="1">
                <TextBox Text="{Binding InfiltrationText, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" HorizontalAlignment="Stretch"/>
                                <TextBlock Text="{Binding InfiltrationError}"
                                          Style="{StaticResource ErrorTextStyle}"
                                          Visibility="{Binding HasInfiltrationError, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Проектна температура -->
                    <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <Grid Background="White">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="520"/>
                                <ColumnDefinition Width="300"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Проектна температура [°C]" Style="{StaticResource LabelStyle}"/>
                            <StackPanel Grid.Column="1">
                <TextBox Text="{Binding DesignTemperatureText, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" HorizontalAlignment="Stretch"/>
                                <TextBlock Text="{Binding DesignTemperatureError}"
                                          Style="{StaticResource ErrorTextStyle}"
                                          Visibility="{Binding HasDesignTemperatureError, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Температура на понижение -->
                    <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <Grid Background="White">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="520"/>
                                <ColumnDefinition Width="300"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Температура на понижение [°C]" Style="{StaticResource LabelStyle}"/>
                            <StackPanel Grid.Column="1">
                <TextBox Text="{Binding ReductionTemperatureText, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" HorizontalAlignment="Stretch"/>
                                <TextBlock Text="{Binding ReductionTemperatureError}"
                                          Style="{StaticResource ErrorTextStyle}"
                                          Visibility="{Binding HasReductionTemperatureError, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <Grid Background="#F0F0F0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="520"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="" Style="{StaticResource LabelStyle}"/>
                            <TextBlock Grid.Column="1" Text="kWh/m²" FontWeight="SemiBold" FontSize="11"
                                       Padding="10,3" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Stretch"/>
                            <TextBlock Grid.Column="2" Text="kWh" FontWeight="SemiBold" FontSize="11"
                                       Padding="10,3" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Stretch"/>
                        </Grid>
                    </Border>
                    <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <Grid Background="White">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="520"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Приноси от вентилация" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Column="1" Text="{Binding VentilationGainPerAreaDisplay, Mode=OneWay}"
                                     Style="{StaticResource ReadOnlyTextBoxStyle}" TextAlignment="Center" HorizontalAlignment="Stretch"/>
                            <TextBox Grid.Column="2" Text="{Binding VentilationGainKwhDisplay, Mode=OneWay}"
                                     Style="{StaticResource ReadOnlyTextBoxStyle}" TextAlignment="Center" HorizontalAlignment="Stretch"/>
                        </Grid>
                    </Border>
                    <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <Grid Background="White">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="520"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Приноси от осветление" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Column="1" Text="{Binding LightingGainPerAreaDisplay, Mode=OneWay}"
                                     Style="{StaticResource ReadOnlyTextBoxStyle}" TextAlignment="Center" HorizontalAlignment="Stretch"/>
                            <TextBox Grid.Column="2" Text="{Binding LightingGainKwhDisplay, Mode=OneWay}"
                                     Style="{StaticResource ReadOnlyTextBoxStyle}" TextAlignment="Center" HorizontalAlignment="Stretch"/>
                        </Grid>
                    </Border>
                    <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <Grid Background="White">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="520"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Приноси от уреди" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Column="1" Text="{Binding AppliancesGainPerAreaDisplay, Mode=OneWay}"
                                     Style="{StaticResource ReadOnlyTextBoxStyle}" TextAlignment="Center" HorizontalAlignment="Stretch"/>
                            <TextBox Grid.Column="2" Text="{Binding AppliancesGainKwhDisplay, Mode=OneWay}"
                                     Style="{StaticResource ReadOnlyTextBoxStyle}" TextAlignment="Center" HorizontalAlignment="Stretch"/>
                        </Grid>
                    </Border>
                    <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <Grid Background="#FFF0E6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="520"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Нетна енергия" Style="{StaticResource LabelStyle}" FontWeight="Bold"/>
                            <TextBox Grid.Column="1" Text="{Binding NetHeatingEnergyAfterGainsDisplay, Mode=OneWay}"
                                     Style="{StaticResource ReadOnlyTextBoxStyle}" TextAlignment="Center"
                                     HorizontalAlignment="Stretch" FontWeight="Bold"/>
                            <TextBox Grid.Column="2" Text="{Binding NetHeatingEnergyAfterGainsKwhDisplay, Mode=OneWay}"
                                     Style="{StaticResource ReadOnlyTextBoxStyle}" TextAlignment="Center"
                                     HorizontalAlignment="Stretch" FontWeight="Bold"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Енергийни източници за отопление -->
            <TextBlock Text="Енергийни източници за отопление" Style="{StaticResource SectionHeaderStyle}"/>
            <Border BorderBrush="#E0E0E0" BorderThickness="1" Margin="0" Width="820" HorizontalAlignment="Left">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="520"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <!-- Header Row -->
                    <Border Grid.Row="0" Grid.Column="0" Background="#E53935" BorderBrush="White" BorderThickness="0,0,1,1">
                        <TextBlock Text="Параметър" FontWeight="Bold" Foreground="White" Padding="10,4" FontSize="13"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Background="#E53935" BorderBrush="White" BorderThickness="0,0,0,1">
                        <TextBlock Text="Актуално състояние" FontWeight="Bold" Foreground="White" Padding="10,4" FontSize="13"/>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Енергиен източник 1 (ЕИ1)" Padding="10,3" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <ComboBox x:Name="HeatingEnergyCarrierCombo1"
                                  ItemsSource="{x:Static models:EnergyCarrierInfo.All}"
                                  SelectedValuePath="Code"
                                  SelectedValue="{Binding EnergySource1Carrier, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Padding="0"
                                  FontSize="10"
                                  HorizontalAlignment="Stretch"
                                  Margin="1"
                                  Style="{StaticResource CompactEnergySourceComboBoxStyle}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="10" LineHeight="12" LineStackingStrategy="BlockLineHeight" Padding="0"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                            <ComboBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="10" Foreground="#0066CC" Margin="0,1,0,0"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ComboBox.GroupStyle>
                        </ComboBox>
                    </Border>

                    <!-- Row 1: Дял -->
                    <Border Grid.Row="2" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Дял, %" Padding="10,3" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <StackPanel Margin="1">
                            <TextBox Text="{Binding EnergySource1Share, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}"
                                     Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" HorizontalAlignment="Stretch"/>
                            <TextBlock Text="{Binding EnergySourceShareWarning}"
                                       Style="{StaticResource ErrorTextStyle}"
                                       Visibility="{Binding HasEnergySourceShareWarning, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </Border>

                    <!-- Row 2: Ефективност на отдаване -->
                    <Border Grid.Row="3" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Ефективност на отдаване, %" Padding="10,3" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="3" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <TextBox Text="{Binding EnergySource1EmissionEfficiency, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}"
                                 Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" HorizontalAlignment="Stretch"/>
                    </Border>

                    <!-- Row 3: Ефективност на разпределителната мрежа -->
                    <Border Grid.Row="4" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Ефективност на разпределителната мрежа, %" Padding="10,3" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="4" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <TextBox Text="{Binding EnergySource1DistributionEfficiency, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}"
                                 Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" HorizontalAlignment="Stretch"/>
                    </Border>

                    <!-- Row 4: Автоматично управление -->
                    <Border Grid.Row="5" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Автоматично управление, %" Padding="10,3" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="5" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <TextBox Text="{Binding EnergySource1AutomaticControl, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}"
                                 Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" HorizontalAlignment="Stretch"/>
                    </Border>

                    <!-- Row 5: Енергиен мениджмънт -->
                    <Border Grid.Row="6" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Енергиен мениджмънт (ЕМ) и поддръжка, %" Padding="10,3" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="6" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <TextBox Text="{Binding EnergySource1EnergyManagement, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}"
                                 Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" HorizontalAlignment="Stretch"/>
                    </Border>

                    <!-- Row 6: Ефективност на генератора на топлина -->
                    <Border Grid.Row="7" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Ефективност на генератора на топлина, %" Padding="10,3" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="7" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <TextBox Text="{Binding EnergySource1GenerationEfficiency, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}"
                                 Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" HorizontalAlignment="Stretch"/>
                    </Border>

                    <Border Grid.Row="8" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0">
                        <TextBlock Text="Потребна енергия (ЕИ1), kWh/m²" Padding="10,3" VerticalAlignment="Center" TextWrapping="Wrap" FontWeight="Bold"/>
                    </Border>
                    <Border Grid.Row="8" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0">
                        <TextBox Text="{Binding EnergySource1RequiredEnergyPerAreaDisplay, Mode=OneWay}"
                                 Style="{StaticResource ReadOnlyTextBoxStyle}" TextAlignment="Center" HorizontalAlignment="Stretch" FontWeight="Bold"/>
                    </Border>
                </Grid>
            </Border>

            <CheckBox Content="Използвай втори енергиен източник (ЕИ2)" 
                      IsChecked="{Binding UseSecondEnergySource}" 
                      FontWeight="Bold" 
                      Margin="0"/>

            <Border BorderBrush="#E0E0E0" BorderThickness="1" Margin="0" 
                    Visibility="{Binding UseSecondEnergySource, Converter={StaticResource BoolToVisibilityConverter}}" Width="820" HorizontalAlignment="Left">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="520"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <!-- Header Row -->
                    <Border Grid.Row="0" Grid.Column="0" Background="#E53935" BorderBrush="White" BorderThickness="0,0,1,1">
                        <TextBlock Text="Параметър" FontWeight="Bold" Foreground="White" Padding="10,4" FontSize="13"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Background="#E53935" BorderBrush="White" BorderThickness="0,0,0,1">
                        <TextBlock Text="Актуално състояние" FontWeight="Bold" Foreground="White" Padding="10,4" FontSize="13"/>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Енергиен източник 2 (ЕИ2)" Padding="10,3" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <ComboBox x:Name="HeatingEnergyCarrierCombo2"
                                  ItemsSource="{x:Static models:EnergyCarrierInfo.All}"
                                  SelectedValuePath="Code"
                                  SelectedValue="{Binding EnergySource2Carrier, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Padding="0"
                                  FontSize="10"
                                  HorizontalAlignment="Stretch"
                                  Margin="1"
                                  Style="{StaticResource CompactEnergySourceComboBoxStyle}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="10" LineHeight="12" LineStackingStrategy="BlockLineHeight" Padding="0"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                            <ComboBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="10" Foreground="#0066CC" Margin="0,1,0,0"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ComboBox.GroupStyle>
                        </ComboBox>
                    </Border>

                    <!-- Row 1: Дял -->
                    <Border Grid.Row="2" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Дял, %" Padding="10,3" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <StackPanel Margin="1">
                            <TextBox Text="{Binding EnergySource2Share, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}"
                                     Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" HorizontalAlignment="Stretch"/>
                            <TextBlock Text="{Binding EnergySourceShareWarning}"
                                       Style="{StaticResource ErrorTextStyle}"
                                       Visibility="{Binding HasEnergySourceShareWarning, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </Border>

                    <!-- Row 2: Ефективност на отдаване -->
                    <Border Grid.Row="3" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Ефективност на отдаване, %" Padding="10,3" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="3" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <TextBox Text="{Binding EnergySource2EmissionEfficiency, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}"
                                 Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" HorizontalAlignment="Stretch"/>
                    </Border>

                    <!-- Row 3: Ефективност на разпределителната мрежа -->
                    <Border Grid.Row="4" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Ефективност на разпределителната мрежа, %" Padding="10,3" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="4" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <TextBox Text="{Binding EnergySource2DistributionEfficiency, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}"
                                 Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" HorizontalAlignment="Stretch"/>
                    </Border>

                    <!-- Row 4: Автоматично управление -->
                    <Border Grid.Row="5" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Автоматично управление, %" Padding="10,3" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="5" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <TextBox Text="{Binding EnergySource2AutomaticControl, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}"
                                 Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" HorizontalAlignment="Stretch"/>
                    </Border>

                    <!-- Row 5: Енергиен мениджмънт -->
                    <Border Grid.Row="6" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Енергиен мениджмънт (ЕМ) и поддръжка, %" Padding="10,3" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="6" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <TextBox Text="{Binding EnergySource2EnergyManagement, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}"
                                 Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" HorizontalAlignment="Stretch"/>
                    </Border>

                    <!-- Row 6: Ефективност на генератора на топлина -->
                    <Border Grid.Row="7" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Ефективност на генератора на топлина, %" Padding="10,3" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="7" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <TextBox Text="{Binding EnergySource2GenerationEfficiency, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}"
                                 Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" HorizontalAlignment="Stretch"/>
                    </Border>

                    <Border Grid.Row="8" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0">
                        <TextBlock Text="Потребна енергия (ЕИ2), kWh/m²" Padding="10,3" VerticalAlignment="Center" TextWrapping="Wrap" FontWeight="Bold"/>
                    </Border>
                    <Border Grid.Row="8" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0">
                        <TextBox Text="{Binding EnergySource2RequiredEnergyPerAreaDisplay, Mode=OneWay}"
                                 Style="{StaticResource ReadOnlyTextBoxStyle}" TextAlignment="Center" HorizontalAlignment="Stretch" FontWeight="Bold"/>
                    </Border>
                </Grid>
            </Border>

            <Border BorderBrush="#666" BorderThickness="2" Margin="0" Width="820" HorizontalAlignment="Left">
                <Grid Background="White">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="520"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Background="#E53935" BorderBrush="White" BorderThickness="0,0,1,1">
                        <TextBlock Text="Параметър" FontWeight="Bold" Foreground="White" Padding="10,4" FontSize="13"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Background="#E53935" BorderBrush="White" BorderThickness="0,0,0,1">
                        <TextBlock Text="Актуално състояние" FontWeight="Bold" Foreground="White" Padding="10,4" FontSize="13"/>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0" BorderBrush="#888" BorderThickness="0,0,1,1">
                        <TextBlock Text="Обща ефективност на генериране на топлина, %" Style="{StaticResource LabelStyle}"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" BorderBrush="#888" BorderThickness="0,0,0,1">
                        <TextBox Text="{Binding OverallHeatGenerationEfficiencyDisplay, Mode=OneWay}"
                                 Style="{StaticResource ReadOnlyTextBoxStyle}"
                                 TextAlignment="Center"
                                 HorizontalAlignment="Stretch"/>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="0" BorderBrush="#888" BorderThickness="0,0,1,0">
                        <TextBlock Text="Обща потребна енергия, kWh/m²" Style="{StaticResource LabelStyle}"/>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="1" BorderBrush="#888" BorderThickness="0">
                        <TextBox Text="{Binding TotalGrossHeatingEnergyPerAreaDisplay, Mode=OneWay}"
                                 Style="{StaticResource ReadOnlyTextBoxStyle}"
                                 TextAlignment="Center"
                                 HorizontalAlignment="Stretch"
                                 FontWeight="Bold"/>
                    </Border>
                </Grid>
            </Border>

            <Border Background="#FFF9E6" BorderBrush="#FFD700" BorderThickness="1" Padding="12" Margin="0,8,0,0">
                <TextBlock Text="Панелът &quot;Топлина от обитатели - Отопление&quot; е преместен в секция 5 &quot;Данни за обекта&quot;."
                           TextWrapping="Wrap"
                           FontSize="11"/>
            </Border>

            </StackPanel> <!-- End of IsEnabled wrapper -->

            <!-- Информационна бележка -->
            <Border Background="#FFF9E6" BorderBrush="#FFD700" BorderThickness="1" Padding="15" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="ℹ Забележки:" FontWeight="Bold" FontSize="12" Margin="0,0,0,5"/>
                    <TextBlock TextWrapping="Wrap" FontSize="11" LineHeight="18">
                        <Run Text="• Стойностите за топлина на човек се изчисляват автоматично чрез линейна интерполация по температура."/>
                        <LineBreak/>
                        <Run Text="• Брой обитатели се взима от секция 5 (Данни за обекта)."/>
                        <LineBreak/>
                        <Run Text="• Температура в помещението е равна на проектната температура."/>
                        <LineBreak/>
                        <Run Text="• Десетичните стойности могат да се въвеждат с ',' или '.' като разделител."/>
                        <LineBreak/>
                        <Run Text="• Стойностите в W/m² се изчисляват на база отопляемата площ от секция 5."/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
