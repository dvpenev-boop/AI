<UserControl x:Class="EE.Doklad.Views.FloorPanels.FloorUnheatedBasementPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:EE.Doklad.Converters"
             xmlns:views="clr-namespace:EE.Doklad.Views">
    <UserControl.Resources>
        <converters:FlexibleDoubleConverter x:Key="FlexibleDoubleConverter"/>
        <converters:AttachmentToVisibilityConverter x:Key="AttachmentToVisibilityConverter"/>
        <converters:AttachmentToImageSourceConverter x:Key="AttachmentToImageSourceConverter"/>
    </UserControl.Resources>
    <Border BorderBrush="#CCCCCC" BorderThickness="1" Padding="10" Margin="0,0,0,15">
        <StackPanel>
            <TextBlock Text="Под към неотопляем сутерен" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>

            <!-- Геометрия -->
            <TextBlock Text="Геометрия" FontWeight="SemiBold" Margin="0,6,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Площ A (m²):" VerticalAlignment="Center" Margin="0,0,5,0" Width="150"/>
                <TextBox Width="100" Text="{Binding Area, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.00}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Периметър P (m):" VerticalAlignment="Center" Margin="0,0,5,0" Width="150"/>
                <TextBox Width="100" Text="{Binding Perimeter, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.00}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Дълбочина z (m):" VerticalAlignment="Center" Margin="0,0,5,0" Width="150"/>
                <TextBox Width="100" Text="{Binding DepthBelowGround, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.00}" Margin="0,0,10,0"/>
                <TextBlock Text="Височина h (m):" VerticalAlignment="Center" Margin="0,0,5,0" Width="120"/>
                <TextBox Width="100" Text="{Binding HeightAboveGround, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.00}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Обем V (m³):" VerticalAlignment="Center" Margin="0,0,5,0" Width="150"/>
                <TextBox Width="100" Text="{Binding Volume, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.00}"/>
            </StackPanel>

            <!-- Параметри за земята -->
            <TextBlock Text="Параметри за земята" FontWeight="SemiBold" Margin="0,10,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="λg (W/m·K):" VerticalAlignment="Center" Margin="0,0,5,0" Width="150"/>
                <TextBox Width="100" Text="{Binding LambdaGround, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.00}" Margin="0,0,10,0"/>
                <TextBlock Text="d_we (m):" VerticalAlignment="Center" Margin="0,0,5,0" Width="120"/>
                <TextBox Width="100" Text="{Binding WallThicknessAtGrade, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.00}"/>
            </StackPanel>

            <!-- Вентилация -->
            <TextBlock Text="Вентилация" FontWeight="SemiBold" Margin="0,10,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="n (1/h):" VerticalAlignment="Center" Margin="0,0,5,0" Width="150"/>
                <TextBox Width="100" Text="{Binding AirChangeRate, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.00}"/>
            </StackPanel>

            <!-- Под между отопляемото и сутерена -->
            <TextBlock Text="Под отопляемо → сутерен" FontWeight="SemiBold" Margin="0,15,0,4" Background="#E3F2FD" Padding="4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Rsi (m²K/W):" VerticalAlignment="Center" Margin="0,0,5,0" Width="150"/>
                <TextBox Width="100" Text="{Binding RsiFloorToBasement, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.00}" Margin="0,0,10,0"/>
                <TextBlock Text="Rse (m²K/W):" VerticalAlignment="Center" Margin="0,0,5,0" Width="120"/>
                <TextBox Width="100" Text="{Binding RseFloorToBasement, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.00}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <StackPanel Width="520">
                    <DataGrid ItemsSource="{Binding FloorToBasementLayers}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" Margin="0,0,0,5">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Материал" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=views:FloorSectionView}, Path=DataContext.MaterialOptionsView}"
                                                  SelectedValuePath="Id"
                                                  DisplayMemberPath="Display"
                                                  SelectedValue="{Binding SelectedMaterialId, UpdateSourceTrigger=PropertyChanged}"
                                                  Text="{Binding Material, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                  IsEditable="True"
                                                  StaysOpenOnEdit="True"
                                                  TextSearch.TextPath="NameBg">
                                            <ComboBox.Style>
                                                <Style TargetType="ComboBox">
                                                    <EventSetter Event="PreviewKeyUp" Handler="MaterialComboBox_PreviewKeyUp"/>
                                                    <EventSetter Event="LostFocus" Handler="MaterialComboBox_LostFocus"/>
                                                </Style>
                                            </ComboBox.Style>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="δ (m)" Binding="{Binding Thickness, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}" Width="90"/>
                            <DataGridTextColumn Header="λ (W/mK)" Binding="{Binding Lambda, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}" Width="90" IsReadOnly="True"/>
                            <DataGridTextColumn Header="R" Binding="{Binding R, StringFormat=0.000}" IsReadOnly="True" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="+ Слой" Padding="6,2" Margin="0,0,10,0" Background="#4CAF50" Foreground="White" BorderThickness="0" Click="AddFloorToBasementLayer_Click"/>
                        <Button Content="Премахни слой" Padding="6,2" Background="#F44336" Foreground="White" BorderThickness="0" Click="RemoveFloorToBasementLayer_Click"/>
                    </StackPanel>
                </StackPanel>
                <Border BorderBrush="#AAAAAA" BorderThickness="1" Margin="20,0,0,0" Padding="8" Width="220" Height="220">
                    <StackPanel>
                        <TextBlock Text="Схема" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <Border BorderBrush="#DDDDDD" BorderThickness="1" Height="130" VerticalAlignment="Center">
                            <Grid>
                                <Image Stretch="Uniform"
                                       Visibility="{Binding FloorToBasementSchemeAttachment, Converter={StaticResource AttachmentToVisibilityConverter}}"
                                       Source="{Binding FloorToBasementSchemeAttachment, Converter={StaticResource AttachmentToImageSourceConverter}}"/>
                                <TextBlock Text="Няма изображение" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding FloorToBasementSchemeAttachment, Converter={StaticResource AttachmentToVisibilityConverter}, ConverterParameter=Inverse}"/>
                            </Grid>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                            <Button Content="Качи" Padding="6,2" Margin="0,0,8,0" Background="#2196F3" Foreground="White" BorderThickness="0"
                                    Click="UploadFloorToBasementScheme_Click"/>
                            <Button Content="Премахни" Padding="6,2" Background="#F44336" Foreground="White" BorderThickness="0"
                                    Click="RemoveFloorToBasementScheme_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="+ Слой" Padding="6,2" Margin="0,0,10,0" Background="#4CAF50" Foreground="White" BorderThickness="0" Click="AddFloorToBasementLayer_Click"/>
                <Button Content="Премахни слой" Padding="6,2" Background="#F44336" Foreground="White" BorderThickness="0" Click="RemoveFloorToBasementLayer_Click"/>
            </StackPanel>

            <!-- Подова плоча на сутерена -->
            <TextBlock Text="Подова плоча на сутерена" FontWeight="SemiBold" Margin="0,10,0,4" Background="#FFF3E0" Padding="4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Rsi (m²K/W):" VerticalAlignment="Center" Margin="0,0,5,0" Width="150"/>
                <TextBox Width="100" Text="{Binding RsiBasementFloor, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.00}" Margin="0,0,10,0"/>
                <TextBlock Text="Rse (m²K/W):" VerticalAlignment="Center" Margin="0,0,5,0" Width="120"/>
                <TextBox Width="100" Text="{Binding RseBasementFloor, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.00}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <StackPanel Width="520">
                    <DataGrid ItemsSource="{Binding BasementFloorLayers}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" Margin="0,0,0,5">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Материал" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=views:FloorSectionView}, Path=DataContext.MaterialOptionsView}"
                                                  SelectedValuePath="Id"
                                                  DisplayMemberPath="Display"
                                                  SelectedValue="{Binding SelectedMaterialId, UpdateSourceTrigger=PropertyChanged}"
                                                  Text="{Binding Material, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                  IsEditable="True"
                                                  StaysOpenOnEdit="True"
                                                  TextSearch.TextPath="NameBg">
                                            <ComboBox.Style>
                                                <Style TargetType="ComboBox">
                                                    <EventSetter Event="PreviewKeyUp" Handler="MaterialComboBox_PreviewKeyUp"/>
                                                    <EventSetter Event="LostFocus" Handler="MaterialComboBox_LostFocus"/>
                                                </Style>
                                            </ComboBox.Style>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="δ (m)" Binding="{Binding Thickness, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}" Width="90"/>
                            <DataGridTextColumn Header="λ (W/mK)" Binding="{Binding Lambda, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}" Width="90" IsReadOnly="True"/>
                            <DataGridTextColumn Header="R" Binding="{Binding R, StringFormat=0.000}" IsReadOnly="True" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="+ Слой" Padding="6,2" Margin="0,0,10,0" Background="#4CAF50" Foreground="White" BorderThickness="0" Click="AddBasementFloorLayer_Click"/>
                        <Button Content="Премахни слой" Padding="6,2" Background="#F44336" Foreground="White" BorderThickness="0" Click="RemoveBasementFloorLayer_Click"/>
                    </StackPanel>
                </StackPanel>
                <Border BorderBrush="#AAAAAA" BorderThickness="1" Margin="20,0,0,0" Padding="8" Width="220" Height="220">
                    <StackPanel>
                        <TextBlock Text="Схема" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <Border BorderBrush="#DDDDDD" BorderThickness="1" Height="130" VerticalAlignment="Center">
                            <Grid>
                                <Image Stretch="Uniform"
                                       Visibility="{Binding BasementFloorSchemeAttachment, Converter={StaticResource AttachmentToVisibilityConverter}}"
                                       Source="{Binding BasementFloorSchemeAttachment, Converter={StaticResource AttachmentToImageSourceConverter}}"/>
                                <TextBlock Text="Няма изображение" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding BasementFloorSchemeAttachment, Converter={StaticResource AttachmentToVisibilityConverter}, ConverterParameter=Inverse}"/>
                            </Grid>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                            <Button Content="Качи" Padding="6,2" Margin="0,0,8,0" Background="#2196F3" Foreground="White" BorderThickness="0"
                                    Click="UploadBasementFloorScheme_Click"/>
                            <Button Content="Премахни" Padding="6,2" Background="#F44336" Foreground="White" BorderThickness="0"
                                    Click="RemoveBasementFloorScheme_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Стени на сутерена към земя -->
            <TextBlock Text="Стени на сутерена → земя" FontWeight="SemiBold" Margin="0,10,0,4" Background="#F3E5F5" Padding="4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Rsi (m²K/W):" VerticalAlignment="Center" Margin="0,0,5,0" Width="150"/>
                <TextBox Width="100" Text="{Binding RsiBasementWall, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.00}" Margin="0,0,10,0"/>
                <TextBlock Text="Rse (m²K/W):" VerticalAlignment="Center" Margin="0,0,5,0" Width="120"/>
                <TextBox Width="100" Text="{Binding RseBasementWall, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.00}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <StackPanel Width="520">
                    <DataGrid ItemsSource="{Binding BasementWallLayers}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" Margin="0,0,0,5">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Материал" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=views:FloorSectionView}, Path=DataContext.MaterialOptionsView}"
                                                  SelectedValuePath="Id"
                                                  DisplayMemberPath="Display"
                                                  SelectedValue="{Binding SelectedMaterialId, UpdateSourceTrigger=PropertyChanged}"
                                                  Text="{Binding Material, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                  IsEditable="True"
                                                  StaysOpenOnEdit="True"
                                                  TextSearch.TextPath="NameBg">
                                            <ComboBox.Style>
                                                <Style TargetType="ComboBox">
                                                    <EventSetter Event="PreviewKeyUp" Handler="MaterialComboBox_PreviewKeyUp"/>
                                                    <EventSetter Event="LostFocus" Handler="MaterialComboBox_LostFocus"/>
                                                </Style>
                                            </ComboBox.Style>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="δ (m)" Binding="{Binding Thickness, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}" Width="90"/>
                            <DataGridTextColumn Header="λ (W/mK)" Binding="{Binding Lambda, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}" Width="90" IsReadOnly="True"/>
                            <DataGridTextColumn Header="R" Binding="{Binding R, StringFormat=0.000}" IsReadOnly="True" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="+ Слой" Padding="6,2" Margin="0,0,10,0" Background="#4CAF50" Foreground="White" BorderThickness="0" Click="AddBasementWallLayer_Click"/>
                        <Button Content="Премахни слой" Padding="6,2" Background="#F44336" Foreground="White" BorderThickness="0" Click="RemoveBasementWallLayer_Click"/>
                    </StackPanel>
                </StackPanel>
                <Border BorderBrush="#AAAAAA" BorderThickness="1" Margin="20,0,0,0" Padding="8" Width="220" Height="220">
                    <StackPanel>
                        <TextBlock Text="Схема" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <Border BorderBrush="#DDDDDD" BorderThickness="1" Height="130" VerticalAlignment="Center">
                            <Grid>
                                <Image Stretch="Uniform"
                                       Visibility="{Binding BasementWallSchemeAttachment, Converter={StaticResource AttachmentToVisibilityConverter}}"
                                       Source="{Binding BasementWallSchemeAttachment, Converter={StaticResource AttachmentToImageSourceConverter}}"/>
                                <TextBlock Text="Няма изображение" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding BasementWallSchemeAttachment, Converter={StaticResource AttachmentToVisibilityConverter}, ConverterParameter=Inverse}"/>
                            </Grid>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                            <Button Content="Качи" Padding="6,2" Margin="0,0,8,0" Background="#2196F3" Foreground="White" BorderThickness="0"
                                    Click="UploadBasementWallScheme_Click"/>
                            <Button Content="Премахни" Padding="6,2" Background="#F44336" Foreground="White" BorderThickness="0"
                                    Click="RemoveBasementWallScheme_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Стени над терена -->
            <TextBlock Text="Стени над терена → въздух" FontWeight="SemiBold" Margin="0,10,0,4" Background="#E8F5E9" Padding="4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Rsi (m²K/W):" VerticalAlignment="Center" Margin="0,0,5,0" Width="150"/>
                <TextBox Width="100" Text="{Binding RsiWallAboveGrade, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.00}" Margin="0,0,10,0"/>
                <TextBlock Text="Rse (m²K/W):" VerticalAlignment="Center" Margin="0,0,5,0" Width="120"/>
                <TextBox Width="100" Text="{Binding RseWallAboveGrade, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.00}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <StackPanel Width="520">
                    <DataGrid ItemsSource="{Binding WallAboveGradeLayers}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" Margin="0,0,0,5">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Материал" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=views:FloorSectionView}, Path=DataContext.MaterialOptionsView}"
                                                  SelectedValuePath="Id"
                                                  DisplayMemberPath="Display"
                                                  SelectedValue="{Binding SelectedMaterialId, UpdateSourceTrigger=PropertyChanged}"
                                                  Text="{Binding Material, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                  IsEditable="True"
                                                  StaysOpenOnEdit="True"
                                                  TextSearch.TextPath="NameBg">
                                            <ComboBox.Style>
                                                <Style TargetType="ComboBox">
                                                    <EventSetter Event="PreviewKeyUp" Handler="MaterialComboBox_PreviewKeyUp"/>
                                                    <EventSetter Event="LostFocus" Handler="MaterialComboBox_LostFocus"/>
                                                </Style>
                                            </ComboBox.Style>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="δ (m)" Binding="{Binding Thickness, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}" Width="90"/>
                            <DataGridTextColumn Header="λ (W/mK)" Binding="{Binding Lambda, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}" Width="90" IsReadOnly="True"/>
                            <DataGridTextColumn Header="R" Binding="{Binding R, StringFormat=0.000}" IsReadOnly="True" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="+ Слой" Padding="6,2" Margin="0,0,10,0" Background="#4CAF50" Foreground="White" BorderThickness="0" Click="AddWallAboveGradeLayer_Click"/>
                        <Button Content="Премахни слой" Padding="6,2" Background="#F44336" Foreground="White" BorderThickness="0" Click="RemoveWallAboveGradeLayer_Click"/>
                    </StackPanel>
                </StackPanel>
                <Border BorderBrush="#AAAAAA" BorderThickness="1" Margin="20,0,0,0" Padding="8" Width="220" Height="220">
                    <StackPanel>
                        <TextBlock Text="Схема" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <Border BorderBrush="#DDDDDD" BorderThickness="1" Height="130" VerticalAlignment="Center">
                            <Grid>
                                <Image Stretch="Uniform"
                                       Visibility="{Binding WallAboveGradeSchemeAttachment, Converter={StaticResource AttachmentToVisibilityConverter}}"
                                       Source="{Binding WallAboveGradeSchemeAttachment, Converter={StaticResource AttachmentToImageSourceConverter}}"/>
                                <TextBlock Text="Няма изображение" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding WallAboveGradeSchemeAttachment, Converter={StaticResource AttachmentToVisibilityConverter}, ConverterParameter=Inverse}"/>
                            </Grid>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                            <Button Content="Качи" Padding="6,2" Margin="0,0,8,0" Background="#2196F3" Foreground="White" BorderThickness="0"
                                    Click="UploadWallAboveGradeScheme_Click"/>
                            <Button Content="Премахни" Padding="6,2" Background="#F44336" Foreground="White" BorderThickness="0"
                                    Click="RemoveWallAboveGradeScheme_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Прозорци и врати в надтеренната част -->
            <TextBlock Text="Прозорци и врати (над терена)" FontWeight="SemiBold" Margin="0,10,0,4" Background="#E3F2FD" Padding="4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Площ на прозорци (m²):" VerticalAlignment="Center" Margin="0,0,5,0" Width="180"/>
                <TextBox Width="80" Text="{Binding WindowArea, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.00}" Margin="0,0,10,0"/>
                <TextBlock Text="U-прозорци (W/m²K):" VerticalAlignment="Center" Margin="0,0,5,0" Width="120"/>
                <TextBox Width="80" Text="{Binding WindowUValue, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.00}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Площ на врати (m²):" VerticalAlignment="Center" Margin="0,0,5,0" Width="180"/>
                <TextBox Width="80" Text="{Binding DoorArea, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.00}" Margin="0,0,10,0"/>
                <TextBlock Text="U-врати (W/m²K):" VerticalAlignment="Center" Margin="0,0,5,0" Width="120"/>
                <TextBox Width="80" Text="{Binding DoorUValue, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.00}"/>
            </StackPanel>

            <!-- Диагностични резултати -->
            <TextBlock Text="Резултати (диагностични)" FontWeight="SemiBold" Margin="0,15,0,4" Background="#FFEBEE" Padding="4"/>
            <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding ResultUfSus, StringFormat='Uf_sus: {0:F4} W/m²K'}" Margin="0,2"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ResultUfGb, StringFormat='Uf_gb: {0:F4} W/m²K'}" Margin="0,2"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding ResultUwGb, StringFormat='Uw_gb: {0:F4} W/m²K'}" Margin="0,2"/>
                
                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding ResultUw, StringFormat='Uw: {0:F4} W/m²K'}" Margin="0,2"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ResultHveB, StringFormat='Hve_b: {0:F2} W/K'}" Margin="0,2"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ResultB, StringFormat='B: {0:F3} m'}" Margin="0,2"/>
                
                <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding ResultDf, StringFormat='df: {0:F3} m'}" Margin="0,2"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ResultDwb, StringFormat='d_wb: {0:F3} m'}" Margin="0,2"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding ResultS, StringFormat='S: {0:F2} W/K'}" Margin="0,2"/>
                
                <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Text="{Binding ResultUub, StringFormat='★ Uub: {0:F4} W/m²K'}" FontWeight="Bold" FontSize="14" Foreground="#D32F2F" Margin="0,8,0,2"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
