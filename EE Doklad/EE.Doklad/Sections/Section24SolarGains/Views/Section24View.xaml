<UserControl x:Class="EE.Doklad.Sections.Section24SolarGains.Views.Section24View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:EE.Doklad.Sections.Section24SolarGains.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1300">

    <UserControl.Resources>
        <!-- СТИЛОВЕ -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="18"/>
            <Setter Property="FontWeight"   Value="Bold"/>
            <Setter Property="Margin"       Value="0,0,0,16"/>
            <Setter Property="Foreground"   Value="#1A237E"/>
        </Style>

        <Style x:Key="SubTitle" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Margin"       Value="0,12,0,6"/>
            <Setter Property="Foreground"   Value="#37474F"/>
        </Style>

        <Style x:Key="HeaderDG" TargetType="DataGridColumnHeader">
            <Setter Property="Background"   Value="#1565C0"/>
            <Setter Property="Foreground"   Value="White"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="Padding"      Value="6,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CellStyle" TargetType="DataGridCell">
            <Setter Property="TextBlock.TextAlignment" Value="Right"/>
            <Setter Property="Padding"      Value="4,3"/>
        </Style>

        <Style x:Key="DataGridBase" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns"         Value="False"/>
            <Setter Property="CanUserAddRows"              Value="False"/>
            <Setter Property="CanUserDeleteRows"           Value="False"/>
            <Setter Property="HeadersVisibility"           Value="Column"/>
            <Setter Property="GridLinesVisibility"         Value="All"/>
            <Setter Property="HorizontalGridLinesBrush"    Value="#E0E0E0"/>
            <Setter Property="VerticalGridLinesBrush"      Value="#E0E0E0"/>
            <Setter Property="RowBackground"               Value="White"/>
            <Setter Property="AlternatingRowBackground"    Value="#F5F8FF"/>
            <Setter Property="BorderBrush"                 Value="#BDBDBD"/>
            <Setter Property="BorderThickness"             Value="1"/>
            <Setter Property="FontSize"                    Value="11"/>
            <Setter Property="Margin"                      Value="0,0,0,10"/>
            <Setter Property="ColumnHeaderStyle"           Value="{StaticResource HeaderDG}"/>
            <Setter Property="CellStyle"                   Value="{StaticResource CellStyle}"/>
            <Setter Property="SelectionMode"               Value="Single"/>
        </Style>

        <Style x:Key="ButtonPrimary" TargetType="Button">
            <Setter Property="Background"   Value="#1565C0"/>
            <Setter Property="Foreground"   Value="White"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Padding"      Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Margin"       Value="0,0,8,0"/>
        </Style>

        <Style x:Key="ButtonDanger" TargetType="Button" BasedOn="{StaticResource ButtonPrimary}">
            <Setter Property="Background"   Value="#C62828"/>
            <Setter Property="Padding"      Value="8,4"/>
            <Setter Property="FontSize"     Value="11"/>
        </Style>

        <Style x:Key="ButtonAdd" TargetType="Button" BasedOn="{StaticResource ButtonPrimary}">
            <Setter Property="Background"   Value="#2E7D32"/>
        </Style>

        <Style x:Key="ExpanderHeader" TargetType="Expander">
            <Setter Property="Margin"       Value="0,4,0,2"/>
            <Setter Property="Background"   Value="#E8EAF6"/>
            <Setter Property="BorderBrush"  Value="#9FA8DA"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="KpiCard" TargetType="Border">
            <Setter Property="Background"       Value="#E3F2FD"/>
            <Setter Property="BorderBrush"      Value="#90CAF9"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="CornerRadius"     Value="6"/>
            <Setter Property="Padding"          Value="16,10"/>
            <Setter Property="Margin"           Value="0,0,12,0"/>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20">

            <!-- ЗАГЛАВИЕ -->
            <TextBlock Text="24. Топлинни печалби от слънчево греене"
                       Style="{StaticResource SectionTitle}"/>

            <TextBlock Margin="0,0,0,14"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="#888"
                       Text="Данните се синхронизират и изчисляват автоматично."/>

            <!-- ВАЛИДАЦИЯ -->
            <Border Background="#FFF3E0" BorderBrush="#FF9800" BorderThickness="1"
                    CornerRadius="4" Padding="12,8" Margin="0,0,0,12"
                    Visibility="{Binding HasErrors, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="⚠  Грешки при валидация:" FontWeight="Bold"
                               Foreground="#E65100" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding ValidationSummary}"
                               TextWrapping="Wrap" Foreground="#BF360C" FontSize="11"/>
                </StackPanel>
            </Border>

            <Border Background="#E8F5E9" BorderBrush="#A5D6A7" BorderThickness="1"
                    CornerRadius="4" Padding="12,8" Margin="0,0,0,12"
                    Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="ℹ  Предупреждения:" FontWeight="Bold"
                               Foreground="#1B5E20" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding ValidationSummary}"
                               TextWrapping="Wrap" Foreground="#2E7D32" FontSize="11"/>
                </StackPanel>
            </Border>

            <!-- TAB CONTROL -->
            <TabControl FontSize="12" Margin="0,0,0,20">

                <!-- ===================================================
                     ТАБ 1: ВХОДНИ ДАННИ
                     =================================================== -->
                <TabItem Header="  Входни данни  ">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12,16">

                            <!-- Прозорци -->
                            <TextBlock Text="Прозрачни елементи (прозорци)"
                                       Style="{StaticResource SubTitle}"/>

                            <DataGrid ItemsSource="{Binding Windows}"
                                      Style="{StaticResource DataGridBase}"
                                      IsReadOnly="True"
                                      MaxHeight="300">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Id"      Width="70"
                                        Binding="{Binding Id}"/>
                                    <DataGridTextColumn Header="A_wi [m²]"  Width="85"
                                        Binding="{Binding A_wi, StringFormat='F3'}"/>
                                    <DataGridTextColumn Header="F_fr [-]"   Width="80"
                                        Binding="{Binding F_fr, StringFormat='F3'}"/>
                                    <DataGridTextColumn Header="U_c [W/(m²K)]" Width="105"
                                        Binding="{Binding U_c, StringFormat='F3'}"/>
                                    <DataGridTextColumn Header="R_se [m²K/W]"  Width="105"
                                        Binding="{Binding R_se, StringFormat='F4'}"/>
                                    <DataGridTextColumn Header="F_sky [-]"  Width="80"
                                        Binding="{Binding F_sky, StringFormat='F2'}"/>
                                    <DataGridTextColumn Header="ε [-]"      Width="65"
                                        Binding="{Binding Epsilon, StringFormat='F2'}"/>
                                    <DataGridTextColumn Header="θ_ss [°C]"  Width="80"
                                        Binding="{Binding ThetaSs, StringFormat='F1'}"/>
                                    
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Text="Забележка: H_sol[12], F_sh_obst[12] и g_gl[12] се задават от кода или от бъдещ диалог."
                                       Foreground="#888" FontSize="10" FontStyle="Italic" Margin="0,0,0,12"/>

                            <!-- Непрозрачни -->
                            <TextBlock Text="Непрозрачни елементи"
                                       Style="{StaticResource SubTitle}"/>

                            <DataGrid ItemsSource="{Binding OpaqueElements}"
                                      Style="{StaticResource DataGridBase}"
                                      IsReadOnly="True"
                                      MaxHeight="300">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Id"         Width="70"
                                        Binding="{Binding Id}"/>
                                    <DataGridTextColumn Header="A_c [m²]"   Width="85"
                                        Binding="{Binding A_c, StringFormat='F3'}"/>
                                    <DataGridTextColumn Header="α_sol [-]"  Width="80"
                                        Binding="{Binding Alpha_sol, StringFormat='F2'}"/>
                                    <DataGridTextColumn Header="U_c [W/(m²K)]" Width="105"
                                        Binding="{Binding U_c, StringFormat='F3'}"/>
                                    <DataGridTextColumn Header="R_se [m²K/W]"  Width="105"
                                        Binding="{Binding R_se, StringFormat='F4'}"/>
                                    <DataGridTextColumn Header="F_sky [-]"  Width="80"
                                        Binding="{Binding F_sky, StringFormat='F2'}"/>
                                    <DataGridTextColumn Header="ε [-]"      Width="65"
                                        Binding="{Binding Epsilon, StringFormat='F2'}"/>
                                    <DataGridTextColumn Header="θ_ss [°C]"  Width="80"
                                        Binding="{Binding ThetaSs, StringFormat='F1'}"/>
                                    
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Общи месечни данни -->
                            <TextBlock Text="Общи месечни параметри (Δt_m, Δθ_sky_m)"
                                       Style="{StaticResource SubTitle}"/>

                            <DataGrid ItemsSource="{Binding MonthlyData}"
                                      Style="{StaticResource DataGridBase}"
                                      IsReadOnly="True"
                                      MaxHeight="320">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Месец"          Width="65"
                                        Binding="{Binding MonthName}"
                                        IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Δt_m [h]"       Width="90"
                                        Binding="{Binding DeltaT_m, StringFormat='F0'}"/>
                                    <DataGridTextColumn Header="D_h"            Width="45"
                                        Binding="{Binding HeatingDays}"
                                        SortMemberPath="HeatingDays"/>
                                    <DataGridTextColumn Header="D_c"            Width="45"
                                        Binding="{Binding CoolingDays}"
                                        SortMemberPath="CoolingDays"/>
                                    <DataGridTextColumn Header="Δθ_sky_m [K]"   Width="110"
                                        Binding="{Binding DeltaTheta_sky_m, StringFormat='F1'}"/>
                                </DataGrid.Columns>
                            </DataGrid>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===================================================
                     ТАБ 2: МЕЖДИННИ ИЗЧИСЛЕНИЯ
                     =================================================== -->
                <TabItem Header="  Междинни изчисления  ">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12,16">

                            <!-- Без резултати -->
                            <TextBlock Text="Резултатите се обновяват автоматично след промяна на данните."
                                       FontStyle="Italic" Foreground="#999"
                                       Visibility="{Binding IsCalculated,
                                            Converter={StaticResource BoolToVis},
                                            ConverterParameter=Inverse}"/>

                            <!-- Прозорци: Expanders -->
                            <TextBlock Text="Прозрачни елементи" Style="{StaticResource SubTitle}"
                                       Visibility="{Binding IsCalculated, Converter={StaticResource BoolToVis}}"/>

                            <ItemsControl ItemsSource="{Binding WindowGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Expander Style="{StaticResource ExpanderHeader}"
                                                  IsExpanded="True">
                                            <Expander.Header>
                                                <TextBlock Text="{Binding Header}"
                                                           FontWeight="SemiBold"
                                                           Foreground="#283593"/>
                                            </Expander.Header>
                                            <StackPanel Margin="0,8,0,8">
                                                <DataGrid ItemsSource="{Binding Rows}"
                                                          Style="{StaticResource DataGridBase}"
                                                          IsReadOnly="True"
                                                          MaxHeight="280">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Месец"       Width="55"
                                                            Binding="{Binding Month}"/>
                                                        <DataGridTextColumn Header="A_gl [m²]"   Width="85"
                                                            Binding="{Binding A_gl, StringFormat='F4'}"/>
                                                        <DataGridTextColumn Header="g_gl [-]"    Width="75"
                                                            Binding="{Binding G_gl, StringFormat='F4'}"/>
                                                        <DataGridTextColumn Header="F_sh [-]"    Width="75"
                                                            Binding="{Binding F_sh_obst, StringFormat='F4'}"/>
                                                        <DataGridTextColumn Header="H_sol [kWh/m²]" Width="105"
                                                            Binding="{Binding H_sol, StringFormat='F3'}"/>
                                                        <DataGridTextColumn Header="SolarFactor [kWh]" Width="130"
                                                            Binding="{Binding SolarFactor, StringFormat='F3'}">
                                                            <DataGridTextColumn.HeaderStyle>
                                                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource HeaderDG}">
                                                                    <Setter Property="Background" Value="#1A6B2A"/>
                                                                </Style>
                                                            </DataGridTextColumn.HeaderStyle>
                                                        </DataGridTextColumn>
                                                        <DataGridTextColumn Header="h_lr [W/(m²K)]" Width="105"
                                                            Binding="{Binding H_lr, StringFormat='F4'}"/>
                                                        <DataGridTextColumn Header="Q_sky [kWh]" Width="95"
                                                            Binding="{Binding Q_sky, StringFormat='F4'}"/>
                                                        <DataGridTextColumn Header="Q_sol_wi [kWh]" Width="115"
                                                            Binding="{Binding Q_sol_window, StringFormat='F3'}">
                                                            <DataGridTextColumn.HeaderStyle>
                                                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource HeaderDG}">
                                                                    <Setter Property="Background" Value="#B71C1C"/>
                                                                </Style>
                                                            </DataGridTextColumn.HeaderStyle>
                                                        </DataGridTextColumn>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </StackPanel>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Непрозрачни: Expanders -->
                            <TextBlock Text="Непрозрачни елементи" Style="{StaticResource SubTitle}"
                                       Margin="0,16,0,6"
                                       Visibility="{Binding IsCalculated, Converter={StaticResource BoolToVis}}"/>

                            <ItemsControl ItemsSource="{Binding OpaqueGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Expander Style="{StaticResource ExpanderHeader}"
                                                  IsExpanded="True">
                                            <Expander.Header>
                                                <TextBlock Text="{Binding Header}"
                                                           FontWeight="SemiBold"
                                                           Foreground="#283593"/>
                                            </Expander.Header>
                                            <StackPanel Margin="0,8,0,8">
                                                <DataGrid ItemsSource="{Binding Rows}"
                                                          Style="{StaticResource DataGridBase}"
                                                          IsReadOnly="True"
                                                          MaxHeight="280">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Месец"          Width="55"
                                                            Binding="{Binding Month}"/>
                                                        <DataGridTextColumn Header="α_sol [-]"      Width="75"
                                                            Binding="{Binding Alpha_sol, StringFormat='F2'}"/>
                                                        <DataGridTextColumn Header="R_se [m²K/W]"   Width="100"
                                                            Binding="{Binding R_se, StringFormat='F4'}"/>
                                                        <DataGridTextColumn Header="U_c [W/(m²K)]"  Width="105"
                                                            Binding="{Binding U_c, StringFormat='F3'}"/>
                                                        <DataGridTextColumn Header="A_c [m²]"       Width="80"
                                                            Binding="{Binding A_c, StringFormat='F3'}"/>
                                                        <DataGridTextColumn Header="F_sh [-]"       Width="75"
                                                            Binding="{Binding F_sh_obst, StringFormat='F4'}"/>
                                                        <DataGridTextColumn Header="H_sol [kWh/m²]" Width="105"
                                                            Binding="{Binding H_sol, StringFormat='F3'}"/>
                                                        <DataGridTextColumn Header="SolarFactorOp [kWh]" Width="140"
                                                            Binding="{Binding SolarFactorOpaque, StringFormat='F4'}">
                                                            <DataGridTextColumn.HeaderStyle>
                                                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource HeaderDG}">
                                                                    <Setter Property="Background" Value="#1A6B2A"/>
                                                                </Style>
                                                            </DataGridTextColumn.HeaderStyle>
                                                        </DataGridTextColumn>
                                                        <DataGridTextColumn Header="h_lr [W/(m²K)]" Width="105"
                                                            Binding="{Binding H_lr, StringFormat='F4'}"/>
                                                        <DataGridTextColumn Header="Q_sky [kWh]"    Width="95"
                                                            Binding="{Binding Q_sky, StringFormat='F4'}"/>
                                                        <DataGridTextColumn Header="Q_sol_op [kWh]" Width="110"
                                                            Binding="{Binding Q_sol_opaque, StringFormat='F3'}">
                                                            <DataGridTextColumn.HeaderStyle>
                                                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource HeaderDG}">
                                                                    <Setter Property="Background" Value="#B71C1C"/>
                                                                </Style>
                                                            </DataGridTextColumn.HeaderStyle>
                                                        </DataGridTextColumn>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </StackPanel>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===================================================
                     ТАБ 3: ОБЩИ РЕЗУЛТАТИ
                     =================================================== -->
                <TabItem Header="  Общи резултати  ">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12,16">

                            <!-- Без резултати -->
                            <TextBlock Text="Резултатите се обновяват автоматично след промяна на данните."
                                       FontStyle="Italic" Foreground="#999"
                                       Visibility="{Binding IsCalculated,
                                            Converter={StaticResource BoolToVis},
                                            ConverterParameter=Inverse}"/>

                            <!-- KPI карти -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20"
                                        Visibility="{Binding IsCalculated, Converter={StaticResource BoolToVis}}">
                                <Border Style="{StaticResource KpiCard}">
                                    <StackPanel>
                                        <TextBlock Text="Общо годишно" Foreground="#555" FontSize="11"/>
                                        <TextBlock FontSize="20" FontWeight="Bold" Foreground="#0D47A1"
                                                   Text="{Binding AnnualQ_sol_total, StringFormat='{}{0:F1} kWh'}"/>
                                        <TextBlock Text="Q_sol_total" Foreground="#888" FontSize="10"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource KpiCard}">
                                    <StackPanel>
                                        <TextBlock Text="Отопление год." Foreground="#555" FontSize="11"/>
                                        <TextBlock FontSize="18" FontWeight="Bold" Foreground="#D84315"
                                                   Text="{Binding AnnualQ_sol_heating, StringFormat='{}{0:F1} kWh'}"/>
                                        <TextBlock Text="Q_sol_heat" Foreground="#888" FontSize="10"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource KpiCard}">
                                    <StackPanel>
                                        <TextBlock Text="Охлаждане год." Foreground="#555" FontSize="11"/>
                                        <TextBlock FontSize="18" FontWeight="Bold" Foreground="#00838F"
                                                   Text="{Binding AnnualQ_sol_cooling, StringFormat='{}{0:F1} kWh'}"/>
                                        <TextBlock Text="Q_sol_cool" Foreground="#888" FontSize="10"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource KpiCard}">
                                    <StackPanel>
                                        <TextBlock Text="Прозорци год." Foreground="#555" FontSize="11"/>
                                        <TextBlock FontSize="18" FontWeight="Bold" Foreground="#1565C0"
                                                   Text="{Binding AnnualQ_sol_windows, StringFormat='{}{0:F1} kWh'}"/>
                                        <TextBlock Text="Σ Q_sol_window" Foreground="#888" FontSize="10"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource KpiCard}">
                                    <StackPanel>
                                        <TextBlock Text="Непрозрачни год." Foreground="#555" FontSize="11"/>
                                        <TextBlock FontSize="18" FontWeight="Bold" Foreground="#1565C0"
                                                   Text="{Binding AnnualQ_sol_opaque, StringFormat='{}{0:F1} kWh'}"/>
                                        <TextBlock Text="Σ Q_sol_opaque" Foreground="#888" FontSize="10"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource KpiCard}">
                                    <StackPanel>
                                        <TextBlock Text="Топл. лъчение год." Foreground="#555" FontSize="11"/>
                                        <TextBlock FontSize="18" FontWeight="Bold" Foreground="#6A1B9A"
                                                   Text="{Binding AnnualQ_sky, StringFormat='{}{0:F1} kWh'}"/>
                                        <TextBlock Text="Σ Q_sky" Foreground="#888" FontSize="10"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Месечна таблица -->
                            <TextBlock Text="Месечни обобщени резултати (3.36)"
                                       Style="{StaticResource SubTitle}"
                                       Visibility="{Binding IsCalculated, Converter={StaticResource BoolToVis}}"/>

                            <DataGrid ItemsSource="{Binding TotalRows}"
                                      Style="{StaticResource DataGridBase}"
                                      IsReadOnly="True"
                                      Visibility="{Binding IsCalculated, Converter={StaticResource BoolToVis}}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Месец"          Width="65"
                                        Binding="{Binding Month}"/>
                                    <DataGridTextColumn Header="Σ Q_sol_wind [kWh]" Width="150"
                                        Binding="{Binding SumWindows, StringFormat='F3'}">
                                        <DataGridTextColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource HeaderDG}">
                                                <Setter Property="Background" Value="#1565C0"/>
                                            </Style>
                                        </DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Σ Q_sol_op [kWh]"  Width="140"
                                        Binding="{Binding SumOpaque, StringFormat='F3'}">
                                        <DataGridTextColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource HeaderDG}">
                                                <Setter Property="Background" Value="#1565C0"/>
                                            </Style>
                                        </DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Σ Q_sky [kWh]"     Width="120"
                                        Binding="{Binding SumQsky, StringFormat='F3'}">
                                        <DataGridTextColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource HeaderDG}">
                                                <Setter Property="Background" Value="#6A1B9A"/>
                                            </Style>
                                        </DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Q_sol_total [kWh]" Width="140"
                                        Binding="{Binding Q_sol_total, StringFormat='F3'}">
                                        <DataGridTextColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource HeaderDG}">
                                                <Setter Property="Background" Value="#B71C1C"/>
                                            </Style>
                                        </DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Q_sol_heat [kWh]" Width="140"
                                        Binding="{Binding Q_sol_heating, StringFormat='F3'}">
                                        <DataGridTextColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource HeaderDG}">
                                                <Setter Property="Background" Value="#D84315"/>
                                            </Style>
                                        </DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Q_sol_cool [kWh]" Width="140"
                                        Binding="{Binding Q_sol_cooling, StringFormat='F3'}">
                                        <DataGridTextColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource HeaderDG}">
                                                <Setter Property="Background" Value="#00838F"/>
                                            </Style>
                                        </DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Годишни суми -->
                            <Border Background="#FAFAFA" BorderBrush="#BDBDBD" BorderThickness="1"
                                    CornerRadius="4" Padding="14,10" Margin="0,8,0,0"
                                    Visibility="{Binding IsCalculated, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="Годишна Σ Q_sol_window:" Margin="0,3"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2"
                                               Text="{Binding AnnualQ_sol_windows, StringFormat='{}{0:F1} kWh'}"
                                               FontWeight="SemiBold" HorizontalAlignment="Right" Margin="20,3,0,3"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                               Text="Годишна Σ Q_sol_opaque:" Margin="0,3"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2"
                                               Text="{Binding AnnualQ_sol_opaque, StringFormat='{}{0:F1} kWh'}"
                                               FontWeight="SemiBold" HorizontalAlignment="Right" Margin="20,3,0,3"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0"
                                               Text="Годишна Σ Q_sky:" Margin="0,3"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2"
                                               Text="{Binding AnnualQ_sky, StringFormat='{}{0:F1} kWh'}"
                                               FontWeight="SemiBold" HorizontalAlignment="Right" Margin="20,3,0,3"
                                               Foreground="#6A1B9A"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0"
                                               Text="Годишна Q_sol_heat:" Margin="0,3"/>
                                    <TextBlock Grid.Row="3" Grid.Column="2"
                                               Text="{Binding AnnualQ_sol_heating, StringFormat='{}{0:F1} kWh'}"
                                               FontWeight="SemiBold" HorizontalAlignment="Right" Margin="20,3,0,3"
                                               Foreground="#D84315"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0"
                                               Text="Годишна Q_sol_cool:" Margin="0,3"/>
                                    <TextBlock Grid.Row="4" Grid.Column="2"
                                               Text="{Binding AnnualQ_sol_cooling, StringFormat='{}{0:F1} kWh'}"
                                               FontWeight="SemiBold" HorizontalAlignment="Right" Margin="20,3,0,3"
                                               Foreground="#00838F"/>

                                    <Separator Grid.Row="6" Grid.ColumnSpan="3" Margin="0,4"/>

                                    <TextBlock Grid.Row="7" Grid.Column="0"
                                               Text="ГОДИШНА Q_sol_total [kWh] (3.36):"
                                               FontWeight="Bold" FontSize="13"/>
                                    <TextBlock Grid.Row="7" Grid.Column="2"
                                               Text="{Binding AnnualQ_sol_total, StringFormat='{}{0:F1} kWh'}"
                                               FontWeight="Bold" FontSize="15" Foreground="#B71C1C"
                                               HorizontalAlignment="Right" Margin="20,0,0,0"/>
                                </Grid>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

            </TabControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>




