<UserControl x:Class="EE.Doklad.Views.HotWaterSectionEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:EE.Doklad.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.Resources>
        <converters:FlexibleDoubleConverter x:Key="FlexibleDoubleConverter"/>
        
        <!-- Style за editable редове -->
        <Style x:Key="EditableTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#2196F3"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        
        <!-- Style за read-only редове -->
        <Style x:Key="ReadOnlyTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource EditableTextBoxStyle}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <!-- Заглавие -->
            <TextBlock Text="14. Топла вода за битови нужди (БГВ)"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,0,15"/>

            <!-- Статичен текст -->
            <TextBlock Text="Попълнете данните за секция: 14. Топла вода за битови нужди (БГВ)"
                       FontSize="12"
                       FontStyle="Italic"
                       Foreground="DimGray"
                       Margin="0,0,0,20"/>

            <!-- Таблица с параметри -->
            <Border BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Header -->
                        <RowDefinition Height="Auto"/>
                        <!-- Data rows -->
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="350"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>

                    <!-- Header Row -->
                    <Border Grid.Row="0" Grid.Column="0" Background="#2196F3" BorderBrush="White" BorderThickness="0,0,1,1">
                        <TextBlock Text="Параметър" FontWeight="Bold" Foreground="White" Padding="10" FontSize="13"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Background="#2196F3" BorderBrush="White" BorderThickness="0,0,1,1">
                        <TextBlock Text="Стойност" FontWeight="Bold" Foreground="White" Padding="10" FontSize="13" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="2" Background="#2196F3" BorderBrush="White" BorderThickness="0,0,0,1">
                        <TextBlock Text="Единица" FontWeight="Bold" Foreground="White" Padding="10" FontSize="13" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Row 1: Разход на вода (editable) -->
                    <Border Grid.Row="1" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Разход на вода (смесена) на човек" Padding="10" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBox Text="{Binding WaterConsumptionPerPerson, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}" 
                                 Style="{StaticResource EditableTextBoxStyle}"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="2" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <TextBlock Text="l/d човек" Padding="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Row 2: Брой хора (read-only) -->
                    <Border Grid.Row="2" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1" Background="#FAFAFA">
                        <TextBlock Text="Брой хора" Padding="10" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1" Background="#FAFAFA">
                        <TextBox Text="{Binding NumberOfPeople, Mode=OneWay}" 
                                 Style="{StaticResource ReadOnlyTextBoxStyle}"/>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="2" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Background="#FAFAFA">
                        <TextBlock Text="–" Padding="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Row 3: Отопляема площ (read-only) -->
                    <Border Grid.Row="3" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1" Background="#FAFAFA">
                        <TextBlock Text="Отопляема площ" Padding="10" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Row="3" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1" Background="#FAFAFA">
                        <TextBox Text="{Binding HeatedArea_m2, Mode=OneWay, StringFormat=0.00}" 
                                 Style="{StaticResource ReadOnlyTextBoxStyle}"/>
                    </Border>
                    <Border Grid.Row="3" Grid.Column="2" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Background="#FAFAFA">
                        <TextBlock Text="m²" Padding="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Row 4: Брой дни (read-only) -->
                    <Border Grid.Row="4" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1" Background="#FAFAFA">
                        <TextBlock Text="Брой дни" Padding="10" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Row="4" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1" Background="#FAFAFA">
                        <TextBox Text="{Binding WorkingDaysPerYear, Mode=OneWay, StringFormat=0}" 
                                 Style="{StaticResource ReadOnlyTextBoxStyle}"/>
                    </Border>
                    <Border Grid.Row="4" Grid.Column="2" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Background="#FAFAFA">
                        <TextBlock Text="d/y" Padding="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Row 5: Обща консумация (computed) -->
                    <Border Grid.Row="5" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1" Background="#FFF9C4">
                        <TextBlock Text="Обща консумация" Padding="10" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </Border>
                    <Border Grid.Row="5" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1" Background="#FFF9C4">
                        <TextBox Text="{Binding TotalConsumption_l_per_m2a, Mode=OneWay, StringFormat=0.00}" 
                                 Style="{StaticResource ReadOnlyTextBoxStyle}" 
                                 Background="#FFF9C4" 
                                 FontWeight="SemiBold"/>
                    </Border>
                    <Border Grid.Row="5" Grid.Column="2" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Background="#FFF9C4">
                        <TextBlock Text="l/m²a" Padding="10" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                    </Border>

                    <!-- Row 6: Температурна разлика (editable) -->
                    <Border Grid.Row="6" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Температурна разлика" Padding="10" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Row="6" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBox Text="{Binding TemperatureDifference, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}" 
                                 Style="{StaticResource EditableTextBoxStyle}"/>
                    </Border>
                    <Border Grid.Row="6" Grid.Column="2" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <TextBlock Text="°C" Padding="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Row 7: Ефективност на разпределителната мрежа (editable) -->
                    <Border Grid.Row="7" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Ефективност на разпределителната мрежа" Padding="10" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Row="7" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBox Text="{Binding DistributionNetworkEfficiency, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}" 
                                 Style="{StaticResource EditableTextBoxStyle}"/>
                    </Border>
                    <Border Grid.Row="7" Grid.Column="2" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <TextBlock Text="%" Padding="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Row 8: Автоматизирано управление (editable) -->
                    <Border Grid.Row="8" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Автоматизирано управление" Padding="10" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Row="8" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBox Text="{Binding AutomatedControl, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}" 
                                 Style="{StaticResource EditableTextBoxStyle}"/>
                    </Border>
                    <Border Grid.Row="8" Grid.Column="2" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <TextBlock Text="%" Padding="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Row 9: Енергиен мениджмънт (editable) -->
                    <Border Grid.Row="9" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Енергиен мениджмънт" Padding="10" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Row="9" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBox Text="{Binding EnergyManagement, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}" 
                                 Style="{StaticResource EditableTextBoxStyle}"/>
                    </Border>
                    <Border Grid.Row="9" Grid.Column="2" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <TextBlock Text="%" Padding="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Row 10: КПД на топлоснабдяване (editable) -->
                    <Border Grid.Row="10" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="КПД на топлоснабдяване" Padding="10" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Row="10" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBox Text="{Binding HeatSupplyEfficiency, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}" 
                                 Style="{StaticResource EditableTextBoxStyle}"/>
                    </Border>
                    <Border Grid.Row="10" Grid.Column="2" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <TextBlock Text="%" Padding="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Row 11: Енергия (computed) -->
                    <Border Grid.Row="11" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0" Background="#C8E6C9">
                        <TextBlock Text="Енергия" Padding="10" VerticalAlignment="Center" FontWeight="Bold"/>
                    </Border>
                    <Border Grid.Row="11" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0" Background="#C8E6C9">
                        <TextBox Text="{Binding Energy_kWh_per_y, Mode=OneWay, StringFormat=0.00}" 
                                 Style="{StaticResource ReadOnlyTextBoxStyle}" 
                                 Background="#C8E6C9" 
                                 FontWeight="Bold"/>
                    </Border>
                    <Border Grid.Row="11" Grid.Column="2" BorderBrush="#E0E0E0" BorderThickness="0,0,0,0" Background="#C8E6C9">
                        <TextBlock Text="kWh/y" Padding="10" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Информационна бележка -->
            <Border Background="#E3F2FD" BorderBrush="#2196F3" BorderThickness="1" Padding="15" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="ℹ Забележки:" FontWeight="Bold" Foreground="#1976D2" Margin="0,0,0,10"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#0D47A1" FontSize="11">
                        <Run Text="• Брой хора и отопляема площ се взимат автоматично от секция 5 (Данни за обекта)."/>
                        <LineBreak/>
                        <Run Text="• Брой дни се изчислява автоматично по формулата: (365 / 7) × 7 - почивни дни."/>
                        <LineBreak/>
                        <Run Text="• За БГВ винаги се използват 7 дни в седмицата (денонощна консумация)."/>
                        <LineBreak/>
                        <Run Text="• Обща консумация и Енергия се изчисляват автоматично според зададените формули."/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
