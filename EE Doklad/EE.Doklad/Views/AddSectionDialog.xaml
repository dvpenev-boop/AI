<Window x:Class="EE.Doklad.Views.AddSectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавяне на нова секция"
        Height="500"
        Width="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заглавие -->
        <TextBlock Grid.Row="0" 
                   Text="Създаване на нова секция"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,15"/>

        <!-- Номер на секцията -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Номер на секцията:" Margin="0,0,0,5"/>
            <TextBox x:Name="SectionNumberTextBox"
                     FontSize="14"
                     Padding="8"
                     IsReadOnly="True"
                     Background="#E0E0E0"/>
        </StackPanel>

        <!-- Име на секцията -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Име на секцията:" Margin="0,0,0,5"/>
            <TextBox x:Name="SectionNameTextBox"
                     FontSize="14"
                     Padding="8"
                     TextChanged="SectionNameTextBox_TextChanged"/>
        </StackPanel>

        <!-- Преглед -->
        <StackPanel Grid.Row="3" Margin="0,0,0,15">
            <TextBlock Text="Преглед:" Margin="0,0,0,5" FontWeight="SemiBold"/>
            <Border BorderBrush="#CCCCCC" 
                    BorderThickness="1" 
                    Background="White"
                    Padding="10"
                    CornerRadius="3">
                <TextBlock x:Name="PreviewTextBlock"
                           FontSize="14"
                           Foreground="#333333"
                           Text=""/>
            </Border>
        </StackPanel>

        <!-- Бутони -->
        <StackPanel Grid.Row="4" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right">
            <Button Content="OK" 
                    Width="100" 
                    Height="35"
                    Margin="0,0,10,0"
                    Click="OK_Click"
                    IsEnabled="False"
                    x:Name="OkButton"
                    Background="#4CAF50"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    FontWeight="SemiBold"/>
            <Button Content="Отказ" 
                    Width="100" 
                    Height="35"
                    Click="Cancel_Click"
                    Background="#757575"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
