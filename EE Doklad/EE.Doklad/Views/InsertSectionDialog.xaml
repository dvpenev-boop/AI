<Window x:Class="EE.Doklad.Views.InsertSectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вмъкване на нова секция"
        Width="450"
        Height="360"
        MinWidth="450"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5"
        SizeToContent="Manual">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заглавие -->
        <TextBlock Grid.Row="0"
                   Text="Вмъкване на нова секция"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,18"/>

        <!-- Номер на секцията -->
        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <TextBlock Text="Номер на секцията:" Margin="0,0,0,6"/>
            <TextBox x:Name="SectionNumberTextBox"
                     FontSize="14"
                     Padding="10,6"
                     TextChanged="SectionNumberTextBox_TextChanged"/>
        </StackPanel>

        <!-- Заглавие на секцията + бутони -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,18">
                <TextBlock Text="Заглавие на секция:" Margin="0,0,0,6"/>
                <TextBox x:Name="SectionNameTextBox"
                         FontSize="14"
                         Padding="10,6"
                         MinHeight="44"
                         TextChanged="SectionNameTextBox_TextChanged"/>
            </StackPanel>

            <!-- spacer за да няма "залепване" -->
            <Border Grid.Row="1" Height="10" Background="Transparent"/>

            <!-- Бутони -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="OkButton"
                        Content="OK"
                        Width="130"
                        Height="40"
                        Margin="0,0,12,0"
                        Click="OK_Click"
                        IsDefault="True"
                        IsEnabled="False"
                        Background="#4CAF50"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"/>
                <Button Content="Отказ"
                        Width="130"
                        Height="40"
                        Click="Cancel_Click"
                        IsCancel="True"
                        Background="#757575"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
