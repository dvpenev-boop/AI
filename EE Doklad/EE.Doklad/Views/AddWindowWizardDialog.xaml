<Window x:Class="EE.Doklad.Views.AddWindowWizardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Добавяне на прозорец/врата" Height="600" Width="900"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock x:Name="StepIndicatorTextBlock" Text="Стъпка 1 от 6" FontSize="14" Foreground="Gray"/>
            <TextBlock Text="Wizard за добавяне на прозорец/врата" FontSize="18" FontWeight="Bold"/>
        </StackPanel>

        <!-- Content Area (Steps) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <!-- Step 1: Основни данни -->
                <StackPanel x:Name="Step1Panel" Visibility="Visible">
                    <TextBlock Text="Стъпка 1: Основни данни" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                    
                    <TextBlock Text="Вид:" Margin="0,0,0,5"/>
                    <ComboBox x:Name="KindComboBox" Margin="0,0,0,15"/>
                    
                    <TextBlock Text="Фасада (ориентация):" Margin="0,0,0,5"/>
                    <ComboBox x:Name="OrientationComboBox" Margin="0,0,0,15"/>
                    
                    <TextBlock Text="Брой:" Margin="0,0,0,5"/>
                    <TextBox x:Name="CountTextBox" Width="100" HorizontalAlignment="Left" Margin="0,0,0,15"/>
                    
                    <Border Background="#FFF9C4" Padding="10" CornerRadius="4" Margin="0,10,0,0">
                        <TextBlock TextWrapping="Wrap">
                            ℹ Брой: Въведете колко еднакви прозорци/врати искате да добавите. 
                            Например, ако имате 5 прозореца с идентични характеристики, въведете 5.
                        </TextBlock>
                    </Border>
                </StackPanel>

                <!-- Step 2: Геометрия -->
                <StackPanel x:Name="Step2Panel" Visibility="Collapsed">
                    <TextBlock Text="Стъпка 2: Геометрия" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                    
                    <!-- Пряко въвеждане на размери (само ширина×височина) -->
                    
                    <StackPanel Orientation="Horizontal" Margin="20,0,0,15">
                        <TextBlock Text="Ширина (см):" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="WidthTextBox" Width="100"/>
                        <TextBlock Text="Височина (см):" VerticalAlignment="Center" Margin="20,0,10,0"/>
                        <TextBox x:Name="HeightTextBox" Width="100"/>
                    </StackPanel>
                    
                    <TextBlock x:Name="CalculatedAreaTextBlock" Text="Площ: —" Margin="20,0,0,15" Foreground="Blue" FontWeight="Bold"/>
                    
                    <!-- Премахнато: ръчно въвеждане на площ - винаги използвайте ширина и височина -->
                </StackPanel>

                <!-- Step 3: Топлотехнически/оптични данни -->
                <StackPanel x:Name="Step3Panel" Visibility="Collapsed">
                    <TextBlock Text="Стъпка 3: Топлотехнически и оптични данни" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                    
                    <RadioButton x:Name="CatalogRadio" Content="Избор от каталог" GroupName="DataInput" IsChecked="True" Margin="0,0,0,10"/>
                    <RadioButton x:Name="ManualRadio" Content="Ръчно въвеждане" GroupName="DataInput" Margin="0,0,0,15"/>
                    
                    <TextBlock Text="U-стойност (W/m²K):" Margin="0,0,0,5"/>
                    <TextBox x:Name="UValueTextBox" Width="150" HorizontalAlignment="Left" Margin="0,0,0,15"/>
                    
                    <TextBlock Text="g_n (перпендикуляр, 0-1):" Margin="0,0,0,5"/>
                    <TextBox x:Name="GNTextBox" Width="150" HorizontalAlignment="Left" Margin="0,0,0,15"/>
                    
                    <TextBlock Text="Оптичен тип:" Margin="0,0,0,5"/>
                    <ComboBox x:Name="OpticalTypeComboBox" Width="250" HorizontalAlignment="Left" Margin="0,0,0,15"/>
                    
                    <Border Background="#E3F2FD" Padding="10" CornerRadius="4">
                        <TextBlock TextWrapping="Wrap">
                            ℹ Clear (Прозрачно): 4 сезона / селективно прозрачно остъкляване<LineBreak/>
                            ℹ Diffusing (Дифузно): матирано или със слънцезащитно приспособление
                        </TextBlock>
                    </Border>
                </StackPanel>

                <!-- Step 4: Рамка -->
                <StackPanel x:Name="Step4Panel" Visibility="Collapsed">
                    <TextBlock Text="Стъпка 4: Рамка" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                    
                    <TextBlock Text="F_fr - Процент площ на рамката (%, типично 10-20%):" Margin="0,0,0,5"/>
                    <TextBox x:Name="FrameFractionTextBox" Width="100" HorizontalAlignment="Left" 
                             TextChanged="FrameFractionTextBox_TextChanged" Margin="0,0,0,10"/>
                    
                    <TextBlock x:Name="FrameAreaGlassTextBlock" Text="A_стъкло = —" FontSize="14" 
                               Foreground="Blue" Margin="0,0,0,15"/>
                    
                    <Border Background="#FFF9C4" Padding="10" CornerRadius="4">
                        <TextBlock TextWrapping="Wrap">
                            ℹ F_fr: Рамката намалява ефективната площ на стъклото.<LineBreak/>
                            Формула: A_стъкло = A_брутна × (1 - F_fr)
                        </TextBlock>
                    </Border>
                </StackPanel>

                <!-- Step 5: Слънцезащита -->
                <StackPanel x:Name="Step5Panel" Visibility="Collapsed">
                    <TextBlock Text="Стъпка 5: Слънцезащита" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="Режим:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="ShadingModeComboBox" Width="180" Margin="0,0,0,0">
                            <ComboBoxItem>Без щора</ComboBoxItem>
                            <ComboBoxItem>Вътрешна щора</ComboBoxItem>
                            <ComboBoxItem>Външна щора</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                    
                    <TextBlock Text="Вид слънцезащита:" Margin="0,0,0,5"/>
                    <ComboBox x:Name="ShadingCategoryComboBox" Width="300" HorizontalAlignment="Left" 
                              Margin="0,0,0,10" SelectionChanged="ShadingCategoryComboBox_SelectionChanged"/>
                    
                    <TextBlock Text="Избор на коефициент (Таблица 4):" Margin="0,0,0,5"/>
                    <DataGrid x:Name="ShadingOptionsDataGrid" Height="150" AutoGenerateColumns="False" 
                              CanUserAddRows="False" SelectionMode="Single" Margin="0,0,0,10"
                              SelectionChanged="ShadingOptionsDataGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Вид" Binding="{Binding CategoryName}" Width="*"/>
                            <DataGridTextColumn Header="α" Binding="{Binding AbsorptionAlpha, StringFormat=F2}" Width="60"/>
                            <DataGridTextColumn Header="τ" Binding="{Binding TransmittanceTau, StringFormat=F2}" Width="60"/>
                            <DataGridTextColumn Header="F_вътр" Binding="{Binding FShadeInt, StringFormat=F2}" Width="70"/>
                            <DataGridTextColumn Header="F_външ" Binding="{Binding FShadeExt, StringFormat=F2}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    
                    <TextBlock x:Name="ShadingPreviewTextBlock" Text="Избран коефициент: —" 
                               FontSize="14" FontWeight="Bold" Foreground="Green" Margin="0,0,0,10"/>
                    
                    <Border Background="#E3F2FD" Padding="10" CornerRadius="4">
                        <TextBlock TextWrapping="Wrap">
                            ℹ Коефициентът е множител към g_base: g_eff = g_base × ShadingReductionFactor<LineBreak/>
                            При отопление се приема ShadingReductionFactor = 1.00 (щорите са вдигнати).
                        </TextBlock>
                    </Border>
                </StackPanel>

                <!-- Step 6: Засенчване -->
                <StackPanel x:Name="Step6Panel" Visibility="Collapsed">
                    <TextBlock Text="Стъпка 6: Засенчване" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                    
                    <!-- Бутонен избор -->
                    <TextBlock Text="Режим на засенчване:" FontSize="13" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <RadioButton x:Name="NoShadingRadio" Content="Без засенчване" 
                                     GroupName="ShadingMode" IsChecked="True" Margin="0,0,20,0"
                                     Checked="NoShadingRadio_Checked"/>
                        <RadioButton x:Name="WithShadingRadio" Content="Засенчване..." 
                                     GroupName="ShadingMode"
                                     Checked="WithShadingRadio_Checked"/>
                    </StackPanel>

                    <!-- Info блок -->
                    <Border Background="#E3F2FD" BorderBrush="#2196F3" BorderThickness="1" 
                            CornerRadius="4" Padding="12" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" Foreground="#1976D2" Text="ℹ️ Засенчването влияе само на соларните печалби чрез коефициенти Fsh,dir (по месеци)."/>
                            <TextBlock Text="Не променя U-стойността или g₀." 
                                       TextWrapping="Wrap" Foreground="#1976D2" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Summary блок (показва се само ако има активно засенчване) -->
                    <Border x:Name="ShadingSummaryPanel" 
                                Background="#F5F5F5" 
                                BorderBrush="#BDBDBD" 
                                BorderThickness="1" 
                                CornerRadius="4" 
                                Padding="12"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Margin="0,0,0,8">
                                    <Run Text="✓ Активно засенчване"/>
                                </TextBlock>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,4">
                                        <Run Text="Fsh,dir (min):"/>
                                    </TextBlock>
                                    <TextBlock x:Name="FshMinText" Grid.Row="0" Grid.Column="1" 
                                               Text="—" FontWeight="SemiBold" Margin="0,0,0,4"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,4">
                                        <Run Text="Fsh,dir (avg):"/>
                                    </TextBlock>
                                    <TextBlock x:Name="FshAvgText" Grid.Row="1" Grid.Column="1" 
                                               Text="—" FontWeight="SemiBold" Margin="0,0,0,12"/>

                                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal">
                                        <Button Content="Редактирай засенчване..." 
                                                Click="EditShadingButton_Click"
                                                Padding="8,4"
                                                Margin="0,0,8,0"/>
                                        <Button Content="Изчисти" 
                                                Click="ClearShadingButton_Click"
                                                Padding="8,4"
                                                Background="#FFEBEE"
                                                BorderBrush="#E57373"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Navigation Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="BackButton" Content="&lt; Назад" Width="100" Margin="0,0,10,0" Click="BackButton_Click"/>
            <Button x:Name="NextButton" Content="Напред &gt;" Width="100" Margin="0,0,10,0" 
                    Background="#4CAF50" Foreground="White" Click="NextButton_Click"/>
            <Button x:Name="CancelButton" Content="Отказ" Width="100" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
