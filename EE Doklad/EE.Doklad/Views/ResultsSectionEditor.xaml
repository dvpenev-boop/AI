<UserControl x:Class="EE.Doklad.Views.ResultsSectionEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:EE.Doklad.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">
    <UserControl.Resources>
        <converters:BoolToVisibilityInverseConverter x:Key="InverseBoolToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <!-- Заглавие -->
            <TextBlock Text="{Binding Data.Title, FallbackValue='Резултати сграда'}"
                       FontSize="18" 
                       FontWeight="Bold" 
                       Margin="0,0,0,15"/>

            <!-- Описание -->
            <TextBlock Text="Описание:"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Margin="0,0,0,5"/>
            
            <TextBox Text="{Binding Data.Description, UpdateSourceTrigger=PropertyChanged}"
                     MinHeight="60"
                     Padding="10"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     FontSize="11"
                     Margin="0,0,0,20"
                     BorderBrush="#E0E0E0"
                     BorderThickness="1"/>

            <!-- Информация за отопляема площ -->
            <Border Background="#E3F2FD" BorderBrush="#2196F3" BorderThickness="1" 
                    Padding="12" Margin="0,0,0,15" CornerRadius="4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Отопляема площ:" FontWeight="SemiBold" FontSize="12" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding Data.HeatedArea, StringFormat=N2, FallbackValue='—'}" 
                              FontSize="12" FontWeight="Bold" Foreground="#1976D2"/>
                    <TextBlock Text=" m²" FontSize="12" Foreground="#1976D2"/>
                    <TextBlock Text=" (от секция 'Данни за обекта')" FontSize="11" 
                              Foreground="#666" Margin="10,0,0,0" FontStyle="Italic"/>
                </StackPanel>
            </Border>

            <!-- Таблица с резултати -->
            <Border BorderBrush="#666" BorderThickness="2" Margin="0,0,0,20">
                <StackPanel>
                    <!-- Header row -->
                    <Border BorderBrush="#888" BorderThickness="0,0,0,2">
                        <Grid Background="#2196F3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/> <!-- Име на ред -->
                                <ColumnDefinition Width="100"/> <!-- Спец. разход -->
                                <ColumnDefinition Width="100"/> <!-- Потребена енергия -->
                                <ColumnDefinition Width="180"/> <!-- Енергиен носител -->
                                <ColumnDefinition Width="90"/>  <!-- fp,nren -->
                                <ColumnDefinition Width="90"/>  <!-- fp,ren -->
                                <ColumnDefinition Width="90"/>  <!-- fp,tot -->
                                <ColumnDefinition Width="90"/>  <!-- EmCO2 -->
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Описание" 
                                       Padding="8" FontWeight="Bold" FontSize="11" 
                                       TextAlignment="Left" Foreground="White"/>
                            <TextBlock Grid.Column="1" Text="kWh/m²" 
                                       Padding="8" FontWeight="Bold" FontSize="11" 
                                       TextAlignment="Center" Foreground="White"/>
                            <TextBlock Grid.Column="2" Text="Потребена енергия (Q)&#x0a;[kWh]" 
                                       Padding="8" FontWeight="Bold" FontSize="11" 
                                       TextAlignment="Center" Foreground="White" TextWrapping="Wrap"/>
                            <TextBlock Grid.Column="3" Text="Енергиен носител" 
                                       Padding="8" FontWeight="Bold" FontSize="11" 
                                       TextAlignment="Center" Foreground="White"/>
                            <TextBlock Grid.Column="4" Text="fp,nren&#x0a;[kWh]" 
                                       Padding="8" FontWeight="Bold" FontSize="11" 
                                       TextAlignment="Center" Foreground="White" TextWrapping="Wrap"/>
                            <TextBlock Grid.Column="5" Text="fp,ren&#x0a;[kWh]" 
                                       Padding="8" FontWeight="Bold" FontSize="11" 
                                       TextAlignment="Center" Foreground="White" TextWrapping="Wrap"/>
                            <TextBlock Grid.Column="6" Text="fp,tot&#x0a;[kWh]" 
                                       Padding="8" FontWeight="Bold" FontSize="11" 
                                       TextAlignment="Center" Foreground="White" TextWrapping="Wrap"/>
                            <TextBlock Grid.Column="7" Text="EmCO2&#x0a;[tCO2]" 
                                       Padding="8" FontWeight="Bold" FontSize="11" 
                                       TextAlignment="Center" Foreground="White" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <!-- Data rows -->
                    <ItemsControl ItemsSource="{Binding Data.Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#CCC" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <!-- Изчислени редове (сиво background) -->
                                                    <DataTrigger Binding="{Binding IsCalculated}" Value="True">
                                                        <Setter Property="Background" Value="#F5F5F5"/>
                                                    </DataTrigger>
                                                    <!-- Бял background за редактируеми редове -->
                                                    <DataTrigger Binding="{Binding IsCalculated}" Value="False">
                                                        <Setter Property="Background" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Име на ред (read-only) -->
                                        <TextBlock Grid.Column="0" 
                                                   Text="{Binding RowName}"
                                                   Padding="8" FontSize="11" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>

                                        <!-- kWh/m² (автоматично изчислено, read-only) -->
                                        <TextBlock Grid.Column="1" 
                                                   Text="{Binding SpecificConsumption}"
                                                   Padding="8" FontSize="11" TextAlignment="Center"
                                                   VerticalAlignment="Center" Background="#FAFAFA"/>

                                        <!-- Потребена енергия Q (редактируем ако не е IsCalculated) -->
                                        <Grid Grid.Column="2">
                                            <TextBox Text="{Binding ConsumedEnergy, UpdateSourceTrigger=PropertyChanged}"
                                                     Padding="8" FontSize="11" TextAlignment="Center"
                                                     VerticalContentAlignment="Center" BorderThickness="0"
                                                     Visibility="{Binding IsCalculated, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                            <TextBlock Text="{Binding ConsumedEnergy, StringFormat=N2}"
                                                       Padding="8" FontSize="11" TextAlignment="Center"
                                                       VerticalAlignment="Center" Background="#FAFAFA"
                                                       Visibility="{Binding IsCalculated, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        </Grid>

                                        <!-- Енергиен носител (ComboBox, само ако не е IsCalculated) -->
                                        <Grid Grid.Column="3">
                                            <ComboBox x:Name="EnergyCarrierCombo"
                                                      SelectedValue="{Binding EnergyCarrier, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      SelectedValuePath="Code"
                                                      DisplayMemberPath="DisplayName"
                                                      Padding="8" FontSize="11" BorderThickness="0"
                                                      VerticalContentAlignment="Center"
                                                      Visibility="{Binding IsCalculated, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                <ComboBox.GroupStyle>
                                                    <GroupStyle>
                                                        <GroupStyle.HeaderTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" 
                                                                          FontSize="11" Foreground="#0066CC" Margin="0,3,0,2"/>
                                                            </DataTemplate>
                                                        </GroupStyle.HeaderTemplate>
                                                    </GroupStyle>
                                                </ComboBox.GroupStyle>
                                            </ComboBox>
                                            <TextBlock Text="—" Padding="8" FontSize="11" TextAlignment="Center"
                                                       VerticalAlignment="Center" Background="#FAFAFA"
                                                       Visibility="{Binding IsCalculated, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        </Grid>

                                        <!-- fp,nren (автоматично изчислено, read-only) -->
                                        <TextBlock Grid.Column="4" 
                                                   Text="{Binding FpNrenKWh, StringFormat=N2}"
                                                   Padding="8" FontSize="11" TextAlignment="Center"
                                                   VerticalAlignment="Center" Background="#FAFAFA"/>

                                        <!-- fp,ren (автоматично изчислено, read-only) -->
                                        <TextBlock Grid.Column="5" 
                                                   Text="{Binding FpRenKWh, StringFormat=N2}"
                                                   Padding="8" FontSize="11" TextAlignment="Center"
                                                   VerticalAlignment="Center" Background="#FAFAFA"/>

                                        <!-- fp,tot (автоматично изчислено, read-only) -->
                                        <TextBlock Grid.Column="6" 
                                                   Text="{Binding FpTotKWh, StringFormat=N2}"
                                                   Padding="8" FontSize="11" TextAlignment="Center"
                                                   VerticalAlignment="Center" Background="#FAFAFA"/>

                                        <!-- EmCO2 (автоматично изчислено, read-only) -->
                                        <TextBlock Grid.Column="7" 
                                                   Text="{Binding EmCO2Tonnes, StringFormat=N6}"
                                                   Padding="8" FontSize="11" TextAlignment="Center"
                                                   VerticalAlignment="Center" Background="#FAFAFA"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Обобщение (суми) -->
                    <Border BorderBrush="#888" BorderThickness="0,2,0,0" Background="#E3F2FD">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Grid.ColumnSpan="4" 
                                       Text="ОБЩО (суми на колони):" 
                                       Padding="8" FontWeight="Bold" FontSize="12" 
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="4" 
                                       Text="{Binding Data.TotalFpNrenKWh, StringFormat=N2}"
                                       Padding="8" FontSize="11" FontWeight="Bold" 
                                       TextAlignment="Center" VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="5" 
                                       Text="{Binding Data.TotalFpRenKWh, StringFormat=N2}"
                                       Padding="8" FontSize="11" FontWeight="Bold" 
                                       TextAlignment="Center" VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="6" 
                                       Text="{Binding Data.TotalFpTotKWh, StringFormat=N2}"
                                       Padding="8" FontSize="11" FontWeight="Bold" 
                                       TextAlignment="Center" VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="7" 
                                       Text="{Binding Data.TotalEmCO2Tonnes, StringFormat=N6}"
                                       Padding="8" FontSize="11" FontWeight="Bold" 
                                       TextAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Помощна информация -->
            <Border Background="#FFF9E6" BorderBrush="#FFD700" BorderThickness="1" 
                    Padding="15" Margin="0,10,0,0" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="ℹ Указания:" FontWeight="Bold" FontSize="12" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,3">
                        • Попълнете <Bold>Потребена енергия (Q)</Bold> ръчно за редовете с енергоносител.
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,3">
                        • Изберете <Bold>Енергиен носител</Bold> от падащото меню.
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,3">
                        • Редовете <Bold>Отопление, Вентилация Отопление, БГВ и Общо</Bold> се изчисляват <Bold>автоматично</Bold>.
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" FontSize="11">
                        • Колоната <Bold>kWh/m²</Bold> се изчислява автоматично: Q / Отопляема площ.
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
