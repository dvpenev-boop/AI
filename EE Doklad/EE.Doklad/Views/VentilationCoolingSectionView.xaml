                                 Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" Width="120"/>
                    </Border>

                    <Border Grid.Row="5" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="Енергиен мениджмънт (ЕМ) и поддръжка, %" Padding="10" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="5" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <TextBox Text="{Binding EnergySource2EnergyManagement, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}" 
                                 Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" Width="120"/>
                    </Border>

                    <Border Grid.Row="6" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0">
                        <TextBlock Text="Ефективност на генератора на студ, %" Padding="10" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="6" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0">
                        <TextBox Text="{Binding EnergySource2GenerationEfficiency, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}}" 
                               Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" Width="120"/>
                    </Border>
                </Grid>
            </Border>

            <!-- V2 Results table (нов двигател – психрометрично изчисление) -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,10,0,10">
                <TextBlock Text="Резултати (психрометричен модел)" FontSize="14" FontWeight="Bold" Foreground="#1565C0" VerticalAlignment="Center" />
                <CheckBox Content="Debug (временно): Покажи вътрешни променливи" Margin="20,0,0,0" VerticalAlignment="Center"
                          IsChecked="{Binding ShowDebug, Mode=TwoWay}" />
            </StackPanel>
            <Border BorderBrush="#90CAF9" BorderThickness="1" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>

                    <!-- Header row -->
                    <Border Grid.Row="0" Grid.Column="0" Background="#1565C0" BorderBrush="White" BorderThickness="0,0,1,1">
                        <TextBlock Text="Параметър" FontWeight="Bold" Foreground="White" Padding="10" FontSize="13"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Background="#1565C0" BorderBrush="White" BorderThickness="0,0,1,1">
                        <TextBlock Text="Разход на м² (kWh/m²)" FontWeight="Bold" Foreground="White" Padding="10" FontSize="13" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="2" Background="#1565C0" BorderBrush="White" BorderThickness="0,0,0,1">
                        <TextBlock Text="Потребна енергия (kWh)" FontWeight="Bold" Foreground="White" Padding="10" FontSize="13" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Енергия за охлаждане (нетна) -->
                    <Border Grid.Row="1" Grid.Column="0" BorderBrush="#BBDEFB" BorderThickness="0,0,1,1">
                        <TextBlock Text="Явна енергия за охлаждане (нетна)" Padding="10" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" BorderBrush="#BBDEFB" BorderThickness="0,0,1,1">
                        <TextBox Text="{Binding V2_CoolNet_kWhm2, Mode=OneWay, StringFormat=0.00}" 
                                 Style="{StaticResource ReadOnlyTextBoxStyle}" FontWeight="SemiBold" TextAlignment="Center" HorizontalAlignment="Center" Width="120"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="2" BorderBrush="#BBDEFB" BorderThickness="0,0,0,1">
                        <TextBox Text="{Binding V2_CoolNet_kWh, Mode=OneWay, StringFormat=N2}" 
                                 Style="{StaticResource ReadOnlyTextBoxStyle}" FontWeight="SemiBold" TextAlignment="Center" HorizontalAlignment="Center" Width="120"/>
                    </Border>

                    <!-- Енергия за загряване -->
                    <Border Grid.Row="2" Grid.Column="0" BorderBrush="#BBDEFB" BorderThickness="0,0,1,1">
                        <TextBlock Text="Явна енергия за загряване на въздуха (нетна)" Padding="10" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="1" BorderBrush="#BBDEFB" BorderThickness="0,0,1,1">
                        <TextBox Text="{Binding V2_HeatNet_kWhm2, Mode=OneWay, StringFormat=0.00}" 
                                 Style="{StaticResource ReadOnlyTextBoxStyle}" FontWeight="SemiBold" TextAlignment="Center" HorizontalAlignment="Center" Width="120"/>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="2" BorderBrush="#BBDEFB" BorderThickness="0,0,0,1">
                        <TextBox Text="{Binding V2_HeatNet_kWh, Mode=OneWay, StringFormat=N2}" 
                                 Style="{StaticResource ReadOnlyTextBoxStyle}" FontWeight="SemiBold" TextAlignment="Center" HorizontalAlignment="Center" Width="120"/>
                    </Border>

                    <!-- Енергия за изсушаване -->
                    <Border Grid.Row="3" Grid.Column="0" BorderBrush="#BBDEFB" BorderThickness="0,0,1,1">
                        <TextBlock Text="Латентна енергия за изсушаване (нетна)" Padding="10" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="3" Grid.Column="1" BorderBrush="#BBDEFB" BorderThickness="0,0,1,1">
                        <TextBox Text="{Binding V2_DryNet_kWhm2, Mode=OneWay, StringFormat=0.00}" 
                                 Style="{StaticResource ReadOnlyTextBoxStyle}" FontWeight="SemiBold" TextAlignment="Center" HorizontalAlignment="Center" Width="120"/>
                    </Border>
                    <Border Grid.Row="3" Grid.Column="2" BorderBrush="#BBDEFB" BorderThickness="0,0,0,1">
                        <TextBox Text="{Binding V2_DryNet_kWh, Mode=OneWay, StringFormat=N2}" 
                                 Style="{StaticResource ReadOnlyTextBoxStyle}" FontWeight="SemiBold" TextAlignment="Center" HorizontalAlignment="Center" Width="120"/>
                    </Border>

                    <!-- Принос към охлаждането от вентилация (нетен) -->
                    <Border Grid.Row="4" Grid.Column="0" BorderBrush="#BBDEFB" BorderThickness="0,0,1,1">
                        <TextBlock Text="Принос към охлаждането от вентилация (нетен)" Padding="10" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="4" Grid.Column="1" BorderBrush="#BBDEFB" BorderThickness="0,0,1,1">
                        <TextBox Text="{Binding NetCoolingContribution_kWh_m2, Mode=OneWay, StringFormat=0.00}" 
                                 Style="{StaticResource ReadOnlyTextBoxStyle}" FontWeight="SemiBold" TextAlignment="Center" HorizontalAlignment="Center" Width="120"/>
                    </Border>
                    <Border Grid.Row="4" Grid.Column="2" BorderBrush="#BBDEFB" BorderThickness="0,0,0,1">
                        <TextBox Text="{Binding NetCoolingContribution_kWh, Mode=OneWay, StringFormat=N2}" 
                                 Style="{StaticResource ReadOnlyTextBoxStyle}" FontWeight="SemiBold" TextAlignment="Center" HorizontalAlignment="Center" Width="120"/>
                    </Border>

                    <!-- Потребна енергия ЕИ1 -->
                    <Border Grid.Row="5" Grid.Column="0" BorderBrush="#BBDEFB" BorderThickness="0,0,1,1">
                        <TextBlock Text="Потребна енергия (ЕИ1)" Padding="10" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="5" Grid.Column="1" BorderBrush="#BBDEFB" BorderThickness="0,0,1,1">
                        <TextBox Text="{Binding V2_FinalEI1_kWhm2, Mode=OneWay, StringFormat=0.00}" 
                                 Style="{StaticResource ReadOnlyTextBoxStyle}" TextAlignment="Center" HorizontalAlignment="Center" Width="120"/>
                    </Border>
                    <Border Grid.Row="5" Grid.Column="2" BorderBrush="#BBDEFB" BorderThickness="0,0,0,1">
                        <TextBox Text="{Binding V2_FinalEI1_kWh, Mode=OneWay, StringFormat=N2}" 
                                 Style="{StaticResource ReadOnlyTextBoxStyle}" TextAlignment="Center" HorizontalAlignment="Center" Width="120"/>
                    </Border>

                    <!-- Потребна енергия ЕИ2 -->
                    <Border Grid.Row="6" Grid.Column="0" BorderBrush="#BBDEFB" BorderThickness="0,0,1,1">
                        <TextBlock Text="Потребна енергия (ЕИ2)" Padding="10" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="6" Grid.Column="1" BorderBrush="#BBDEFB" BorderThickness="0,0,1,1">
                        <TextBox Text="{Binding V2_FinalEI2_kWhm2, Mode=OneWay, StringFormat=0.00}" 
                                 Style="{StaticResource ReadOnlyTextBoxStyle}" TextAlignment="Center" HorizontalAlignment="Center" Width="120"/>
                    </Border>
                    <Border Grid.Row="6" Grid.Column="2" BorderBrush="#BBDEFB" BorderThickness="0,0,0,1">
                        <TextBox Text="{Binding V2_FinalEI2_kWh, Mode=OneWay, StringFormat=N2}" 
                                 Style="{StaticResource ReadOnlyTextBoxStyle}" TextAlignment="Center" HorizontalAlignment="Center" Width="120"/>
                    </Border>

                    <!-- Обща потребна енергия -->
                    <Border Grid.Row="7" Grid.Column="0" BorderBrush="#BBDEFB" BorderThickness="0,0,1,0">
                        <TextBlock Text="Обща потребна енергия" Padding="10" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </Border>
                    <Border Grid.Row="7" Grid.Column="1" BorderBrush="#BBDEFB" BorderThickness="0,0,1,0">
                        <TextBox Text="{Binding V2_TotalFinal_kWhm2, Mode=OneWay, StringFormat=0.00}" 
                                 Style="{StaticResource ReadOnlyTextBoxStyle}" FontWeight="SemiBold" TextAlignment="Center" HorizontalAlignment="Center" Width="120"/>
                    </Border>
                    <Border Grid.Row="7" Grid.Column="2" BorderBrush="#BBDEFB" BorderThickness="0,0,0,0">
                        <TextBox Text="{Binding V2_TotalFinal_kWh, Mode=OneWay, StringFormat=N2}" 
                                 Style="{StaticResource ReadOnlyTextBoxStyle}" FontWeight="SemiBold" TextAlignment="Center" HorizontalAlignment="Center" Width="120"/>
                    </Border>
                </Grid>
            </Border>

            <!-- V2 error banner (показва се само при грешка в изчислението) -->
            <Border Background="#FFCDD2" BorderBrush="#D32F2F" BorderThickness="1" Padding="10" Margin="0,0,0,10"
                    Visibility="{Binding V2_ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                <TextBlock Text="{Binding V2_ErrorMessage}" TextWrapping="Wrap" Foreground="#B71C1C" FontSize="11" FontWeight="SemiBold"/>
            </Border>

            <Border BorderBrush="#BDBDBD" BorderThickness="1" Padding="8" Margin="0,0,0,20" Visibility="{Binding ShowDebug, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBox Text="{Binding DebugText, Mode=OneWay}" Style="{StaticResource ReadOnlyTextBoxStyle}" FontFamily="Consolas" FontSize="12" 
                         TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" Height="300"/>
            </Border>

            </StackPanel> <!-- End of IsEnabled wrapper -->

            <Border Background="#E8F5E9" BorderBrush="#2E7D32" BorderThickness="1" Padding="15" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="ℹ Забележки:" FontWeight="Bold" Foreground="#1B5E20" Margin="0,0,0,10"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#1B5E20" FontSize="11">
                        <Run Text="• Изчислението следва Наредба RD-02-20-3, Секция 14 – Вентилация (охлаждане) с месечни изчисления."/>
                        <LineBreak/>
                        <Run Text="• Работните часове се извличат от графика за вентилация охлаждане (секция 5)."/>
                        <LineBreak/>
                        <Run Text="• RH за латентната енергия се използва само за месеците май–септември."/>
                        <LineBreak/>
                        <Run Text="• Ефективностите по подразбиране са 100%. Стойностите трябва да бъдат въведени ръчно."/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Background="#FFCDD2" BorderBrush="#D32F2F" BorderThickness="1" Padding="15" Margin="0,10,0,0"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="⚠ Грешка при изчислението:" FontWeight="Bold" Foreground="#C62828" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="#B71C1C" FontSize="11"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>

</UserControl>
