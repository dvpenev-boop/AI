<UserControl x:Class="EE.Doklad.Views.EnergyClassSectionEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:EE.Doklad.Views.Controls"
             xmlns:converters="clr-namespace:EE.Doklad.Converters"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="900">
    
    <UserControl.Resources>
        <converters:BoolToVisibilityInverseConverter x:Key="BoolToVisInverse"/>
        <converters:HexToBrushConverter x:Key="HexToBrush"/>
        <converters:StringMatchToVisibilityConverter x:Key="StringMatchToVis"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <!-- Заглавие -->
            <TextBlock Text="{Binding Title, FallbackValue='19. Клас на енергопотребление'}"
                       FontSize="20" 
                       FontWeight="Bold" 
                       Margin="0,0,0,20"/>

            <!-- Описание -->
            <TextBlock Text="Описание:"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Margin="0,0,0,5"/>
            
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                     MinHeight="60"
                     Padding="10"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     FontSize="11"
                     Margin="0,0,0,20"
                     BorderBrush="#E0E0E0"
                     BorderThickness="1"/>

            <!-- Информационен блок -->
            <Border Background="#E3F2FD" BorderBrush="#2196F3" BorderThickness="2" 
                    Padding="20" Margin="0,0,0,25" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="ℹ Автоматично определяне на клас" 
                              FontWeight="Bold" FontSize="14" Margin="0,0,0,15"
                              Foreground="#1976D2"/>
                    
                    <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10">
                        <Run Text="Класът на енергопотребление се определя "/>
                        <Run Text="автоматично" FontWeight="Bold"/>
                        <Run Text=" на база:"/>
                    </TextBlock>
                    
                    <TextBlock TextWrapping="Wrap" FontSize="12" Margin="15,0,0,5">
                        <Run Text="• Тип сграда от секция 5 "/>
                        <Run Text="'Данни за обекта'" FontStyle="Italic"/>
                    </TextBlock>
                    
                    <TextBlock TextWrapping="Wrap" FontSize="12" Margin="15,0,0,10">
                        <Run Text="• EP (годишна специфична енергия) от секция 18 "/>
                        <Run Text="'Резултати сграда'" FontStyle="Italic"/>
                        <Run Text=" → ред "/>
                        <Run Text="'ОБЩО'" FontWeight="Bold"/>
                        <Run Text=" → колона "/>
                        <Run Text="'kWh/m²'" FontWeight="Bold"/>
                    </TextBlock>

                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#555">
                        Не е необходимо ръчно въвеждане. Данните се обновяват автоматично.
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- БЛОК A: ВХОДНИ ДАННИ (Read-Only) -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Border BorderBrush="#666" BorderThickness="2" Margin="0,0,0,25" Padding="0">
                <StackPanel>
                    <!-- Header -->
                    <Border Background="#2196F3" Padding="15">
                        <TextBlock Text="A. Входни данни" FontSize="15" FontWeight="Bold" Foreground="White"/>
                    </Border>

                    <!-- Тип сграда (read-only от секция 5) -->
                    <Border BorderBrush="#CCC" BorderThickness="0,0,0,1" Background="White">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="3*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Тип сграда:" 
                                      Padding="15,12" FontWeight="SemiBold" FontSize="13" 
                                      Background="#F5F5F5" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" 
                                      Text="{Binding BuildingTypeDisplay, FallbackValue='Не е избран'}" 
                                      Padding="15,12" FontSize="13" VerticalAlignment="Center"
                                      Background="White"
                                      Foreground="#333"/>
                        </Grid>
                    </Border>

                    <!-- EP - Годишна специфична енергия (read-only от секция 18) -->
                    <Border BorderBrush="#CCC" BorderThickness="0,0,0,0" Background="White">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="3*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" 
                                      Padding="15,12" FontWeight="SemiBold" FontSize="13" 
                                      Background="#F5F5F5" VerticalAlignment="Center">
                                <Run Text="EP – Годишна специфична енергия"/>
                                <LineBreak/>
                                <Run Text="[kWh/m²]:" FontSize="12" Foreground="#666"/>
                            </TextBlock>
                            <TextBlock Grid.Column="1" 
                                      Text="{Binding EnergyPerformanceDisplay, FallbackValue='—'}" 
                                      Padding="15,12" FontSize="13" VerticalAlignment="Center"
                                      Background="White"
                                      Foreground="#333"
                                      FontWeight="SemiBold"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- БЛОК B: РЕЗУЛТАТ: ЕНЕРГИЕН КЛАС (само карта, без голяма скала) -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Border BorderBrush="#4CAF50" BorderThickness="3" Background="#F1F8F4" 
                    Padding="25" Margin="0,0,0,25" CornerRadius="8"
                    Visibility="{Binding IsDataAvailable, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="B. Резултат: Енергиен клас" 
                              FontSize="16" FontWeight="Bold" Margin="0,0,0,20"
                              Foreground="#2E7D32"/>

                    <!-- Карта с клас (центрирана) -->
                    <Border Background="{Binding ClassColor, Converter={StaticResource HexToBrush}}" 
                            BorderBrush="#333" BorderThickness="3"
                            Padding="40" CornerRadius="8"
                            HorizontalAlignment="Center"
                            Width="400">
                        <StackPanel>
                            <TextBlock Text="ЕНЕРГИЕН КЛАС" FontSize="14" FontWeight="SemiBold" 
                                      HorizontalAlignment="Center" Foreground="White" Margin="0,0,0,15"/>
                            <TextBlock Text="{Binding ClassDisplay, FallbackValue='—'}" 
                                      FontSize="90" FontWeight="Bold" 
                                      HorizontalAlignment="Center" Foreground="White"
                                      Margin="0,0,0,15"/>
                            <TextBlock Text="{Binding ClassDescription, FallbackValue='—'}" 
                                      FontSize="12" TextAlignment="Center" FontWeight="SemiBold"
                                      Foreground="White" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- БЛОК C: ТАБЛИЦА-СКАЛА С ПРАГОВЕ (като Word/Excel) -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Border BorderBrush="#666" BorderThickness="2" Margin="0,0,0,20" Padding="0"
                    Visibility="{Binding IsDataAvailable, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <!-- Header -->
                    <Border Background="#FF9800" Padding="12">
                        <TextBlock Text="C. Прагове за избрания тип сграда" 
                                  FontSize="14" FontWeight="Bold" Foreground="White"/>
                    </Border>

                    <!-- Компактна таблица-скала -->
                    <DataGrid ItemsSource="{Binding ThresholdRows}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="All"
                              CanUserReorderColumns="False"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="False"
                              BorderThickness="0"
                              RowBackground="White"
                              AlternatingRowBackground="#F9F9F9"
                              RowHeight="35"
                              FontWeight="Bold">
                        
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        
                        <DataGrid.Columns>
                            <!-- От (Min) -->
                            <DataGridTextColumn Header="EPmin [kWh/m²]" 
                                                Binding="{Binding MinValueDisplay}" 
                                                Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="8,5"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Условие -->
                            <DataGridTextColumn Header="Условие" 
                                                Binding="{Binding RuleText}" 
                                                Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="8,5"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- До (Max) -->
                            <DataGridTextColumn Header="EPmax [kWh/m²]" 
                                                Binding="{Binding MaxValueDisplay}" 
                                                Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="8,5"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Скала (цветна лента с клас) -->
                            <DataGridTemplateColumn Header="Скала" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}" 
                                                BorderBrush="White" BorderThickness="1"
                                                Margin="2" Padding="10,5">
                                            <TextBlock Text="{Binding Class}" 
                                                      FontWeight="Bold" FontSize="16"
                                                      Foreground="Black"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- EP маркер (показва се само на правилния ред) -->
                            <DataGridTemplateColumn Header="EP kWh/m²" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <!-- Маркер (показва се само ако има текст) -->
                                            <Border Background="#1976D2" BorderBrush="#0D47A1" BorderThickness="2"
                                                    Padding="10,5" Margin="2" CornerRadius="4">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelectedClass}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding MarkerText}" 
                                                          FontWeight="Bold" FontSize="14"
                                                          Foreground="White"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Информация за източниците на данните -->
            <Border Background="#ECEFF1" BorderBrush="#90A4AE" BorderThickness="1" 
                    Padding="15" Margin="0,10,0,0" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="📋 Източници на данни:" 
                              FontWeight="Bold" FontSize="12" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,3">
                        <Run Text="• Тип сграда: Секция 5 " FontWeight="SemiBold"/>
                        <Run Text="'Данни за обекта' → Тип сграда" FontStyle="Italic"/>
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" FontSize="11">
                        <Run Text="• EP стойност: Секция 18 " FontWeight="SemiBold"/>
                        <Run Text="'Резултати сграда' → Ред 'ОБЩО' → Колона 'kWh/m²'" FontStyle="Italic"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
