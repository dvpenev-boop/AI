<Window x:Class="EE.Doklad.Views.ImportOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Опции за импорт" Height="240" Width="520" WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Изберете действие при конфликт:" FontWeight="Bold"/>

        <StackPanel Grid.Row="1" Margin="6,10,6,6">
            <RadioButton x:Name="RbReplaceAll" Content="Заменяне на всички потребителски материали (Replace all)" Margin="0,4" />
            <RadioButton x:Name="RbMergeSkip" Content="Обединяване: прескачане на повтарящи се записи (Keep existing, skip duplicates)" Margin="0,4" />
            <RadioButton x:Name="RbMergeOverwrite" Content="Обединяване: презаписване на повтарящи се записи (Overwrite existing)" Margin="0,4" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="90" Margin="0,0,8,0" Click="Ok_Click"/>
            <Button Content="Отказ" Width="90" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
