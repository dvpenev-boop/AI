<UserControl x:Class="EE.Doklad.Views.RoofSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:EE.Doklad.Converters"
             xmlns:views="clr-namespace:EE.Doklad.Views"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/EE.Doklad;component/Views/RoofSectionViewResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:FlexibleDoubleConverter x:Key="FlexibleDoubleConverter"/>
            <converters:CollectionToVisibilityConverter x:Key="CollectionToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

    <!-- Thermal Bridges summary popup – opens when user clicks the „Режим ТМ" cell -->
    <Popup x:Name="ThermalBridgesPopup"
           AllowsTransparency="True"
           StaysOpen="False"
           Placement="MousePoint"
           PopupAnimation="Fade">
        <Border Background="White" BorderBrush="#CE93D8" BorderThickness="1"
                CornerRadius="4" Padding="12" Effect="{x:Null}">
            <StackPanel MinWidth="300">
                <TextBlock x:Name="TbPopupTitle" FontWeight="Bold" FontSize="12"
                           Foreground="#4A148C" Margin="0,0,0,8"
                           Text="Топлинни мостове"/>
                <StackPanel Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Режим:"   FontSize="11" Width="90" Foreground="#555"/>
                        <TextBlock x:Name="TbPopupMode" FontSize="11" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                x:Name="TbPopupPercentRow" Visibility="Collapsed">
                        <TextBlock Text="Процент:" FontSize="11" Width="90" Foreground="#555"/>
                        <TextBlock x:Name="TbPopupPercent" FontSize="11"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                x:Name="TbPopupCountRow" Visibility="Collapsed">
                        <TextBlock Text="Брой ТМ:" FontSize="11" Width="90" Foreground="#555"/>
                        <TextBlock x:Name="TbPopupCount" FontSize="11"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Hel:"     FontSize="11" Width="90" Foreground="#555"/>
                        <TextBlock x:Name="TbPopupHel" FontSize="11"/>
                        <TextBlock Text=" W/K"     FontSize="10" Foreground="#999"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Htb:"     FontSize="11" Width="90" Foreground="#555"/>
                        <TextBlock x:Name="TbPopupHtb" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Text=" W/K"     FontSize="10" Foreground="#999"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Htotal:"  FontSize="11" Width="90" Foreground="#555"/>
                        <TextBlock x:Name="TbPopupHtotal" FontSize="11" FontWeight="Bold" Foreground="#4A148C"/>
                        <TextBlock Text=" W/K"     FontSize="10" Foreground="#999"/>
                    </StackPanel>
                </StackPanel>
                <Button Content="Отиди към строителния елемент" Padding="8,4" FontSize="11"
                        Background="#7B1FA2" Foreground="White" BorderThickness="0"
                        HorizontalAlignment="Right"
                        Click="TbPopupNavigate_Click"/>
            </StackPanel>
        </Border>
    </Popup>
        
    <TextBlock Text="Покрив" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
        
        <!-- Описание -->
        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,10,0,10">
            <TextBlock Text="Описание на покрива (вид, състояние, конструкция):" />
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="60"/>
        </StackPanel>
        
        <!-- Обобщаваща таблица -->
        <GroupBox Header="Покрив по типове" Grid.Row="2">
            <DockPanel>
        <!-- Бутон за добавяне -->
        <Button Content="+ Добави покрив"
            Click="AddRoof_Click"
            DockPanel.Dock="Top" HorizontalAlignment="Left" Margin="0,0,0,5"
            Background="#4CAF50" Foreground="White" Padding="14,6" MinWidth="140" BorderThickness="0"/>
                
                <!-- Таблица с покриви -->
                <DataGrid x:Name="SummaryGrid" 
                          ItemsSource="{Binding RoofTypes}" 
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False"
                          RowHeight="24" 
                          MaxHeight="270" 
                          ScrollViewer.VerticalScrollBarVisibility="Auto" 
                          DockPanel.Dock="Top"
                          Margin="0,0,0,10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№" Binding="{Binding Number}" IsReadOnly="True" Width="40"/>
                        <DataGridTextColumn Header="Тип покрив" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        <DataGridTextColumn Header="Режим" Binding="{Binding ModeLabel}" IsReadOnly="True" Width="120"/>
                        <DataGridTextColumn Header="U (W/m²K)" Binding="{Binding UDisplay}" IsReadOnly="True" Width="100"/>
                        <DataGridTextColumn Header="α" Binding="{Binding SurfaceProperties.AlphaDefault, StringFormat=0.00}" IsReadOnly="True" Width="55"/>
                        <DataGridTextColumn Header="ε" Binding="{Binding SurfaceProperties.EpsilonDefault, StringFormat=0.00}" IsReadOnly="True" Width="55"/>
                        <DataGridTextColumn Header="A (m²)" Binding="{Binding Area, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=N3}" Width="100"/>
                        <!-- Thermal Bridges: clickable mode cell -->
                        <DataGridTemplateColumn Header="Режим ТМ" IsReadOnly="True" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Click="ThermalBridgeModeCell_Click"
                                            Cursor="Hand" BorderThickness="0" Padding="4,2"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            Background="Transparent">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#EDE7F6"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock VerticalAlignment="Center" FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Няма"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ThermalBridges.Mode}" Value="GlobalPercentage">
                                                                <Setter Property="Text" Value="Глобален %"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ThermalBridges.Mode}" Value="Manual">
                                                                <Setter Property="Text" Value="Детайлно"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="▾" VerticalAlignment="Center" Margin="3,0,0,0"
                                                       FontSize="10" Foreground="#7B1FA2">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ThermalBridges.Mode}" Value="GlobalPercentage">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ThermalBridges.Mode}" Value="Manual">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Htb (W/K)" Binding="{Binding ThermalBridges.Htb, StringFormat=0.000}" IsReadOnly="True" Width="80"/>
                        <DataGridTextColumn Header="Hel (W/K)" Binding="{Binding ThermalBridges.Hel, StringFormat=0.000}" IsReadOnly="True" Width="80"/>
                        <DataGridTextColumn Header="Htotal (W/K)" Binding="{Binding ThermalBridges.Htotal, StringFormat=0.000}" IsReadOnly="True" Width="90"/>
                        <DataGridTemplateColumn Header="" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Премахни" 
                                            Background="#e53935" Foreground="White" Padding="8,2" BorderThickness="0"
                                            Command="{Binding DataContext.RemoveRoofTypeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Детайли за всички покриви -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Топли покриви -->
                        <GroupBox Header="Топли покриви" 
                                  Margin="10"
                                  Visibility="{Binding WarmRoofs, Converter={StaticResource CollectionToVisibilityConverter}}">
                            <ItemsControl x:Name="WarmRoofsContainer" ItemsSource="{Binding WarmRoofs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <views:WarmRoofDetailControl DataContext="{Binding}" Margin="0,0,0,10"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </GroupBox>

                        <!-- Студени покриви -->
                        <GroupBox Header="Студени покриви" 
                                  Margin="10"
                                  Visibility="{Binding ColdRoofs, Converter={StaticResource CollectionToVisibilityConverter}}">
                            <ItemsControl x:Name="ColdRoofsContainer" ItemsSource="{Binding ColdRoofs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <views:ColdRoofDetailControl DataContext="{Binding}" Margin="0,0,0,10"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </GroupBox>
    </Grid>
</UserControl>
