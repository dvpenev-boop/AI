<UserControl x:Class="EE.Doklad.Views.EnergyClassSectionEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:EE.Doklad.Views.Controls"
             xmlns:converters="clr-namespace:EE.Doklad.Converters"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="900">
    
    <UserControl.Resources>
        <converters:BoolToVisibilityInverseConverter x:Key="BoolToVisInverse"/>
        <converters:HexToBrushConverter x:Key="HexToBrush"/>
        <converters:StringMatchToVisibilityConverter x:Key="StringMatchToVis"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <!-- Заглавие -->
            <TextBlock Text="{Binding Title, FallbackValue='19. Клас на енергопотребление'}"
                       FontSize="20" 
                       FontWeight="Bold" 
                       Margin="0,0,0,20"/>

            <!-- Описание -->
            <TextBlock Text="Описание:"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Margin="0,0,0,5"/>
            
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                     MinHeight="60"
                     Padding="10"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     FontSize="11"
                     Margin="0,0,0,20"
                     BorderBrush="#E0E0E0"
                     BorderThickness="1"/>

            <!-- Информационен блок -->
            <Border Background="#E3F2FD" BorderBrush="#2196F3" BorderThickness="2" 
                    Padding="20" Margin="0,0,0,25" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="ℹ Автоматично определяне на клас" 
                              FontWeight="Bold" FontSize="14" Margin="0,0,0,15"
                              Foreground="#1976D2"/>
                    
                    <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10">
                        <Run Text="Класът на енергопотребление се определя "/>
                        <Run Text="автоматично" FontWeight="Bold"/>
                        <Run Text=" на база:"/>
                    </TextBlock>
                    
                    <TextBlock TextWrapping="Wrap" FontSize="12" Margin="15,0,0,5">
                        <Run Text="• Тип сграда от секция 5 "/>
                        <Run Text="'Данни за обекта'" FontStyle="Italic"/>
                    </TextBlock>
                    
                    <TextBlock TextWrapping="Wrap" FontSize="12" Margin="15,0,0,10">
                        <Run Text="• EP (годишна специфична енергия) от секция 'Резултати сграда' "/>
                        <Run Text="(ред 'ОБЩО' → колона 'kWh/m²')" FontWeight="Bold"/>
                    </TextBlock>

                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#555">
                        Не е необходимо ръчно въвеждане. Данните се обновяват автоматично.
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- БЛОК A: ВХОДНИ ДАННИ (Read-Only) - съвпадна с B и C -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Border BorderBrush="#2196F3" BorderThickness="2" Margin="0,0,0,15" Padding="0"
                    Width="675" HorizontalAlignment="Left">
                <StackPanel>
                    <!-- Header -->
                    <Border Background="#2196F3" Padding="12">
                        <TextBlock Text="A. Входни данни" FontSize="13" FontWeight="Bold" Foreground="White"/>
                    </Border>

                    <!-- Таблица с данни -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Ред 1: Тип сграда -->
                        <Border Grid.Row="0" Grid.Column="0" Background="#E3F2FD" 
                                BorderBrush="#CCC" BorderThickness="0,0,1,1" Padding="12">
                            <TextBlock Text="Тип сграда:" FontWeight="Bold" FontSize="11" 
                                      VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="1" Background="White" 
                                BorderBrush="#CCC" BorderThickness="0,0,0,1" Padding="12">
                            <TextBlock Text="{Binding BuildingTypeDisplay, FallbackValue='Не е избран'}" 
                                      FontSize="11" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </Border>

                        <!-- Ред 2: EP -->
                        <Border Grid.Row="1" Grid.Column="0" Background="#E3F2FD" 
                                BorderBrush="#CCC" BorderThickness="0,0,1,0" Padding="12">
                            <StackPanel>
                                <TextBlock Text="EP – Годишна специфична енергия" 
                                          FontWeight="Bold" FontSize="11"/>
                                <TextBlock Text="[kWh/m²]:" FontSize="9" Foreground="#666" 
                                          Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Background="White" 
                                BorderBrush="#CCC" BorderThickness="0" Padding="12">
                            <TextBlock Text="{Binding EnergyPerformanceDisplay, FallbackValue='—'}" 
                                      FontSize="11" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- БЛОКОВЕ B + C: РЕЗУЛТАТ И ТАБЛИЦА-СКАЛА (обединени на един ред) -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Grid Visibility="{Binding IsDataAvailable, Converter={StaticResource BoolToVis}}"
                  Margin="0,0,0,20" Width="675" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ЛЯВО: Блок B - Резултатна карта (компактна) -->
                <Border Grid.Column="0" BorderBrush="#4CAF50" BorderThickness="2" 
                        Background="#F1F8F4" Padding="12" CornerRadius="6" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="B. Резултат" 
                                  FontSize="12" FontWeight="Bold" Margin="0,0,0,10"
                                  Foreground="#2E7D32"/>

                        <!-- Карта с клас (компактна) -->
                        <Border Background="{Binding ClassColor, Converter={StaticResource HexToBrush}}" 
                                BorderBrush="#333" BorderThickness="2"
                                Padding="20,15" CornerRadius="6">
                            <StackPanel>
                                <TextBlock Text="ЕНЕРГИЕН КЛАС" FontSize="12" FontWeight="Bold" 
                                          HorizontalAlignment="Center" Foreground="Black" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding ClassDisplay, FallbackValue='—'}" 
                                          FontSize="48" FontWeight="Bold" 
                                          HorizontalAlignment="Center" Foreground="Black"
                                          Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding ClassDescription, FallbackValue='—'}" 
                                          FontSize="11" TextAlignment="Center" FontWeight="Bold"
                                          Foreground="Black" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ДЯСНО: Блок C - Компактна таблица-скала -->
                <Border Grid.Column="1" BorderBrush="#FF9800" BorderThickness="2" 
                        Padding="0" CornerRadius="6">
                    <StackPanel>
                        <!-- Header -->
                        <Border Background="#FF9800" Padding="8" CornerRadius="6,6,0,0">
                            <TextBlock Text="C. Прагове за избрания тип сграда" 
                                      FontSize="12" FontWeight="Bold" Foreground="White"/>
                        </Border>

                        <!-- Компактна таблица-скала -->
                        <DataGrid ItemsSource="{Binding ThresholdRows}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="All"
                                  CanUserReorderColumns="False"
                                  CanUserResizeColumns="False"
                                  CanUserSortColumns="False"
                                  BorderThickness="0"
                                  RowBackground="White"
                                  AlternatingRowBackground="#F9F9F9"
                                  RowHeight="30"
                                  FontWeight="Bold">
                            
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="FontSize" Value="9"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="3,5"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            
                            <DataGrid.Columns>
                                <!-- От (Min) -->
                                <DataGridTextColumn Header="EPmin" 
                                                    Binding="{Binding MinValueDisplay}" 
                                                    Width="55">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Padding" Value="3,3"/>
                                            <Setter Property="FontSize" Value="9"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Условие -->
                                <DataGridTextColumn Header="Условие" 
                                                    Binding="{Binding RuleText}" 
                                                    Width="95">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Padding" Value="3,3"/>
                                            <Setter Property="FontSize" Value="9"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- До (Max) -->
                                <DataGridTextColumn Header="EPmax" 
                                                    Binding="{Binding MaxValueDisplay}" 
                                                    Width="55">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Padding" Value="3,3"/>
                                            <Setter Property="FontSize" Value="9"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Скала (цветна лента с клас) -->
                                <DataGridTemplateColumn Header="Скала" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}" 
                                                    BorderBrush="White" BorderThickness="1"
                                                    Margin="1" Padding="6,3">
                                                <TextBlock Text="{Binding Class}" 
                                                          FontWeight="Bold" FontSize="12"
                                                          Foreground="Black"
                                                          HorizontalAlignment="Left"
                                                          VerticalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- EP маркер (показва се само на правилния ред) -->
                                <DataGridTemplateColumn Header="EP kWh/m²" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <!-- Маркер (показва се само ако има текст) -->
                                                <Border Background="#1976D2" BorderBrush="#0D47A1" BorderThickness="2"
                                                        Padding="6,3" Margin="1" CornerRadius="3">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelectedClass}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding MarkerText}" 
                                                              FontWeight="Bold" FontSize="11"
                                                              Foreground="White"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Информация за източниците на данните -->
            <Border Background="#ECEFF1" BorderBrush="#90A4AE" BorderThickness="1" 
                    Padding="15" Margin="0,10,0,0" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="📋 Източници на данни:" 
                              FontWeight="Bold" FontSize="12" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,3">
                        <Run Text="• Тип сграда: Секция 5 " FontWeight="SemiBold"/>
                        <Run Text="'Данни за обекта' → Тип сграда" FontStyle="Italic"/>
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" FontSize="11">
                        <Run Text="• EP стойност: Секция 'Резултати сграда' " FontWeight="SemiBold"/>
                        <Run Text="→ Ред 'ОБЩО' → Колона 'kWh/m²'" FontStyle="Italic"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
