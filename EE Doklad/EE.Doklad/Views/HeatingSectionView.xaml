<UserControl x:Class="EE.Doklad.Views.HeatingSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:EE.Doklad.Converters"
             xmlns:models="clr-namespace:EE.Doklad.Models"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="900">

    <UserControl.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>

        <!-- Note: energy-related styles and converters are defined at Application scope (App.xaml)
             to ensure ComboBox item container styles are available to the popup visual root on first show.
             Keep section-specific styles here. -->

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,8,0,2"/>
        </Style>
        
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="WhiteLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource LabelStyle}">
            <Setter Property="Background" Value="White"/>
        </Style>
        
        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        
        <!-- Backwards-compatible alias used across views: ensure editable textboxes are vertically centered -->
        <Style x:Key="EditableTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource InputTextBoxStyle}">
            <!-- keep defaults from InputTextBoxStyle; individual TextBoxes set Width/TextAlignment -->
        </Style>
        
        <Style x:Key="ReadOnlyTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource InputTextBoxStyle}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#F9F9F9"/>
            <Setter Property="Foreground" Value="#555"/>
        </Style>

        <Style x:Key="CompactEnergyComboBoxItemStyle" TargetType="ComboBoxItem" BasedOn="{StaticResource EnergyComboBoxItemStyle}">
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>

        <Style x:Key="CompactEnergySourceComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource EnergySourceComboBoxStyle}">
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource CompactEnergyComboBoxItemStyle}"/>
        </Style>
        
        <Style x:Key="ErrorTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Red"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="4,1,0,0"/>
        </Style>

        <Style x:Key="HeatingSummaryHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#E53935"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style x:Key="HeatingSummaryCellTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="HeatingSummaryRowStyle" TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#FFF5F5"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsTotal}" Value="True">
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Background" Value="#FFF0E6"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                    <Setter Property="Background" Value="#FFE6F4EA"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                    <Setter Property="MinHeight" Value="6"/>
                    <Setter Property="MaxHeight" Value="6"/>
                    <Setter Property="Background" Value="#FFD8D8D8"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="IsHitTestVisible" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <!-- &#x0420;&#x00A0;&#x0432;&#x0402;&#x201D;&#x0420;&#x00A0;&#x0412;&#x00B0;&#x0420;&#x00A0;&#x0421;&#x2013;&#x0420;&#x00A0;&#x0412;&#x00BB;&#x0420;&#x00A0;&#x0412;&#x00B0;&#x0420;&#x00A0;&#x0420;&#x2020;&#x0420;&#x00A0;&#x0421;&#x2018;&#x0420;&#x00A0;&#x0412;&#x00B5; -->
            <TextBlock Text="11. &#x0420;&#x00A0;&#x0421;&#x203A;&#x0420;&#x040E;&#x0432;&#x0402;&#x0459;&#x0420;&#x00A0;&#x0421;&#x2022;&#x0420;&#x00A0;&#x0421;&#x2014;&#x0420;&#x00A0;&#x0412;&#x00BB;&#x0420;&#x00A0;&#x0412;&#x00B5;&#x0420;&#x00A0;&#x0420;&#x2026;&#x0420;&#x00A0;&#x0421;&#x2018;&#x0420;&#x00A0;&#x0412;&#x00B5;"
                       FontSize="18" 
                       FontWeight="Bold" 
                       Margin="0,0,0,15"/>

            <!-- Warning text (when heating season is NOT enabled) -->
            <Border Background="#FFF3CD" BorderBrush="#FFC107" BorderThickness="2" Padding="12" Margin="0,0,0,15"
                    Visibility="{Binding HeatingSeasonWarning, Converter={StaticResource StringToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x0420;&#x0406;&#x0421;&#x2122;&#x0412;&#x00A0;&#x0420;&#x0457;&#x0421;&#x2018;&#x0420;&#x040F;" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding HeatingSeasonWarning}" 
                               FontSize="13" FontWeight="SemiBold" 
                               Foreground="#856404" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Main content (disabled when heating season is NOT enabled) -->
            <StackPanel IsEnabled="{Binding IsHeatingSeasonEnabled}">

                <!-- &#x0420;&#x00A0;&#x0421;&#x203A;&#x0420;&#x00A0;&#x0421;&#x2014;&#x0420;&#x00A0;&#x0421;&#x2018;&#x0420;&#x040E;&#x0420;&#x0453;&#x0420;&#x00A0;&#x0412;&#x00B0;&#x0420;&#x00A0;&#x0420;&#x2026;&#x0420;&#x00A0;&#x0421;&#x2018;&#x0420;&#x00A0;&#x0412;&#x00B5; (&#x0420;&#x040E;&#x0420;&#x0453;&#x0420;&#x00A0;&#x0420;&#x2020;&#x0420;&#x00A0;&#x0421;&#x2022;&#x0420;&#x00A0;&#x0412;&#x00B1;&#x0420;&#x00A0;&#x0421;&#x2022;&#x0420;&#x00A0;&#x0422;&#x2018;&#x0420;&#x00A0;&#x0412;&#x00B5;&#x0420;&#x00A0;&#x0420;&#x2026; &#x0420;&#x040E;&#x0432;&#x0402;&#x0459;&#x0420;&#x00A0;&#x0412;&#x00B5;&#x0420;&#x00A0;&#x0421;&#x201D;&#x0420;&#x040E;&#x0420;&#x0453;&#x0420;&#x040E;&#x0432;&#x0402;&#x0459;) -->
                <TextBlock Text="&#x041E;&#x043F;&#x0438;&#x0441;&#x0430;&#x043D;&#x0438;&#x0435;:"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>
                
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         MinHeight="80"
                         Padding="10"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         FontSize="11"
                         Margin="0,0,0,20"
                         BorderBrush="#E0E0E0"
                         BorderThickness="1"/>

                <GroupBox Header="&#x041C;&#x0435;&#x0442;&#x043E;&#x0434;&#x0438;&#x043A;&#x0430; &#x043D;&#x0430; &#x0438;&#x0437;&#x0447;&#x0438;&#x0441;&#x043B;&#x0435;&#x043D;&#x0438;&#x0435;"
                          Margin="0,0,0,12"
                          BorderBrush="#CC2200"
                          BorderThickness="1">
                    <StackPanel Orientation="Vertical" Margin="8">
                        <RadioButton Content="1 - &#x0410;&#x0423;&#x0415;&#x0420; &#x0441;&#x043E;&#x0444;&#x0442;&#x0443;&#x0435;&#x0440;"
                                     IsChecked="{Binding IsMethodAuer}"
                                     GroupName="CalcMethod"
                                     Margin="0,2"/>
                        <RadioButton Content="2 - &#x0420;&#x0414;-02-20-3 &#x043E;&#x0442; 9.11.2022 &#x0433;."
                                     IsChecked="{Binding IsMethodRd}"
                                     GroupName="CalcMethod"
                                     Margin="0,2"/>
                        <RadioButton Content="3 - ASHRAE (&#x043C;&#x0435;&#x0436;&#x0434;&#x0443;&#x043D;&#x0430;&#x0440;&#x043E;&#x0434;&#x0435;&#x043D; &#x0441;&#x0442;&#x0430;&#x043D;&#x0434;&#x0430;&#x0440;&#x0442;)"
                                     IsChecked="{Binding IsMethodAshrae}"
                                     GroupName="CalcMethod"
                                     Margin="0,2"/>
                        <TextBlock Text="{Binding MethodStatusText}"
                                   Foreground="{Binding MethodStatusBrush}"
                                   FontStyle="Italic"
                                   Margin="0,6,0,0"
                                   FontSize="11"/>
                    </StackPanel>
                </GroupBox>

            <TextBlock Text="&#x0427;&#x0430;&#x0441;&#x043E;&#x0432;&#x0435; &#x0440;&#x0430;&#x0431;&#x043E;&#x0442;&#x0430; &#x043D;&#x0430; &#x0438;&#x043D;&#x0441;&#x0442;&#x0430;&#x043B;&#x0430;&#x0446;&#x0438;&#x044F;&#x0442;&#x0430;" Style="{StaticResource SectionHeaderStyle}"/>
            <Border BorderBrush="#E0E0E0" BorderThickness="1" Margin="0" Width="820" HorizontalAlignment="Left">
                <Grid Background="White">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="520"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Background="#E53935" BorderBrush="White" BorderThickness="0,0,1,1">
                        <TextBlock Text="&#x041F;&#x0430;&#x0440;&#x0430;&#x043C;&#x0435;&#x0442;&#x044A;&#x0440;" FontWeight="Bold" Foreground="White" Padding="10,4" FontSize="13"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Background="#E53935" BorderBrush="White" BorderThickness="0,0,0,1">
                        <TextBlock Text="&#x0410;&#x043A;&#x0442;&#x0443;&#x0430;&#x043B;&#x043D;&#x043E; &#x0441;&#x044A;&#x0441;&#x0442;&#x043E;&#x044F;&#x043D;&#x0438;&#x0435;" FontWeight="Bold" Foreground="White" Padding="10,4" FontSize="13"/>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
                        <TextBlock Text="t_H [h/&#x0433;&#x043E;&#x0434;]" Style="{StaticResource LabelStyle}"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0">
                        <TextBox Text="{Binding HeatingInstallationHoursDisplay, Mode=OneWay}"
                                 Style="{StaticResource ReadOnlyTextBoxStyle}"
                                 TextAlignment="Center"
                                 HorizontalAlignment="Stretch"/>
                    </Border>
                </Grid>
            </Border>

            <!-- &#x0420;&#x00A0;&#x0420;&#x040B;&#x0420;&#x00A0;&#x0432;&#x0402;&#x045E;&#x0420;&#x00A0;&#x0421;&#x2122;&#x0420;&#x00A0;&#x0412;&#x00A6;&#x0420;&#x00A0;&#x0412;&#x0098;&#x0420;&#x00A0;&#x0420;&#x2021; 1: &#x0420;&#x00A0;&#x0412;&#x00A0;&#x0420;&#x00A0;&#x0420;&#x201E;&#x0420;&#x00A0;&#x0412;&#x00A7;&#x0420;&#x00A0;&#x0421;&#x045A;&#x0420;&#x00A0;&#x0412;&#x0098; &#x0420;&#x00A0;&#x0421;&#x045F;&#x0420;&#x00A0;&#x0421;&#x2019;&#x0420;&#x00A0;&#x0412;&#x00A0;&#x0420;&#x00A0;&#x0421;&#x2019;&#x0420;&#x00A0;&#x0421;&#x0459;&#x0420;&#x00A0;&#x0432;&#x0402;&#x045E;&#x0420;&#x00A0;&#x0421;&#x045B;&#x0420;&#x00A0;&#x0412;&#x00A0;&#x0420;&#x00A0;&#x0412;&#x0098; -->
            <TextBlock Text="&#x0422;&#x043E;&#x043F;&#x043B;&#x0438;&#x043D;&#x043D;&#x0438; &#x0445;&#x0430;&#x0440;&#x0430;&#x043A;&#x0442;&#x0435;&#x0440;&#x0438;&#x0441;&#x0442;&#x0438;&#x043A;&#x0438;" Style="{StaticResource SectionHeaderStyle}"/>
            <Border BorderBrush="#E0E0E0" BorderThickness="1" Margin="0" HorizontalAlignment="Left">
                <DataGrid ItemsSource="{Binding ThermalCharacteristicsRows}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          CanUserResizeRows="False"
                          CanUserSortColumns="False"
                          HeadersVisibility="Column"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          AlternationCount="2"
                          AlternatingRowBackground="#FFF5F5"
                          RowStyle="{StaticResource HeatingSummaryRowStyle}"
                          ColumnHeaderStyle="{StaticResource HeatingSummaryHeaderStyle}"
                          BorderThickness="0"
                          Background="White"
                          MinWidth="820">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="&#x041F;&#x0430;&#x0440;&#x0430;&#x043C;&#x0435;&#x0442;&#x044A;&#x0440;" Binding="{Binding Parameter}" Width="344"/>
                        <DataGridTemplateColumn Header="U (W/m&#x00B2;K)" Width="88">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding UDisplay}" Style="{StaticResource HeatingSummaryCellTextStyle}" ToolTip="{Binding UToolTip}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="A (m&#x00B2;)" Width="88">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ADisplay}" Style="{StaticResource HeatingSummaryCellTextStyle}" ToolTip="{Binding AToolTip}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="H (W/K)" Binding="{Binding HDisplay}" Width="88" ElementStyle="{StaticResource HeatingSummaryCellTextStyle}"/>
                        <DataGridTextColumn Header="kWh/m&#x00B2;" Binding="{Binding KwhPerAreaDisplay}" Width="88" ElementStyle="{StaticResource HeatingSummaryCellTextStyle}"/>
                        <DataGridTextColumn Header="kWh" Binding="{Binding KwhDisplay}" Width="124" ElementStyle="{StaticResource HeatingSummaryCellTextStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <TextBlock Text="&#x041F;&#x0430;&#x0440;&#x0430;&#x043C;&#x0435;&#x0442;&#x0440;&#x0438; &#x0441;&#x0433;&#x0440;&#x0430;&#x0434;&#x0430; &#x041E;&#x0442;&#x043E;&#x043F;&#x043B;&#x0435;&#x043D;&#x0438;&#x0435;" Style="{StaticResource SectionHeaderStyle}"/>
             
            <Border BorderBrush="#E0E0E0" BorderThickness="1" Margin="0" Width="820" HorizontalAlignment="Left">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="520"/>
                            <ColumnDefinition Width="300"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#E53935" BorderBrush="White" BorderThickness="0,0,1,1">
                            <TextBlock Text="&#x041F;&#x0430;&#x0440;&#x0430;&#x043C;&#x0435;&#x0442;&#x044A;&#x0440;" FontWeight="Bold" Foreground="White" Padding="10,4" FontSize="13"/>
                        </Border>
                        <Border Grid.Column="1" Background="#E53935" BorderBrush="White" BorderThickness="0,0,0,1">
                            <TextBlock Text="&#x0410;&#x043A;&#x0442;&#x0443;&#x0430;&#x043B;&#x043D;&#x043E; &#x0441;&#x044A;&#x0441;&#x0442;&#x043E;&#x044F;&#x043D;&#x0438;&#x0435;" FontWeight="Bold" Foreground="White" Padding="10,4" FontSize="13"/>
                        </Border>
                    </Grid>

                    <!-- Keep only the first three manual inputs -->
                    <!-- &#x0420;&#x00A0;&#x0412;&#x0098;&#x0420;&#x00A0;&#x0420;&#x2026;&#x0420;&#x040E;&#x0432;&#x0402;&#x045B;&#x0420;&#x00A0;&#x0421;&#x2018;&#x0420;&#x00A0;&#x0412;&#x00BB;&#x0420;&#x040E;&#x0432;&#x0402;&#x0459;&#x0420;&#x040E;&#x0420;&#x201A;&#x0420;&#x00A0;&#x0412;&#x00B0;&#x0420;&#x040E;&#x0432;&#x0402;&#x00A0;&#x0420;&#x00A0;&#x0421;&#x2018;&#x0420;&#x040E;&#x0420;&#x040F; -->
                    <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <Grid Background="White">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="520"/>
                                <ColumnDefinition Width="300"/>
                            </Grid.ColumnDefinitions>
                            
                            <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0" Background="White">
                                <TextBlock Text="&#x0418;&#x043D;&#x0444;&#x0438;&#x043B;&#x0442;&#x0440;&#x0430;&#x0446;&#x0438;&#x044F; [1/&#x0447;]" Style="{StaticResource WhiteLabelStyle}"/>
                            </Border>
                            <Border Grid.Column="1" Background="White">
                                <StackPanel>
                                    <TextBox Text="{Binding InfiltrationText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" HorizontalAlignment="Stretch"/>
                                    <TextBlock Text="{Binding InfiltrationError}"
                                               Style="{StaticResource ErrorTextStyle}"
                                               Visibility="{Binding HasInfiltrationError, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- &#x0420;&#x00A0;&#x0421;&#x045F;&#x0420;&#x040E;&#x0420;&#x201A;&#x0420;&#x00A0;&#x0421;&#x2022;&#x0420;&#x00A0;&#x0412;&#x00B5;&#x0420;&#x00A0;&#x0421;&#x201D;&#x0420;&#x040E;&#x0432;&#x0402;&#x0459;&#x0420;&#x00A0;&#x0420;&#x2026;&#x0420;&#x00A0;&#x0412;&#x00B0; &#x0420;&#x040E;&#x0432;&#x0402;&#x0459;&#x0420;&#x00A0;&#x0412;&#x00B5;&#x0420;&#x00A0;&#x0421;&#x0098;&#x0420;&#x00A0;&#x0421;&#x2014;&#x0420;&#x00A0;&#x0412;&#x00B5;&#x0420;&#x040E;&#x0420;&#x201A;&#x0420;&#x00A0;&#x0412;&#x00B0;&#x0420;&#x040E;&#x0432;&#x0402;&#x0459;&#x0420;&#x040E;&#x0421;&#x201C;&#x0420;&#x040E;&#x0420;&#x201A;&#x0420;&#x00A0;&#x0412;&#x00B0; -->
                    <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <Grid Background="White">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="520"/>
                                <ColumnDefinition Width="300"/>
                            </Grid.ColumnDefinitions>
                            
                            <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0" Background="White">
                                <TextBlock Text="&#x041F;&#x0440;&#x043E;&#x0435;&#x043A;&#x0442;&#x043D;&#x0430; &#x0442;&#x0435;&#x043C;&#x043F;&#x0435;&#x0440;&#x0430;&#x0442;&#x0443;&#x0440;&#x0430; [&#x00B0;C]" Style="{StaticResource WhiteLabelStyle}"/>
                            </Border>
                            <Border Grid.Column="1" Background="White">
                                <StackPanel>
                                    <TextBox Text="{Binding DesignTemperatureText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" HorizontalAlignment="Stretch"/>
                                    <TextBlock Text="{Binding DesignTemperatureError}"
                                               Style="{StaticResource ErrorTextStyle}"
                                               Visibility="{Binding HasDesignTemperatureError, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- &#x0420;&#x00A0;&#x0421;&#x045B;&#x0420;&#x00A0;&#x0412;&#x00B5;&#x0420;&#x00A0;&#x0421;&#x0098;&#x0420;&#x00A0;&#x0421;&#x2014;&#x0420;&#x00A0;&#x0412;&#x00B5;&#x0420;&#x040E;&#x0420;&#x201A;&#x0420;&#x00A0;&#x0412;&#x00B0;&#x0420;&#x040E;&#x0432;&#x0402;&#x0459;&#x0420;&#x040E;&#x0421;&#x201C;&#x0420;&#x040E;&#x0420;&#x201A;&#x0420;&#x00A0;&#x0412;&#x00B0; &#x0420;&#x00A0;&#x0420;&#x2026;&#x0420;&#x00A0;&#x0412;&#x00B0; &#x0420;&#x00A0;&#x0421;&#x2014;&#x0420;&#x00A0;&#x0421;&#x2022;&#x0420;&#x00A0;&#x0420;&#x2026;&#x0420;&#x00A0;&#x0421;&#x2018;&#x0420;&#x00A0;&#x0412;&#x00B6;&#x0420;&#x00A0;&#x0412;&#x00B5;&#x0420;&#x00A0;&#x0420;&#x2026;&#x0420;&#x00A0;&#x0421;&#x2018;&#x0420;&#x00A0;&#x0412;&#x00B5; -->
                    <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <Grid Background="White">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="520"/>
                                <ColumnDefinition Width="300"/>
                            </Grid.ColumnDefinitions>
                            
                            <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0" Background="White">
                                <TextBlock Text="&#x0422;&#x0435;&#x043C;&#x043F;&#x0435;&#x0440;&#x0430;&#x0442;&#x0443;&#x0440;&#x0430; &#x043D;&#x0430; &#x043F;&#x043E;&#x043D;&#x0438;&#x0436;&#x0435;&#x043D;&#x0438;&#x0435; [&#x00B0;C]" Style="{StaticResource WhiteLabelStyle}"/>
                            </Border>
                            <Border Grid.Column="1" Background="White">
                                <StackPanel>
                                    <TextBox Text="{Binding ReductionTemperatureText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource EditableTextBoxStyle}" TextAlignment="Center" HorizontalAlignment="Stretch"/>
                                    <TextBlock Text="{Binding ReductionTemperatureError}"
                                               Style="{StaticResource ErrorTextStyle}"
                                               Visibility="{Binding HasReductionTemperatureError, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <Grid Background="#F0F0F0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="520"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0" Background="White">
                                <TextBlock Text="" Style="{StaticResource WhiteLabelStyle}"/>
                            </Border>
                            <Border Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0" Background="White">
                                <TextBlock Text="kWh/m&#x00B2;" FontWeight="SemiBold" FontSize="11"
                                           Padding="10,3" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Stretch"/>
                            </Border>
                            <Border Grid.Column="2" Background="White">
                                <TextBlock Text="kWh" FontWeight="SemiBold" FontSize="11"
                                           Padding="10,3" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Stretch"/>
                            </Border>
                        </Grid>
                    </Border>
                    <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <Grid Background="White">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="520"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0" Background="White">
                                <TextBlock Text="&#x041F;&#x0440;&#x0438;&#x043D;&#x043E;&#x0441;&#x0438; &#x043E;&#x0442; &#x0432;&#x0435;&#x043D;&#x0442;&#x0438;&#x043B;&#x0430;&#x0446;&#x0438;&#x044F;" Style="{StaticResource WhiteLabelStyle}"/>
