<UserControl x:Class="EE.Doklad.Views.ObjectDataSectionEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:EE.Doklad.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    
    <UserControl.Resources>
        <converters:DaysOffSumConverter x:Key="DaysOffSumConverter"/>
        <converters:HeatingSeasonStartDayConverter x:Key="HeatingSeasonStartDayConverter" />
        <converters:HeatingSeasonStartMonthConverter x:Key="HeatingSeasonStartMonthConverter" />
        <converters:HeatingSeasonEndDayConverter x:Key="HeatingSeasonEndDayConverter" />
        <converters:HeatingSeasonEndMonthConverter x:Key="HeatingSeasonEndMonthConverter" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <!-- Заглавие -->
            <TextBlock Text="{Binding Title, FallbackValue='Данни за обекта'}"
                       FontSize="18" 
                       FontWeight="Bold" 
                       Margin="0,0,0,15"/>

            <!-- Описание (свободен текст) -->
            <TextBlock Text="Описание:"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Margin="0,0,0,5"/>
            
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                     MinHeight="80"
                     Padding="10"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     FontSize="11"
                     Margin="0,0,0,20"
                     BorderBrush="#E0E0E0"
                     BorderThickness="1"/>

            <!-- ТАБЛИЦА 1: Данни за обекта -->
            <TextBlock Text="Данни за обекта:"
                       FontSize="14"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <Border x:Name="ObjectDataBorder" BorderBrush="#666" BorderThickness="2" Margin="0,0,0,20">
                <StackPanel>
                    <!-- Row 0: Наименование на сграда -->
                    <Border BorderBrush="#888" BorderThickness="0,0,0,1" Height="37">
                        <Grid Background="White">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Наименование на сграда" Padding="12,10" VerticalAlignment="Center" 
                                       FontWeight="SemiBold" FontSize="12" Background="#F0F0F0"/>
                            <TextBox Grid.Column="1" Text="{Binding BuildingName, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="12,10" VerticalAlignment="Center" Background="White" FontSize="12" 
                                     BorderThickness="0"/>
                        </Grid>
                    </Border>

                    <!-- Row 1: Адрес -->
                    <Border BorderBrush="#888" BorderThickness="0,0,0,1" Height="37">
                        <Grid Background="White">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Адрес" Padding="12,10" VerticalAlignment="Center" 
                                       FontWeight="SemiBold" FontSize="12" Background="#F0F0F0"/>
                            <TextBox Grid.Column="1" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="12,10" VerticalAlignment="Center" Background="White" FontSize="12" 
                                     BorderThickness="0"/>
                        </Grid>
                    </Border>

                    <!-- Row 2: Тип сграда -->
                    <Border BorderBrush="#888" BorderThickness="0,0,0,1" Height="37">
                        <Grid Background="White">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Тип сграда" Padding="12,10" VerticalAlignment="Center" 
                                       FontWeight="SemiBold" FontSize="12" Background="#F0F0F0"/>
                            <ComboBox Grid.Column="1" 
                                      SelectedValue="{Binding BuildingTypeCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Code"
                                      DisplayMemberPath="DisplayName"
                                      Padding="12,10" 
                                      VerticalAlignment="Center" 
                                      Background="White" 
                                      FontSize="12" 
                                      BorderThickness="0">
                                <ComboBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" 
                                                          Foreground="#0066CC" Margin="0,5,0,2"/>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ComboBox.GroupStyle>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Row 3: Собственост -->
                    <Border BorderBrush="#888" BorderThickness="0,0,0,1" Height="37">
                        <Grid Background="White">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Собственост" Padding="12,10" VerticalAlignment="Center" 
                                       FontWeight="SemiBold" FontSize="12" Background="#F0F0F0"/>
                            <TextBox Grid.Column="1" Text="{Binding Ownership, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="12,10" VerticalAlignment="Center" Background="White" FontSize="12" 
                                     BorderThickness="0"/>
                        </Grid>
                    </Border>

                    <!-- Row 4: Година на построяване -->
                    <Border BorderBrush="#888" BorderThickness="0,0,0,1" Height="37">
                        <Grid Background="White">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Година на построяване" Padding="12,10" VerticalAlignment="Center" 
                                       FontWeight="SemiBold" FontSize="12" Background="#F0F0F0"/>
                            <TextBox Grid.Column="1" Text="{Binding YearOfConstruction, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="12,10" VerticalAlignment="Center" Background="White" FontSize="12" 
                                     BorderThickness="0"/>
                        </Grid>
                    </Border>

                    <!-- Row 5: Брой обитатели -->
                    <Border BorderBrush="#888" BorderThickness="0,0,0,1" Height="37">
                        <Grid Background="White">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Брой обитатели" Padding="12,10" VerticalAlignment="Center" 
                                       FontWeight="SemiBold" FontSize="12" Background="#F0F0F0"/>
                            <TextBox Grid.Column="1" Text="{Binding NumberOfOccupants, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="12,10" VerticalAlignment="Center" Background="White" FontSize="12" 
                                     BorderThickness="0"/>
                        </Grid>
                    </Border>

                    <!-- Row 6: Климатична зона -->
                    <Border BorderBrush="#888" BorderThickness="0,0,0,1" Height="37">
                        <Grid Background="White">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Климатична зона" Padding="12,10" VerticalAlignment="Center"
                                       FontWeight="SemiBold" FontSize="12" Background="#F0F0F0"/>
                            <ComboBox Grid.Column="1"
                                      SelectedValue="{Binding ClimateZone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Tag"
                                      Padding="12,10" VerticalAlignment="Center" Background="White" FontSize="12" 
                                      BorderThickness="0">
                                <ComboBoxItem Content="1 - Северно Черноморие" Tag="1" />
                                <ComboBoxItem Content="2 - Добруджа" Tag="2" />
                                <ComboBoxItem Content="3 - Северна България – поречието на р. Дунав" Tag="3" />
                                <ComboBoxItem Content="4 - Северна България - централна част" Tag="4" />
                                <ComboBoxItem Content="5 - Южно Черноморие" Tag="5" />
                                <ComboBoxItem Content="6 - Южна България – централна част" Tag="6" />
                                <ComboBoxItem Content="7 - София и Подбалканската долина" Tag="7" />
                                <ComboBoxItem Content="8 - Южна България" Tag="8" />
                                <ComboBoxItem Content="9 - Югозападна България" Tag="9" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Row 7: Отоплителен сезон (visual layout matched to cooling season) -->
                    <Border BorderBrush="#888" BorderThickness="0,0,0,1" Height="37">
                        <Grid Background="White">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#F0F0F0" Padding="12,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Отоплителен сезон" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                                    <!-- Checkbox to enable/disable heating season (new) -->
                                    <CheckBox x:Name="HeatingSeasonEnabledCheckBox" IsChecked="{Binding HeatingSeasonEnabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="12,0,0,0"
                                              ToolTip="Отметнете за активиране на данните за отоплителен сезон"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Padding="12,6" Background="Transparent" VerticalAlignment="Center" IsEnabled="{Binding HeatingSeasonEnabled}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Начало:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
                                        <TextBlock Text="{Binding HeatingSeasonInfo, Converter={StaticResource HeatingSeasonStartDayConverter}}" Width="40" VerticalAlignment="Center" TextAlignment="Center"/>
                                        <TextBlock Text="{Binding HeatingSeasonInfo, Converter={StaticResource HeatingSeasonStartMonthConverter}}" Width="90" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <TextBlock Text="Край:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
                                        <TextBlock Text="{Binding HeatingSeasonInfo, Converter={StaticResource HeatingSeasonEndDayConverter}}" Width="40" VerticalAlignment="Center" TextAlignment="Center"/>
                                        <TextBlock Text="{Binding HeatingSeasonInfo, Converter={StaticResource HeatingSeasonEndMonthConverter}}" Width="90" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <!-- Row 8: Охладителен сезон (start/end) -->
                    <Border BorderBrush="#888" BorderThickness="0,0,0,1" Height="37">
                        <Grid Background="White">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#F0F0F0" Padding="12,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Охладителен сезон" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                                    <!-- Checkbox to enable/disable cooling season inputs. Bound to model property. -->
                                    <CheckBox x:Name="CoolingSeasonEnabledCheckBox" IsChecked="{Binding CoolingSeasonEnabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="12,0,0,0"
                                              ToolTip="Отметнете за активиране на данните за охладителен сезон"/>
                                </StackPanel>
                            </Border>
                <Border Grid.Column="1" Padding="12,6" Background="Transparent" VerticalAlignment="Center"
                    IsEnabled="{Binding CoolingSeasonEnabled}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Начало:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
                                        <ComboBox x:Name="CoolingStartDayCombo" SelectionChanged="CoolingStartDayCombo_SelectionChanged" SelectedValuePath="Tag" SelectedValue="{Binding CoolingSeasonStartDay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="40" Height="24" VerticalAlignment="Center">
                                            <!-- Days 1..31 -->
                                            <ComboBoxItem Tag="1">1</ComboBoxItem>
                                            <ComboBoxItem Tag="2">2</ComboBoxItem>
                                            <ComboBoxItem Tag="3">3</ComboBoxItem>
                                            <ComboBoxItem Tag="4">4</ComboBoxItem>
                                            <ComboBoxItem Tag="5">5</ComboBoxItem>
                                            <ComboBoxItem Tag="6">6</ComboBoxItem>
                                            <ComboBoxItem Tag="7">7</ComboBoxItem>
                                            <ComboBoxItem Tag="8">8</ComboBoxItem>
                                            <ComboBoxItem Tag="9">9</ComboBoxItem>
                                            <ComboBoxItem Tag="10">10</ComboBoxItem>
                                            <ComboBoxItem Tag="11">11</ComboBoxItem>
                                            <ComboBoxItem Tag="12">12</ComboBoxItem>
                                            <ComboBoxItem Tag="13">13</ComboBoxItem>
                                            <ComboBoxItem Tag="14">14</ComboBoxItem>
                                            <ComboBoxItem Tag="15">15</ComboBoxItem>
                                            <ComboBoxItem Tag="16">16</ComboBoxItem>
                                            <ComboBoxItem Tag="17">17</ComboBoxItem>
                                            <ComboBoxItem Tag="18">18</ComboBoxItem>
                                            <ComboBoxItem Tag="19">19</ComboBoxItem>
                                            <ComboBoxItem Tag="20">20</ComboBoxItem>
                                            <ComboBoxItem Tag="21">21</ComboBoxItem>
                                            <ComboBoxItem Tag="22">22</ComboBoxItem>
                                            <ComboBoxItem Tag="23">23</ComboBoxItem>
                                            <ComboBoxItem Tag="24">24</ComboBoxItem>
                                            <ComboBoxItem Tag="25">25</ComboBoxItem>
                                            <ComboBoxItem Tag="26">26</ComboBoxItem>
                                            <ComboBoxItem Tag="27">27</ComboBoxItem>
                                            <ComboBoxItem Tag="28">28</ComboBoxItem>
                                            <ComboBoxItem Tag="29">29</ComboBoxItem>
                                            <ComboBoxItem Tag="30">30</ComboBoxItem>
                                            <ComboBoxItem Tag="31">31</ComboBoxItem>
                                        </ComboBox>
                                        <ComboBox x:Name="CoolingStartMonthCombo" SelectionChanged="CoolingStartMonthCombo_SelectionChanged" SelectedValuePath="Tag" SelectedValue="{Binding CoolingSeasonStartMonth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="6,0,0,0" Height="24" VerticalAlignment="Center">
                                            <ComboBoxItem Tag="1">януари</ComboBoxItem>
                                            <ComboBoxItem Tag="2">февруари</ComboBoxItem>
                                            <ComboBoxItem Tag="3">март</ComboBoxItem>
                                            <ComboBoxItem Tag="4">април</ComboBoxItem>
                                            <ComboBoxItem Tag="5">май</ComboBoxItem>
                                            <ComboBoxItem Tag="6">юни</ComboBoxItem>
                                            <ComboBoxItem Tag="7">юли</ComboBoxItem>
                                            <ComboBoxItem Tag="8">август</ComboBoxItem>
                                            <ComboBoxItem Tag="9">септември</ComboBoxItem>
                                            <ComboBoxItem Tag="10">октомври</ComboBoxItem>
                                            <ComboBoxItem Tag="11">ноември</ComboBoxItem>
                                            <ComboBoxItem Tag="12">декември</ComboBoxItem>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <TextBlock Text="Край:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
                                        <ComboBox x:Name="CoolingEndDayCombo" SelectionChanged="CoolingEndDayCombo_SelectionChanged" SelectedValuePath="Tag" SelectedValue="{Binding CoolingSeasonEndDay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="40" Height="24" VerticalAlignment="Center">
                                            <!-- Days 1..31 -->
                                            <ComboBoxItem Tag="1">1</ComboBoxItem>
                                            <ComboBoxItem Tag="2">2</ComboBoxItem>
                                            <ComboBoxItem Tag="3">3</ComboBoxItem>
                                            <ComboBoxItem Tag="4">4</ComboBoxItem>
                                            <ComboBoxItem Tag="5">5</ComboBoxItem>
                                            <ComboBoxItem Tag="6">6</ComboBoxItem>
                                            <ComboBoxItem Tag="7">7</ComboBoxItem>
                                            <ComboBoxItem Tag="8">8</ComboBoxItem>
                                            <ComboBoxItem Tag="9">9</ComboBoxItem>
                                            <ComboBoxItem Tag="10">10</ComboBoxItem>
                                            <ComboBoxItem Tag="11">11</ComboBoxItem>
                                            <ComboBoxItem Tag="12">12</ComboBoxItem>
                                            <ComboBoxItem Tag="13">13</ComboBoxItem>
                                            <ComboBoxItem Tag="14">14</ComboBoxItem>
                                            <ComboBoxItem Tag="15">15</ComboBoxItem>
                                            <ComboBoxItem Tag="16">16</ComboBoxItem>
                                            <ComboBoxItem Tag="17">17</ComboBoxItem>
                                            <ComboBoxItem Tag="18">18</ComboBoxItem>
                                            <ComboBoxItem Tag="19">19</ComboBoxItem>
                                            <ComboBoxItem Tag="20">20</ComboBoxItem>
                                            <ComboBoxItem Tag="21">21</ComboBoxItem>
                                            <ComboBoxItem Tag="22">22</ComboBoxItem>
                                            <ComboBoxItem Tag="23">23</ComboBoxItem>
                                            <ComboBoxItem Tag="24">24</ComboBoxItem>
                                            <ComboBoxItem Tag="25">25</ComboBoxItem>
                                            <ComboBoxItem Tag="26">26</ComboBoxItem>
                                            <ComboBoxItem Tag="27">27</ComboBoxItem>
                                            <ComboBoxItem Tag="28">28</ComboBoxItem>
                                            <ComboBoxItem Tag="29">29</ComboBoxItem>
                                            <ComboBoxItem Tag="30">30</ComboBoxItem>
                                            <ComboBoxItem Tag="31">31</ComboBoxItem>
                                        </ComboBox>
                                        <ComboBox x:Name="CoolingEndMonthCombo" SelectionChanged="CoolingEndMonthCombo_SelectionChanged" SelectedValuePath="Tag" SelectedValue="{Binding CoolingSeasonEndMonth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="6,0,0,0" Height="24" VerticalAlignment="Center">
                                            <ComboBoxItem Tag="1">януари</ComboBoxItem>
                                            <ComboBoxItem Tag="2">февруари</ComboBoxItem>
                                            <ComboBoxItem Tag="3">март</ComboBoxItem>
                                            <ComboBoxItem Tag="4">април</ComboBoxItem>
                                            <ComboBoxItem Tag="5">май</ComboBoxItem>
                                            <ComboBoxItem Tag="6">юни</ComboBoxItem>
                                            <ComboBoxItem Tag="7">юли</ComboBoxItem>
                                            <ComboBoxItem Tag="8">август</ComboBoxItem>
                                            <ComboBoxItem Tag="9">септември</ComboBoxItem>
                                            <ComboBoxItem Tag="10">октомври</ComboBoxItem>
                                            <ComboBoxItem Tag="11">ноември</ComboBoxItem>
                                            <ComboBoxItem Tag="12">декември</ComboBoxItem>
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ТАБЛИЦА 2: Графици на сградата -->
            <TextBlock Text="Графици на сградата:"
                       FontSize="14"
                       FontWeight="Bold"
                       Margin="0,20,0,10"/>

            <Border BorderBrush="#666" BorderThickness="2" Margin="0,0,0,20">
                <StackPanel>
                    <!-- Row 0: График обитаване - заглавия -->
                    <Border BorderBrush="#888" BorderThickness="0,0,0,1">
                        <Grid Background="#D0D0D0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="График на обитаване" Padding="12,8" FontWeight="Bold" FontSize="13"/>
                            <Border Grid.Column="1" BorderBrush="#888" BorderThickness="1,0,0,0">
                                <TextBlock Text="Работни дни" Padding="12,8" FontWeight="Bold" FontSize="13" TextAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Column="2" BorderBrush="#888" BorderThickness="1,0,0,0">
                                <TextBlock Text="Събота" Padding="12,8" FontWeight="Bold" FontSize="13" TextAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Column="3" BorderBrush="#888" BorderThickness="1,0,0,0">
                                <TextBlock Text="Неделя" Padding="12,8" FontWeight="Bold" FontSize="13" TextAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Row 1: График обитаване - входни полета -->
                    <Border BorderBrush="#888" BorderThickness="0,0,0,1">
                        <Grid Background="White">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Background="#F0F0F0" Padding="12,10" VerticalAlignment="Center" Text="(ч./ден)"/>
                            <Border Grid.Column="1" BorderBrush="#888" BorderThickness="1,0,0,0">
                                <TextBox Text="{Binding OccupancyWorkdaysHours, UpdateSourceTrigger=PropertyChanged}" Padding="12,10" VerticalAlignment="Center" Background="White" FontSize="12" 
                                         TextAlignment="Center" BorderThickness="0" PreviewTextInput="NumberOnly_PreviewTextInput" DataObject.Pasting="NumberOnly_Pasting"/>
                            </Border>
                            <Border Grid.Column="2" BorderBrush="#888" BorderThickness="1,0,0,0">
                                <TextBox Text="{Binding OccupancySaturdayHours, UpdateSourceTrigger=PropertyChanged}" Padding="12,10" VerticalAlignment="Center" Background="White" FontSize="12" 
                                         TextAlignment="Center" BorderThickness="0" PreviewTextInput="NumberOnly_PreviewTextInput" DataObject.Pasting="NumberOnly_Pasting"/>
                            </Border>
                            <Border Grid.Column="3" BorderBrush="#888" BorderThickness="1,0,0,0">
                                <TextBox Text="{Binding OccupancySundayHours, UpdateSourceTrigger=PropertyChanged}" Padding="12,10" VerticalAlignment="Center" Background="White" FontSize="12" 
                                         TextAlignment="Center" BorderThickness="0" PreviewTextInput="NumberOnly_PreviewTextInput" DataObject.Pasting="NumberOnly_Pasting"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Row 2: График отопление - заглавия -->
                    <Border BorderBrush="#888" BorderThickness="0,0,0,1" Visibility="{Binding HeatingSeasonEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid Background="#D0D0D0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="График на отопление" Padding="12,8" FontWeight="Bold" FontSize="13"/>
                            <Border Grid.Column="1" BorderBrush="#888" BorderThickness="1,0,0,0">
                                <TextBlock Text="Работни дни" Padding="12,8" FontWeight="Bold" FontSize="13" TextAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Column="2" BorderBrush="#888" BorderThickness="1,0,0,0">
                                <TextBlock Text="Събота" Padding="12,8" FontWeight="Bold" FontSize="13" TextAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Column="3" BorderBrush="#888" BorderThickness="1,0,0,0">
                                <TextBlock Text="Неделя" Padding="12,8" FontWeight="Bold" FontSize="13" TextAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Row 3: График отопление - входни полета -->
                    <Border BorderBrush="#888" BorderThickness="0,0,0,1" Visibility="{Binding HeatingSeasonEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid Background="White">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Background="#F0F0F0" Padding="12,10" VerticalAlignment="Center" Text="(ч./ден)"/>
                                <Border Grid.Column="1" BorderBrush="#888" BorderThickness="1,0,0,0">
                                <TextBox Text="{Binding HeatingWorkdaysHours, UpdateSourceTrigger=PropertyChanged}" Padding="12,10" VerticalAlignment="Center" Background="White" FontSize="12" 
                                         TextAlignment="Center" BorderThickness="0" PreviewTextInput="NumberOnly_PreviewTextInput" DataObject.Pasting="NumberOnly_Pasting"/>
                            </Border>
                                <Border Grid.Column="2" BorderBrush="#888" BorderThickness="1,0,0,0">
                                <TextBox Text="{Binding HeatingSaturdayHours, UpdateSourceTrigger=PropertyChanged}" Padding="12,10" VerticalAlignment="Center" Background="White" FontSize="12" 
                                         TextAlignment="Center" BorderThickness="0" PreviewTextInput="NumberOnly_PreviewTextInput" DataObject.Pasting="NumberOnly_Pasting"/>
                            </Border>
                                <Border Grid.Column="3" BorderBrush="#888" BorderThickness="1,0,0,0">
                                <TextBox Text="{Binding HeatingSundayHours, UpdateSourceTrigger=PropertyChanged}" Padding="12,10" VerticalAlignment="Center" Background="White" FontSize="12" 
                                         TextAlignment="Center" BorderThickness="0" PreviewTextInput="NumberOnly_PreviewTextInput" DataObject.Pasting="NumberOnly_Pasting"/>
                            </Border>
                        </Grid>
                    </Border>
                    
                    <!-- Row 4: График охладяне - заглавия -->
                    <Border BorderBrush="#888" BorderThickness="0,0,0,1" Visibility="{Binding CoolingSeasonEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid Background="#D0D0D0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="График за охлаждане" Padding="12,8" FontWeight="Bold" FontSize="13"/>
                            <Border Grid.Column="1" BorderBrush="#888" BorderThickness="1,0,0,0">
                                <TextBlock Text="Работни дни" Padding="12,8" FontWeight="Bold" FontSize="13" TextAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Column="2" BorderBrush="#888" BorderThickness="1,0,0,0">
                                <TextBlock Text="Събота" Padding="12,8" FontWeight="Bold" FontSize="13" TextAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Column="3" BorderBrush="#888" BorderThickness="1,0,0,0">
                                <TextBlock Text="Неделя" Padding="12,8" FontWeight="Bold" FontSize="13" TextAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Row 5: График охлаждане - входни полета -->
                    <Border BorderBrush="#888" BorderThickness="0,0,0,1" Visibility="{Binding CoolingSeasonEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid Background="White">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Background="#F0F0F0" Padding="12,10" VerticalAlignment="Center" Text="(ч./ден)"/>
                            <Border Grid.Column="1" BorderBrush="#888" BorderThickness="1,0,0,0">
                                <TextBox Text="{Binding CoolingWorkdaysHours, UpdateSourceTrigger=PropertyChanged}" Padding="12,10" VerticalAlignment="Center" Background="White" FontSize="12" 
                                         TextAlignment="Center" BorderThickness="0" PreviewTextInput="NumberOnly_PreviewTextInput" DataObject.Pasting="NumberOnly_Pasting"/>
                            </Border>
                            <Border Grid.Column="2" BorderBrush="#888" BorderThickness="1,0,0,0">
                                <TextBox Text="{Binding CoolingSaturdayHours, UpdateSourceTrigger=PropertyChanged}" Padding="12,10" VerticalAlignment="Center" Background="White" FontSize="12" 
                                         TextAlignment="Center" BorderThickness="0" PreviewTextInput="NumberOnly_PreviewTextInput" DataObject.Pasting="NumberOnly_Pasting"/>
                            </Border>
                            <Border Grid.Column="3" BorderBrush="#888" BorderThickness="1,0,0,0">
                                <TextBox Text="{Binding CoolingSundayHours, UpdateSourceTrigger=PropertyChanged}" Padding="12,10" VerticalAlignment="Center" Background="White" FontSize="12" 
                                         TextAlignment="Center" BorderThickness="0" PreviewTextInput="NumberOnly_PreviewTextInput" DataObject.Pasting="NumberOnly_Pasting"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Row 6: График вентилация - заглавия -->
                    <Border BorderBrush="#888" BorderThickness="0,0,0,1" Visibility="{Binding HeatingSeasonEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid Background="#D0D0D0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="График за вентилация Отопление" Padding="12,8" FontWeight="Bold" FontSize="13"/>
                            <Border Grid.Column="1" BorderBrush="#888" BorderThickness="1,0,0,0">
                                <TextBlock Text="Работни дни" Padding="12,8" FontWeight="Bold" FontSize="13" TextAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Column="2" BorderBrush="#888" BorderThickness="1,0,0,0">
                                <TextBlock Text="Събота" Padding="12,8" FontWeight="Bold" FontSize="13" TextAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Column="3" BorderBrush="#888" BorderThickness="1,0,0,0">
                                <TextBlock Text="Неделя" Padding="12,8" FontWeight="Bold" FontSize="13" TextAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Row 7: График вентилация - входни полета -->
                    <Border BorderBrush="#888" BorderThickness="0,0,0,1" Visibility="{Binding HeatingSeasonEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid Background="White">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Background="#F0F0F0" Padding="12,10" VerticalAlignment="Center" Text="(ч./ден)"/>
                                <Border Grid.Column="1" BorderBrush="#888" BorderThickness="1,0,0,0">
                                <TextBox Text="{Binding VentilationWorkdaysHours, UpdateSourceTrigger=PropertyChanged}" Padding="12,10" VerticalAlignment="Center" Background="White" FontSize="12" 
                                         TextAlignment="Center" BorderThickness="0" PreviewTextInput="NumberOnly_PreviewTextInput" DataObject.Pasting="NumberOnly_Pasting"/>
                            </Border>
                                <Border Grid.Column="2" BorderBrush="#888" BorderThickness="1,0,0,0">
                                <TextBox Text="{Binding VentilationSaturdayHours, UpdateSourceTrigger=PropertyChanged}" Padding="12,10" VerticalAlignment="Center" Background="White" FontSize="12" 
                                         TextAlignment="Center" BorderThickness="0" PreviewTextInput="NumberOnly_PreviewTextInput" DataObject.Pasting="NumberOnly_Pasting"/>
                            </Border>
                                <Border Grid.Column="3" BorderBrush="#888" BorderThickness="1,0,0,0">
                                <TextBox Text="{Binding VentilationSundayHours, UpdateSourceTrigger=PropertyChanged}" Padding="12,10" VerticalAlignment="Center" Background="White" FontSize="12" 
                                         TextAlignment="Center" BorderThickness="0" PreviewTextInput="NumberOnly_PreviewTextInput" DataObject.Pasting="NumberOnly_Pasting"/>
                            </Border>
                        </Grid>
                    </Border>
                    
                    <!-- Row 8: График Вентилация Охлаждане - заглавия -->
                    <Border BorderBrush="#888" BorderThickness="0,0,0,1" Visibility="{Binding CoolingSeasonEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid Background="#D0D0D0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="График за вентилация Охлаждане" Padding="12,8" FontWeight="Bold" FontSize="13"/>
                            <Border Grid.Column="1" BorderBrush="#888" BorderThickness="1,0,0,0">
                                <TextBlock Text="Работни дни" Padding="12,8" FontWeight="Bold" FontSize="13" TextAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Column="2" BorderBrush="#888" BorderThickness="1,0,0,0">
                                <TextBlock Text="Събота" Padding="12,8" FontWeight="Bold" FontSize="13" TextAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Column="3" BorderBrush="#888" BorderThickness="1,0,0,0">
                                <TextBlock Text="Неделя" Padding="12,8" FontWeight="Bold" FontSize="13" TextAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Row 9: График Вентилация Охлаждане - входни полета -->
                    <Border BorderBrush="#888" BorderThickness="0,0,0,1" Visibility="{Binding CoolingSeasonEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid Background="White">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Background="#F0F0F0" Padding="12,10" VerticalAlignment="Center" Text="(ч./ден)"/>
                            <Border Grid.Column="1" BorderBrush="#888" BorderThickness="1,0,0,0">
                                <TextBox Text="{Binding VentilationCoolingWorkdaysHours, UpdateSourceTrigger=PropertyChanged}" Padding="12,10" VerticalAlignment="Center" Background="White" FontSize="12" 
                                         TextAlignment="Center" BorderThickness="0" PreviewTextInput="NumberOnly_PreviewTextInput" DataObject.Pasting="NumberOnly_Pasting"/>
                            </Border>
                            <Border Grid.Column="2" BorderBrush="#888" BorderThickness="1,0,0,0">
                                <TextBox Text="{Binding VentilationCoolingSaturdayHours, UpdateSourceTrigger=PropertyChanged}" Padding="12,10" VerticalAlignment="Center" Background="White" FontSize="12" 
                                         TextAlignment="Center" BorderThickness="0" PreviewTextInput="NumberOnly_PreviewTextInput" DataObject.Pasting="NumberOnly_Pasting"/>
                            </Border>
                            <Border Grid.Column="3" BorderBrush="#888" BorderThickness="1,0,0,0">
                                <TextBox Text="{Binding VentilationCoolingSundayHours, UpdateSourceTrigger=PropertyChanged}" Padding="12,10" VerticalAlignment="Center" Background="White" FontSize="12" 
                                         TextAlignment="Center" BorderThickness="0" PreviewTextInput="NumberOnly_PreviewTextInput" DataObject.Pasting="NumberOnly_Pasting"/>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ТАБЛИЦА 3: Площи и Обеми -->
            <!-- МЕСЕЧНА ТАБЛИЦА: Дни почивни по месеци -->
            <TextBlock Text="Дни почивни по месеци:" FontSize="14" FontWeight="Bold" Margin="0,30,0,10"/>

            <Border BorderBrush="#666" BorderThickness="2" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>

                    <!-- Header row: month names -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Месец" Padding="12,8" FontWeight="Bold" FontSize="13" Background="#D0D0D0"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Ян" Padding="6" FontWeight="Bold" FontSize="13" TextAlignment="Center" Background="#D0D0D0"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Фев" Padding="6" FontWeight="Bold" FontSize="13" TextAlignment="Center" Background="#D0D0D0"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="Март" Padding="6" FontWeight="Bold" FontSize="13" TextAlignment="Center" Background="#D0D0D0"/>
                    <TextBlock Grid.Row="0" Grid.Column="4" Text="Апр" Padding="6" FontWeight="Bold" FontSize="13" TextAlignment="Center" Background="#D0D0D0"/>
                    <TextBlock Grid.Row="0" Grid.Column="5" Text="Май" Padding="6" FontWeight="Bold" FontSize="13" TextAlignment="Center" Background="#D0D0D0"/>
                    <TextBlock Grid.Row="0" Grid.Column="6" Text="Юни" Padding="6" FontWeight="Bold" FontSize="13" TextAlignment="Center" Background="#D0D0D0"/>
                    <TextBlock Grid.Row="0" Grid.Column="7" Text="Юли" Padding="6" FontWeight="Bold" FontSize="13" TextAlignment="Center" Background="#D0D0D0"/>
                    <TextBlock Grid.Row="0" Grid.Column="8" Text="Авг" Padding="6" FontWeight="Bold" FontSize="13" TextAlignment="Center" Background="#D0D0D0"/>
                    <TextBlock Grid.Row="0" Grid.Column="9" Text="Септ" Padding="6" FontWeight="Bold" FontSize="13" TextAlignment="Center" Background="#D0D0D0"/>
                    <TextBlock Grid.Row="0" Grid.Column="10" Text="Окт" Padding="6" FontWeight="Bold" FontSize="13" TextAlignment="Center" Background="#D0D0D0"/>
                    <TextBlock Grid.Row="0" Grid.Column="11" Text="Ноем" Padding="6" FontWeight="Bold" FontSize="13" TextAlignment="Center" Background="#D0D0D0"/>
                    <TextBlock Grid.Row="0" Grid.Column="12" Text="Дек" Padding="6" FontWeight="Bold" FontSize="13" TextAlignment="Center" Background="#D0D0D0"/>
                    <TextBlock Grid.Row="0" Grid.Column="13" Text="Сума" Padding="6" FontWeight="Bold" FontSize="13" TextAlignment="Center" Background="#D0D0D0"/>

                    <!-- Input row: textboxes for each month -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Почивни дни" Padding="12,10" FontWeight="SemiBold" Background="#F0F0F0" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Padding="6" TextAlignment="Center" Text="{Binding DaysOffJanuary, UpdateSourceTrigger=PropertyChanged}"
                             PreviewTextInput="NumberOnly_PreviewTextInput" DataObject.Pasting="NumberOnly_Pasting"/>
                    <TextBox Grid.Row="1" Grid.Column="2" Padding="6" TextAlignment="Center" Text="{Binding DaysOffFebruary, UpdateSourceTrigger=PropertyChanged}"
                             PreviewTextInput="NumberOnly_PreviewTextInput" DataObject.Pasting="NumberOnly_Pasting"/>
                    <TextBox Grid.Row="1" Grid.Column="3" Padding="6" TextAlignment="Center" Text="{Binding DaysOffMarch, UpdateSourceTrigger=PropertyChanged}"
                             PreviewTextInput="NumberOnly_PreviewTextInput" DataObject.Pasting="NumberOnly_Pasting"/>
                    <TextBox Grid.Row="1" Grid.Column="4" Padding="6" TextAlignment="Center" Text="{Binding DaysOffApril, UpdateSourceTrigger=PropertyChanged}"
                             PreviewTextInput="NumberOnly_PreviewTextInput" DataObject.Pasting="NumberOnly_Pasting"/>
                    <TextBox Grid.Row="1" Grid.Column="5" Padding="6" TextAlignment="Center" Text="{Binding DaysOffMay, UpdateSourceTrigger=PropertyChanged}"
                             PreviewTextInput="NumberOnly_PreviewTextInput" DataObject.Pasting="NumberOnly_Pasting"/>
                    <TextBox Grid.Row="1" Grid.Column="6" Padding="6" TextAlignment="Center" Text="{Binding DaysOffJune, UpdateSourceTrigger=PropertyChanged}"
                             PreviewTextInput="NumberOnly_PreviewTextInput" DataObject.Pasting="NumberOnly_Pasting"/>
                    <TextBox Grid.Row="1" Grid.Column="7" Padding="6" TextAlignment="Center" Text="{Binding DaysOffJuly, UpdateSourceTrigger=PropertyChanged}"
                             PreviewTextInput="NumberOnly_PreviewTextInput" DataObject.Pasting="NumberOnly_Pasting"/>
                    <TextBox Grid.Row="1" Grid.Column="8" Padding="6" TextAlignment="Center" Text="{Binding DaysOffAugust, UpdateSourceTrigger=PropertyChanged}"
                             PreviewTextInput="NumberOnly_PreviewTextInput" DataObject.Pasting="NumberOnly_Pasting"/>
                    <TextBox Grid.Row="1" Grid.Column="9" Padding="6" TextAlignment="Center" Text="{Binding DaysOffSeptember, UpdateSourceTrigger=PropertyChanged}"
                             PreviewTextInput="NumberOnly_PreviewTextInput" DataObject.Pasting="NumberOnly_Pasting"/>
                    <TextBox Grid.Row="1" Grid.Column="10" Padding="6" TextAlignment="Center" Text="{Binding DaysOffOctober, UpdateSourceTrigger=PropertyChanged}"
                             PreviewTextInput="NumberOnly_PreviewTextInput" DataObject.Pasting="NumberOnly_Pasting"/>
                    <TextBox Grid.Row="1" Grid.Column="11" Padding="6" TextAlignment="Center" Text="{Binding DaysOffNovember, UpdateSourceTrigger=PropertyChanged}"
                             PreviewTextInput="NumberOnly_PreviewTextInput" DataObject.Pasting="NumberOnly_Pasting"/>
                    <TextBox Grid.Row="1" Grid.Column="12" Padding="6" TextAlignment="Center" Text="{Binding DaysOffDecember, UpdateSourceTrigger=PropertyChanged}"
                             PreviewTextInput="NumberOnly_PreviewTextInput" DataObject.Pasting="NumberOnly_Pasting"/>
                    <TextBlock Grid.Row="1" Grid.Column="13" Padding="6" TextAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource DaysOffSumConverter}">
                                <Binding Path="DaysOffJanuary"/>
                                <Binding Path="DaysOffFebruary"/>
                                <Binding Path="DaysOffMarch"/>
                                <Binding Path="DaysOffApril"/>
                                <Binding Path="DaysOffMay"/>
                                <Binding Path="DaysOffJune"/>
                                <Binding Path="DaysOffJuly"/>
                                <Binding Path="DaysOffAugust"/>
                                <Binding Path="DaysOffSeptember"/>
                                <Binding Path="DaysOffOctober"/>
                                <Binding Path="DaysOffNovember"/>
                                <Binding Path="DaysOffDecember"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </Grid>
            </Border>

            <TextBlock Text="Площи и Обеми:"
                       FontSize="14"
                       FontWeight="Bold"
                       Margin="0,30,0,10"/>

            <Border BorderBrush="#666" BorderThickness="2" Margin="0,0,0,20">
                <StackPanel>
                    <!-- Header row -->
                    <Border BorderBrush="#888" BorderThickness="0,0,0,1">
                        <Grid Background="#D0D0D0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Параметър" Padding="12,8" FontWeight="Bold" FontSize="13"/>
                            <Border Grid.Column="1" BorderBrush="#888" BorderThickness="1,0,0,0">
                                <TextBlock Text="Отопление" Padding="12,8" FontWeight="Bold" FontSize="13" TextAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Column="2" BorderBrush="#888" BorderThickness="1,0,0,0">
                                <TextBlock Text="Охлаждане" Padding="12,8" FontWeight="Bold" FontSize="13" TextAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Row 1: Застроена площ -->
                    <Border BorderBrush="#888" BorderThickness="0,0,0,1">
                        <Grid Background="White">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Застроена площ [m²]" Padding="12,10" VerticalAlignment="Center" 
                                       FontWeight="SemiBold" FontSize="12" Background="#F0F0F0"/>
                            <Border Grid.Column="1" BorderBrush="#888" BorderThickness="1,0,0,0">
                                <TextBox Text="{Binding BuiltUpArea, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="12,10" VerticalAlignment="Center" Background="White" FontSize="12" 
                                         TextAlignment="Center" BorderThickness="0"/>
                            </Border>
                            <Border Grid.Column="2" BorderBrush="#888" BorderThickness="1,0,0,0" Background="#F5F5F5">
                                <TextBlock Text="–" Padding="12,10" VerticalAlignment="Center" FontSize="12" 
                                           TextAlignment="Center" Foreground="#999"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Row 2: РЗП -->
                    <Border BorderBrush="#888" BorderThickness="0,0,0,1">
                        <Grid Background="White">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="РЗП [m²]" Padding="12,10" VerticalAlignment="Center" 
                                       FontWeight="SemiBold" FontSize="12" Background="#F0F0F0"/>
                            <Border Grid.Column="1" BorderBrush="#888" BorderThickness="1,0,0,0">
                                <TextBox Text="{Binding TotalFloorArea, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="12,10" VerticalAlignment="Center" Background="White" FontSize="12" 
                                         TextAlignment="Center" BorderThickness="0"/>
                            </Border>
                            <Border Grid.Column="2" BorderBrush="#888" BorderThickness="1,0,0,0" Background="#F5F5F5">
                                <TextBlock Text="–" Padding="12,10" VerticalAlignment="Center" FontSize="12" 
                                           TextAlignment="Center" Foreground="#999"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Row 3: Отопляема / Охлаждаема площ -->
                    <Border BorderBrush="#888" BorderThickness="0,0,0,1">
                        <Grid Background="White">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Отопляема / Охлаждаема площ [m²]" Padding="12,10" VerticalAlignment="Center" 
                                       FontWeight="SemiBold" FontSize="12" Background="#F0F0F0"/>
                            <Border Grid.Column="1" BorderBrush="#888" BorderThickness="1,0,0,0">
                                <TextBox Text="{Binding HeatedArea, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="12,10" VerticalAlignment="Center" Background="White" FontSize="12" 
                                         TextAlignment="Center" BorderThickness="0"/>
                            </Border>
                            <Border Grid.Column="2" BorderBrush="#888" BorderThickness="1,0,0,0">
                                <TextBox Text="{Binding CooledArea, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="12,10" VerticalAlignment="Center" Background="White" FontSize="12" 
                                         TextAlignment="Center" BorderThickness="0"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Row 4: Нетен обем -->
                    <Border BorderBrush="#888" BorderThickness="0,0,0,1">
                        <Grid Background="White">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Нетен отопляем / охлаждаем обем [m³]" Padding="12,10" VerticalAlignment="Center" 
                                       FontWeight="SemiBold" FontSize="12" Background="#F0F0F0"/>
                            <Border Grid.Column="1" BorderBrush="#888" BorderThickness="1,0,0,0">
                                <TextBox Text="{Binding NetHeatedVolume, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="12,10" VerticalAlignment="Center" Background="White" FontSize="12" 
                                         TextAlignment="Center" BorderThickness="0"/>
                            </Border>
                            <Border Grid.Column="2" BorderBrush="#888" BorderThickness="1,0,0,0">
                                <TextBox Text="{Binding NetCooledVolume, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="12,10" VerticalAlignment="Center" Background="White" FontSize="12" 
                                         TextAlignment="Center" BorderThickness="0"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Row 5: Брутен обем -->
                    <Border BorderBrush="#888" BorderThickness="0,0,0,1">
                        <Grid Background="White">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Брутен отопляем / охлаждаем обем [m³]" Padding="12,10" VerticalAlignment="Center" 
                                       FontWeight="SemiBold" FontSize="12" Background="#F0F0F0"/>
                            <Border Grid.Column="1" BorderBrush="#888" BorderThickness="1,0,0,0">
                                <TextBox Text="{Binding GrossHeatedVolume, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="12,10" VerticalAlignment="Center" Background="White" FontSize="12" 
                                         TextAlignment="Center" BorderThickness="0"/>
                            </Border>
                            <Border Grid.Column="2" BorderBrush="#888" BorderThickness="1,0,0,0">
                                <TextBox Text="{Binding GrossCooledVolume, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="12,10" VerticalAlignment="Center" Background="White" FontSize="12" 
                                         TextAlignment="Center" BorderThickness="0"/>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock Text="Всички полета могат да бъдат редактирани. Ако няма налична информация, напишете '–'."
                       Foreground="Gray"
                       FontSize="11"
                       Margin="0,10,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
