<UserControl x:Class="EE.Doklad.Views.WarmRoofDetailControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:EE.Doklad.Converters"
             xmlns:views="clr-namespace:EE.Doklad.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <converters:AttachmentToImageSourceConverter x:Key="AttachmentToImageSourceConverter"/>
        <converters:AttachmentToVisibilityConverter x:Key="AttachmentToVisibilityConverter"/>
        <converters:FlexibleDoubleConverter x:Key="FlexibleDoubleConverter"/>
    </UserControl.Resources>
    <Border BorderBrush="#CCCCCC" BorderThickness="1" Padding="10" Margin="0,0,0,15">
        <StackPanel>
            <DockPanel Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Content="Премахни" Padding="6,2" Background="#F44336" Foreground="White" BorderThickness="0"
                        Click="RemoveDetail_Click"/>
                <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" FontWeight="Bold" FontSize="13"/>
            </DockPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Rsi:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox Width="60" Text="{Binding WarmDetail.Rsi, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}" Margin="0,0,10,0"/>
                <TextBlock Text="Rse:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox Width="60" Text="{Binding WarmDetail.Rse, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}" Margin="0,0,10,0"/>
                <TextBlock Text="Rw:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock Text="{Binding WarmDetail.Rw, StringFormat=0.000}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Rtotal:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock Text="{Binding WarmDetail.Rtotal, StringFormat=0.000}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Uw:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock Text="{Binding WarmDetail.Uw, StringFormat=0.000}" VerticalAlignment="Center" FontWeight="Bold"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <StackPanel Width="520">
                    <DataGrid ItemsSource="{Binding WarmDetail.Layers}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              Margin="0,0,0,5">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Материал" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding MaterialOptions}"
                                                  SelectedValuePath="Id"
                                                  DisplayMemberPath="Display"
                                                  SelectedValue="{Binding SelectedMaterialId, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEditable="True"
                                                  IsTextSearchEnabled="True"
                                                  StaysOpenOnEdit="True"
                                                  TextSearch.TextPath="Display"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="δ (m)" Binding="{Binding Thickness, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}" Width="90"/>
                            <DataGridTextColumn Header="λ (W/mK)" Binding="{Binding Lambda, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}" Width="90" IsReadOnly="True"/>
                            <DataGridTextColumn Header="R" Binding="{Binding R, StringFormat=0.000}" IsReadOnly="True" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="+ Слой" Padding="6,2" Margin="0,0,10,0" Background="#4CAF50" Foreground="White" BorderThickness="0"
                                Click="AddLayer_Click"/>
                        <Button Content="Премахни слой" Padding="6,2" Background="#F44336" Foreground="White" BorderThickness="0"
                                Click="RemoveLayer_Click"/>
                    </StackPanel>
                </StackPanel>

                <Border BorderBrush="#AAAAAA" BorderThickness="1" Margin="20,0,0,0" Padding="8" Width="220" Height="220">
                    <StackPanel>
                        <TextBlock Text="Схема" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <Border BorderBrush="#DDDDDD" BorderThickness="1" Height="130" VerticalAlignment="Center">
                            <Grid>
                                <Image Stretch="Uniform"
                                       Visibility="{Binding SchemeAttachment, Converter={StaticResource AttachmentToVisibilityConverter}}"
                                       Source="{Binding SchemeAttachment, Converter={StaticResource AttachmentToImageSourceConverter}}"/>
                                <TextBlock Text="Няма изображение" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding SchemeAttachment, Converter={StaticResource AttachmentToVisibilityConverter}, ConverterParameter=Inverse}"/>
                            </Grid>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                            <Button Content="Качи" Padding="6,2" Margin="0,0,8,0" Background="#2196F3" Foreground="White" BorderThickness="0"
                                    Click="UploadScheme_Click"/>
                            <Button Content="Премахни" Padding="6,2" Background="#F44336" Foreground="White" BorderThickness="0"
                                    Click="RemoveScheme_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
