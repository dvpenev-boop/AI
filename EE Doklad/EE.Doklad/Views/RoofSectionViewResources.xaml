<ResourceDictionary x:Class="EE.Doklad.Views.RoofSectionViewResources"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:EE.Doklad.Views"
                    xmlns:models="clr-namespace:EE.Doklad.Models"
                    xmlns:converters="clr-namespace:EE.Doklad.Converters">
    <converters:AttachmentToImageSourceConverter x:Key="AttachmentToImageSourceConverter"/>
    <converters:AttachmentToVisibilityConverter x:Key="AttachmentToVisibilityConverter"/>
    <converters:FlexibleDoubleConverter x:Key="FlexibleDoubleConverter"/>
    <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    <!-- Unselected Roof Detail Template -->
    <DataTemplate x:Key="UnselectedRoofDetailTemplate">
        <Border BorderBrush="#CCCCCC" BorderThickness="1" Padding="10" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Изберете тип покрив от диалога." FontWeight="SemiBold" FontSize="12"/>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- Warm Roof Detail Template -->
    <DataTemplate x:Key="WarmRoofDetailTemplate">
        <Border BorderBrush="#CCCCCC" BorderThickness="1" Padding="10" Margin="0,0,0,15">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" FontWeight="Bold" FontSize="13"/>
                </DockPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Rsi:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Width="60" Text="{Binding WarmDetail.Rsi, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}" Margin="0,0,10,0"/>
                    <TextBlock Text="Rse:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Width="60" Text="{Binding WarmDetail.Rse, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}" Margin="0,0,10,0"/>
                    <TextBlock Text="Rw:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding WarmDetail.Rw, StringFormat=0.000}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Rtotal:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding WarmDetail.Rtotal, StringFormat=0.000}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Uw:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding WarmDetail.Uw, StringFormat=0.000}" VerticalAlignment="Center" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <StackPanel Width="520">
                        <DataGrid ItemsSource="{Binding WarmDetail.Layers}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  Margin="0,0,0,5">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Материал" Binding="{Binding Material, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                <DataGridTextColumn Header="δ (m)" Binding="{Binding Thickness, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}" Width="90"/>
                                <DataGridTextColumn Header="λ (W/mK)" Binding="{Binding Lambda, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}" Width="90"/>
                                <DataGridTextColumn Header="R" Binding="{Binding R, StringFormat=0.000}" IsReadOnly="True" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="+ Слой" Padding="6,2" Margin="0,0,10,0" Background="#4CAF50" Foreground="White" BorderThickness="0"
                                    Tag="{Binding WarmDetail}" Click="AddWarmLayer_Click"/>
                            <Button Content="Премахни слой" Padding="6,2" Background="#F44336" Foreground="White" BorderThickness="0"
                                    Tag="{Binding WarmDetail}" Click="RemoveWarmLayer_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <Border BorderBrush="#AAAAAA" BorderThickness="1" Margin="20,0,0,0" Padding="8" Width="220" Height="220">
                        <StackPanel>
                            <TextBlock Text="Схема" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <Border BorderBrush="#DDDDDD" BorderThickness="1" Height="130" VerticalAlignment="Center">
                                <Grid>
                                    <Image Stretch="Uniform"
                                           Visibility="{Binding SchemeAttachment, Converter={StaticResource AttachmentToVisibilityConverter}}"
                                           Source="{Binding SchemeAttachment, Converter={StaticResource AttachmentToImageSourceConverter}}"/>
                                    <TextBlock Text="Няма изображение" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding SchemeAttachment, Converter={StaticResource AttachmentToVisibilityConverter}, ConverterParameter=Inverse}"/>
                                </Grid>
                            </Border>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                <Button Content="Качи" Padding="6,2" Margin="0,0,8,0" Background="#2196F3" Foreground="White" BorderThickness="0"
                                        Tag="{Binding}" Click="UploadScheme_Click"/>
                                <Button Content="Премахни" Padding="6,2" Background="#F44336" Foreground="White" BorderThickness="0"
                                        Tag="{Binding}" Click="RemoveScheme_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- Cold Roof Detail Template -->
    <DataTemplate x:Key="ColdRoofDetailTemplate">
        <Border BorderBrush="#CCCCCC" BorderThickness="1" Padding="10" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>

                <TextBlock Text="Геометрия на подпокривното пространство" FontWeight="Bold" Margin="0,6,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="V′ (m³):" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Width="80" Text="{Binding ColdDetail.Vp, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}" Margin="0,0,10,0"/>
                    <TextBlock Text="A′ (m²):" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Width="80" Text="{Binding ColdDetail.Ap, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}" Margin="0,0,10,0"/>
                    <TextBlock Text="δвс (m):" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding ColdDetail.Deltavc, StringFormat=0.000, TargetNullValue='—'}" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="Площи" FontWeight="Bold" Margin="0,6,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="A1 (m²):" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Width="80" Text="{Binding ColdDetail.A1, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}" Margin="0,0,10,0"/>
                    <TextBlock Text="A2 (m²):" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Width="80" Text="{Binding ColdDetail.A2, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}" Margin="0,0,10,0"/>
                    <TextBlock Text="Aw (m²):" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Width="80" Text="{Binding ColdDetail.Aw, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}"/>
                </StackPanel>

                <TextBlock Text="Вентилация" FontWeight="Bold" Margin="0,6,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Тип:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ComboBox Width="140" SelectedValuePath="Tag" SelectedValue="{Binding ColdDetail.SpaceType, UpdateSourceTrigger=PropertyChanged}">
                        <ComboBoxItem Content="уплътнено" Tag="{x:Static models:ColdRoofSpaceType.Sealed}"/>
                        <ComboBoxItem Content="неуплътнено" Tag="{x:Static models:ColdRoofSpaceType.Unsealed}"/>
                    </ComboBox>
                    <TextBlock Text="n (h⁻¹):" VerticalAlignment="Center" Margin="10,0,5,0"/>
                    <TextBox Width="60" Text="{Binding ColdDetail.N, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}" Margin="0,0,10,0"/>
                    <TextBlock Text="V (m³):" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Width="80" Text="{Binding ColdDetail.V, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}"/>
                </StackPanel>

                <TextBlock Text="Температури" FontWeight="Bold" Margin="0,6,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="θi (°C):" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Width="80" Text="{Binding ColdDetail.Ti, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.0}" Margin="0,0,10,0"/>
                    <TextBlock Text="θe (°C):" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Width="80" Text="{Binding ColdDetail.Te, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.0}" IsReadOnly="{Binding ColdDetail.ManualTeInput, Converter={StaticResource InverseBooleanConverter}}"/>
                    <CheckBox Content="Ръчно въвеждане" Margin="10,0,0,0" VerticalAlignment="Center" IsChecked="{Binding ColdDetail.ManualTeInput, Mode=TwoWay}"/>
                </StackPanel>

                <TextBlock Text="Таванска плоча (U1)" FontWeight="Bold" Margin="0,6,0,4"/>
                <DataGrid ItemsSource="{Binding ColdDetail.U1.Layers}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          Margin="0,0,0,5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Материал" Binding="{Binding Material, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        <DataGridTextColumn Header="δ (m)" Binding="{Binding Thickness, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}" Width="90"/>
                        <DataGridTextColumn Header="λ (W/mK)" Binding="{Binding Lambda, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}" Width="90"/>
                        <DataGridTextColumn Header="R" Binding="{Binding R, StringFormat=0.000}" IsReadOnly="True" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="+ Слой" Padding="6,2" Margin="0,0,10,0" Background="#4CAF50" Foreground="White" BorderThickness="0"
                            Tag="{Binding ColdDetail.U1}" Click="AddColdLayer_Click"/>
                    <Button Content="Премахни слой" Padding="6,2" Background="#F44336" Foreground="White" BorderThickness="0"
                            Tag="{Binding ColdDetail.U1}" Click="RemoveColdLayer_Click"/>
                    <TextBlock Text="U1:" VerticalAlignment="Center" Margin="15,0,5,0"/>
                    <TextBlock Text="{Binding ColdDetail.U1.Uw, StringFormat=0.000}" VerticalAlignment="Center" FontWeight="Bold"/>
                </StackPanel>

                <TextBlock Text="Покривна плоча (U2)" FontWeight="Bold" Margin="0,6,0,4"/>
                <DataGrid ItemsSource="{Binding ColdDetail.U2.Layers}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          Margin="0,0,0,5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Материал" Binding="{Binding Material, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        <DataGridTextColumn Header="δ (m)" Binding="{Binding Thickness, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}" Width="90"/>
                        <DataGridTextColumn Header="λ (W/mK)" Binding="{Binding Lambda, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}" Width="90"/>
                        <DataGridTextColumn Header="R" Binding="{Binding R, StringFormat=0.000}" IsReadOnly="True" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="+ Слой" Padding="6,2" Margin="0,0,10,0" Background="#4CAF50" Foreground="White" BorderThickness="0"
                            Tag="{Binding ColdDetail.U2}" Click="AddColdLayer_Click"/>
                    <Button Content="Премахни слой" Padding="6,2" Background="#F44336" Foreground="White" BorderThickness="0"
                            Tag="{Binding ColdDetail.U2}" Click="RemoveColdLayer_Click"/>
                    <TextBlock Text="U2:" VerticalAlignment="Center" Margin="15,0,5,0"/>
                    <TextBlock Text="{Binding ColdDetail.U2.Uw, StringFormat=0.000}" VerticalAlignment="Center" FontWeight="Bold"/>
                </StackPanel>

                <TextBlock Text="Вертикални ограждения (Uw)" FontWeight="Bold" Margin="0,6,0,4"/>
                <DataGrid ItemsSource="{Binding ColdDetail.Uw.Layers}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          Margin="0,0,0,5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Материал" Binding="{Binding Material, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        <DataGridTextColumn Header="δ (m)" Binding="{Binding Thickness, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}" Width="90"/>
                        <DataGridTextColumn Header="λ (W/mK)" Binding="{Binding Lambda, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}" Width="90"/>
                        <DataGridTextColumn Header="R" Binding="{Binding R, StringFormat=0.000}" IsReadOnly="True" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="+ Слой" Padding="6,2" Margin="0,0,10,0" Background="#4CAF50" Foreground="White" BorderThickness="0"
                            Tag="{Binding ColdDetail.Uw}" Click="AddColdLayer_Click"/>
                    <Button Content="Премахни слой" Padding="6,2" Background="#F44336" Foreground="White" BorderThickness="0"
                            Tag="{Binding ColdDetail.Uw}" Click="RemoveColdLayer_Click"/>
                    <TextBlock Text="Uw:" VerticalAlignment="Center" Margin="15,0,5,0"/>
                    <TextBlock Text="{Binding ColdDetail.Uw.Uw, StringFormat=0.000}" VerticalAlignment="Center" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <Button Content="Изчисли" Width="100" Background="#2196F3" Foreground="White" BorderThickness="0"
                            Click="CalculateColdRoof_Click" Tag="{Binding}"/>
                    <TextBlock Text="Ur:" VerticalAlignment="Center" Margin="15,0,5,0"/>
                    <TextBlock Text="{Binding ColdDetail.Ur, StringFormat=0.000, TargetNullValue='—'}" VerticalAlignment="Center" FontWeight="Bold"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <views:RoofDetailTemplateSelector x:Key="RoofDetailTemplateSelector"
                                      UnselectedRoofTemplate="{StaticResource UnselectedRoofDetailTemplate}"
                                      WarmRoofTemplate="{StaticResource WarmRoofDetailTemplate}"
                                      ColdRoofTemplate="{StaticResource ColdRoofDetailTemplate}"/>
</ResourceDictionary>
