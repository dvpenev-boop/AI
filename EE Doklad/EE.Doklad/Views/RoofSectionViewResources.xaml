<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:EE.Doklad.Views">
    <!-- Warm Roof Detail Template -->
    <DataTemplate x:Key="WarmRoofDetailTemplate">
        <Border BorderBrush="#CCCCCC" BorderThickness="1" Padding="10" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Детайл – Топъл покрив" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Rsi:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Width="60" Text="{Binding WarmDetail.Rsi, UpdateSourceTrigger=PropertyChanged, StringFormat=N3}" Margin="0,0,10,0"/>
                    <TextBlock Text="Rse:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Width="60" Text="{Binding WarmDetail.Rse, UpdateSourceTrigger=PropertyChanged, StringFormat=N3}" Margin="0,0,10,0"/>
                </StackPanel>
                <DataGrid ItemsSource="{Binding WarmDetail.Layers}" AutoGenerateColumns="False" CanUserAddRows="True" HeadersVisibility="Column" Margin="0,0,0,10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Материал" Binding="{Binding Material, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        <DataGridTextColumn Header="δ (m)" Binding="{Binding Thickness, UpdateSourceTrigger=PropertyChanged, StringFormat=N3}" Width="90"/>
                        <DataGridTextColumn Header="λ (W/mK)" Binding="{Binding Lambda, UpdateSourceTrigger=PropertyChanged, StringFormat=N3}" Width="90"/>
                        <DataGridTextColumn Header="R" Binding="{Binding R, StringFormat=N3}" IsReadOnly="True" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </DataTemplate>
    <!-- Cold Roof Detail Template (Stage 1: skeleton only) -->
    <DataTemplate x:Key="ColdRoofDetailTemplate">
        <!-- TODO: Етап 2 – изчисления за студен покрив. В момента само skeleton UI. -->
    </DataTemplate>
    <views:RoofDetailTemplateSelector x:Key="RoofDetailTemplateSelector"
                                      WarmRoofTemplate="{StaticResource WarmRoofDetailTemplate}"
                                      ColdRoofTemplate="{StaticResource ColdRoofDetailTemplate}"/>
</ResourceDictionary>
