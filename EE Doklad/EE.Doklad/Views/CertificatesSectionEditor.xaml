<UserControl x:Class="EE.Doklad.Views.CertificatesSectionEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <!-- Заглавие -->
            <TextBlock Text="Секция №2 – Удостоверения" 
                       FontSize="18" 
                       FontWeight="Bold" 
                       Margin="0,0,0,10"/>
            
            <TextBlock Text="Качете документи (PDF/PNG/JPG). При PDF се използва само първата страница."
                       Foreground="Gray"
                       Margin="0,0,0,20"/>

            <!-- БЛОК 1: Удостоверение -->
            <Border BorderBrush="#E0E0E0" 
                    BorderThickness="1" 
                    CornerRadius="4" 
                    Padding="15" 
                    Margin="0,0,0,20"
                    Background="#FAFAFA">
                <StackPanel>
                    <TextBlock Text="Удостоверение" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Margin="0,0,0,10"/>
                    
                    <!-- Бутони -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="📁 Качи файл" 
                                Padding="10,5" 
                                Margin="0,0,10,0"
                                Click="UploadCertificate_Click"
                                Background="#4CAF50"
                                Foreground="White"
                                BorderThickness="0"/>
                        <Button Content="🗑 Премахни" 
                                Padding="10,5"
                                Click="RemoveCertificate_Click"
                                Background="#F44336"
                                Foreground="White"
                                BorderThickness="0"
                                IsEnabled="{Binding CertificateAttachment.HasAttachment}"/>
                    </StackPanel>

                    <!-- Име на файл -->
                    <TextBlock Margin="0,0,0,10"
                               FontStyle="Italic"
                               Foreground="#666">
                        <Run Text="Файл: "/>
                        <Run Text="{Binding CertificateAttachment.FileName, TargetNullValue='Няма прикачен файл'}"/>
                    </TextBlock>

                    <!-- Предупреждение за PDF -->
                    <TextBlock Text="{Binding CertificateAttachment.MultiPageWarning}"
                               Foreground="Orange"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"
                               Visibility="{Binding CertificateAttachment.MultiPageWarning, Converter={StaticResource BoolToVisibility}}"/>

                    <!-- Preview -->
                    <Border BorderBrush="#CCC" 
                            BorderThickness="1" 
                            Background="White"
                            Height="300">
                        <Grid>
                            <TextBlock Text="Няма визуализация"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#999"
                                       x:Name="CertificatePlaceholder"/>
                            
                            <Image x:Name="CertificateImage"
                                   Stretch="Uniform"
                                   Margin="5"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- БЛОК 2: Застраховка -->
            <Border BorderBrush="#E0E0E0" 
                    BorderThickness="1" 
                    CornerRadius="4" 
                    Padding="15" 
                    Background="#FAFAFA">
                <StackPanel>
                    <TextBlock Text="Застраховка" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Margin="0,0,0,10"/>
                    
                    <!-- Бутони -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="📁 Качи файл" 
                                Padding="10,5" 
                                Margin="0,0,10,0"
                                Click="UploadInsurance_Click"
                                Background="#4CAF50"
                                Foreground="White"
                                BorderThickness="0"/>
                        <Button Content="🗑 Премахни" 
                                Padding="10,5"
                                Click="RemoveInsurance_Click"
                                Background="#F44336"
                                Foreground="White"
                                BorderThickness="0"
                                IsEnabled="{Binding InsuranceAttachment.HasAttachment}"/>
                    </StackPanel>

                    <!-- Име на файл -->
                    <TextBlock Margin="0,0,0,10"
                               FontStyle="Italic"
                               Foreground="#666">
                        <Run Text="Файл: "/>
                        <Run Text="{Binding InsuranceAttachment.FileName, TargetNullValue='Няма прикачен файл'}"/>
                    </TextBlock>

                    <!-- Предупреждение за PDF -->
                    <TextBlock Text="{Binding InsuranceAttachment.MultiPageWarning}"
                               Foreground="Orange"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"
                               Visibility="{Binding InsuranceAttachment.MultiPageWarning, Converter={StaticResource BoolToVisibility}}"/>

                    <!-- Preview -->
                    <Border BorderBrush="#CCC" 
                            BorderThickness="1" 
                            Background="White"
                            Height="300">
                        <Grid>
                            <TextBlock Text="Няма визуализация"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#999"
                                       x:Name="InsurancePlaceholder"/>
                            
                            <Image x:Name="InsuranceImage"
                                   Stretch="Uniform"
                                   Margin="5"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
