<UserControl x:Class="EE.Doklad.Views.CoverPageEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EE.Doklad.Views"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="600">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="Челна страница" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>
            
            <!-- Лого на фирма -->
            <GroupBox Header="Лого на фирма" Margin="0,0,0,15">
                <StackPanel>
                    <Border BorderBrush="#CCCCCC" BorderThickness="2" 
                            Background="#F9F9F9" 
                            Height="150" Width="150" 
                            HorizontalAlignment="Left"
                            Margin="0,10,0,10">
                        <Grid>
                            <Image x:Name="LogoImage" Stretch="Uniform" Margin="5"/>
                            <TextBlock Text="(Лого)" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"
                                       Foreground="#999999"
                                       FontSize="14"
                                       x:Name="LogoPlaceholder"/>
                        </Grid>
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Избери лого..." Click="SelectLogo_Click" 
                                Width="120" Padding="8,5" Margin="0,0,10,0"/>
                        <Button Content="Премахни" Click="RemoveLogo_Click" 
                                Width="100" Padding="8,5"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- Данни за фирмата -->
            <GroupBox Header="Данни за фирмата" Margin="0,0,0,15">
                <StackPanel>
                    <Label Content="Име на фирма *"/>
                    <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" 
                             Padding="8,6" Margin="0,0,0,10"/>
                    
                    <Label Content="Лиценз номер *"/>
                    <TextBox Text="{Binding LicenseNumber, UpdateSourceTrigger=PropertyChanged}" 
                             Padding="8,6" Margin="0,0,0,10"/>
                </StackPanel>
            </GroupBox>

            <!-- Данни за обекта -->
            <GroupBox Header="Данни за обекта" Margin="0,0,0,15">
                <StackPanel>
                    <Label Content="Име на обект *"/>
                    <TextBox Text="{Binding ObjectName, UpdateSourceTrigger=PropertyChanged}" 
                             Padding="8,6" Margin="0,0,0,10"/>
                    
                    <Label Content="Адрес на обект *"/>
                    <TextBox Text="{Binding ObjectAddress, UpdateSourceTrigger=PropertyChanged}" 
                             Padding="8,6" 
                             Height="60"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,10"/>
                </StackPanel>
            </GroupBox>

            <!-- Фаза на проектиране -->
            <GroupBox Header="Фаза на проектиране" Margin="0,0,0,15">
                <ComboBox x:Name="PhaseComboBox" 
                          SelectedIndex="1"
                          Padding="8,6"
                          SelectionChanged="PhaseComboBox_SelectionChanged">
                    <ComboBoxItem Content="Идеен проект" Tag="Ideynyi"/>
                    <ComboBoxItem Content="Технически проект" Tag="Tehnicheski"/>
                    <ComboBoxItem Content="Работен проект" Tag="Raboten"/>
                </ComboBox>
            </GroupBox>

            <!-- Управител -->
            <GroupBox Header="Управител" Margin="0,0,0,15">
                <StackPanel>
                    <Label Content="Име на управител"/>
                    <TextBox Text="{Binding ManagerName, UpdateSourceTrigger=PropertyChanged}" 
                             Padding="8,6" Margin="0,0,0,10"/>
                    <TextBlock Text="(Място за подпис и печат ще се добави при експорт)" 
                               Foreground="#666666" 
                               FontStyle="Italic"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </GroupBox>

            <!-- Списък Разработили -->
            <GroupBox Header="Разработили" Margin="0,0,0,15">
                <StackPanel>
                    <DataGrid x:Name="DevelopersGrid"
                              ItemsSource="{Binding Developers}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              Height="200"
                              Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Име и фамилия" 
                                                Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                                                Width="2*"/>
                            <DataGridTextColumn Header="Длъжност" 
                                                Binding="{Binding Position, UpdateSourceTrigger=PropertyChanged}" 
                                                Width="2*"/>
                            <DataGridTemplateColumn Header="" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✖" 
                                                Click="RemoveDeveloper_Click"
                                                Tag="{Binding}"
                                                Width="30"
                                                Background="#F44336"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                ToolTip="Премахни"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Content="+ Добави разработил" 
                            Click="AddDeveloper_Click"
                            Padding="10,6"
                            HorizontalAlignment="Left"
                            Background="#4CAF50"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"/>
                </StackPanel>
            </GroupBox>

            <TextBlock Text="* Задължителни полета" 
                       Foreground="#666666" 
                       FontStyle="Italic"
                       Margin="0,10,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
