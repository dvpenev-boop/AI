<UserControl x:Class="EE.Doklad.Views.ColdRoofDetailControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:EE.Doklad.Models"
             xmlns:converters="clr-namespace:EE.Doklad.Converters"
             xmlns:views="clr-namespace:EE.Doklad.Views"
             xmlns:controls="clr-namespace:EE.Doklad.Views.Controls"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <converters:FlexibleDoubleConverter x:Key="FlexibleDoubleConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </UserControl.Resources>
    <Border BorderBrush="#CCCCCC" BorderThickness="1" Padding="10" Margin="0,0,0,15">
        <StackPanel>
            <DockPanel Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Content="Премахни" Padding="6,2" Background="#F44336" Foreground="White" BorderThickness="0"
                        Click="RemoveDetail_Click"/>
                <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" FontWeight="Bold" FontSize="13"/>
            </DockPanel>

            <TextBlock Text="Геометрия на подпокривното пространство" FontWeight="Bold" Margin="0,6,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="V′ (m³):" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox Width="80" Text="{Binding ColdDetail.Vp, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}" Margin="0,0,10,0"/>
                <TextBlock Text="A′ (m²):" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox Width="80" Text="{Binding ColdDetail.Ap, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}" Margin="0,0,10,0"/>
                <TextBlock Text="δвс (m):" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock Text="{Binding ColdDetail.Deltavc, StringFormat=0.000, TargetNullValue='—'}" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Text="Площи" FontWeight="Bold" Margin="0,6,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="A1 (m²):" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox Width="80" Text="{Binding ColdDetail.A1, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}" Margin="0,0,10,0"/>
                <TextBlock Text="A2 (m²):" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox Width="80" Text="{Binding ColdDetail.A2, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}" Margin="0,0,10,0"/>
                <TextBlock Text="Aw (m²):" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox Width="80" Text="{Binding ColdDetail.Aw, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}"/>
            </StackPanel>

            <TextBlock Text="Вентилация" FontWeight="Bold" Margin="0,6,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Тип:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox Width="140" SelectedValuePath="Tag" SelectedValue="{Binding ColdDetail.SpaceType, UpdateSourceTrigger=PropertyChanged}">
                    <ComboBoxItem Content="уплътнено" Tag="{x:Static models:ColdRoofSpaceType.Sealed}"/>
                    <ComboBoxItem Content="неуплътнено" Tag="{x:Static models:ColdRoofSpaceType.Unsealed}"/>
                </ComboBox>
                <TextBlock Text="n (h⁻¹):" VerticalAlignment="Center" Margin="10,0,5,0"/>
                <TextBox Width="60" Text="{Binding ColdDetail.N, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}" Margin="0,0,10,0" IsReadOnly="True"/>
                <TextBlock Text="V (m³):" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox Width="80" Text="{Binding ColdDetail.Vp, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}" IsReadOnly="True"/>
            </StackPanel>

            <TextBlock Text="Температури" FontWeight="Bold" Margin="0,6,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="θi (°C):" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox Width="80" Text="{Binding ColdDetail.Ti, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.0}" Margin="0,0,10,0"/>
                <TextBlock Text="θe (°C):" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox Width="80" Text="{Binding ColdDetail.Te, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.0}" IsReadOnly="{Binding ColdDetail.ManualTeInput, Converter={StaticResource InverseBooleanConverter}}"/>
                <CheckBox Content="Ръчно въвеждане" Margin="10,0,0,0" VerticalAlignment="Center" IsChecked="{Binding ColdDetail.ManualTeInput, Mode=TwoWay}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                <TextBlock Text="Θu:" Margin="0,0,5,0"/>
                <TextBlock Text="{Binding ColdDetail.ThetaU, StringFormat=0.00, TargetNullValue='—'}" FontWeight="Bold" Margin="0,0,15,0"/>
                <TextBlock Text="Θse1:" Margin="0,0,5,0"/>
                <TextBlock Text="{Binding ColdDetail.ThetaSe1, StringFormat=0.00, TargetNullValue='—'}" FontWeight="Bold" Margin="0,0,15,0"/>
                <TextBlock Text="Θsi2:" Margin="0,0,5,0"/>
                <TextBlock Text="{Binding ColdDetail.ThetaSi2, StringFormat=0.00, TargetNullValue='—'}" FontWeight="Bold" Margin="0,0,15,0"/>
                <TextBlock Text="λвъздух:" Margin="0,0,5,0"/>
                <TextBlock Text="{Binding ColdDetail.LambdaAir, StringFormat=0.0000, TargetNullValue='—'}" Margin="0,0,15,0"/>
                <TextBlock Text="Pr:" Margin="0,0,5,0"/>
                <TextBlock Text="{Binding ColdDetail.Prandtl, StringFormat=0.00, TargetNullValue='—'}" Margin="0,0,15,0"/>
                <TextBlock Text="Gr:" Margin="0,0,5,0"/>
                <TextBlock Text="{Binding ColdDetail.Grashof, StringFormat=0.00, TargetNullValue='—'}" Margin="0,0,15,0"/>
                <TextBlock Text="Gr·Pr:" Margin="0,0,5,0"/>
                <TextBlock Text="{Binding ColdDetail.GrPr, StringFormat=0.00, TargetNullValue='—'}" Margin="0,0,15,0"/>
                <TextBlock Text="εk:" Margin="0,0,5,0"/>
                <TextBlock Text="{Binding ColdDetail.EpsilonK, StringFormat=0.000, TargetNullValue='—'}" Margin="0,0,15,0"/>
                <TextBlock Text="λекв:" Margin="0,0,5,0"/>
                <TextBlock Text="{Binding ColdDetail.LambdaEk, StringFormat=0.0000, TargetNullValue='—'}" FontWeight="Bold"/>
            </StackPanel>

            <TextBlock Text="Таванска плоча (U1)" FontWeight="Bold" Margin="0,6,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="Rsi = 0.10" VerticalAlignment="Center" Margin="0,0,15,0" Foreground="Gray" FontSize="11"/>
                <TextBlock Text="Rse = Rse1 = " VerticalAlignment="Center" Foreground="Gray" FontSize="11"/>
                <TextBlock Text="{Binding ColdDetail.U1.Rse, StringFormat=0.0000}" VerticalAlignment="Center" Foreground="Gray" FontSize="11" FontWeight="Bold"/>
            </StackPanel>
            <!-- Нов ред: U1 (фиксиран за θse1) -->
            <TextBlock Text="U1 (фиксиран за θse1):" Margin="0,0,5,0" FontSize="11" Foreground="#1976D2"/>
            <TextBlock Text="{Binding ColdDetail.U1ForTheta, StringFormat=0.000, TargetNullValue='—'}" Margin="0,0,0,6" FontWeight="Bold" FontSize="11" Foreground="#1976D2"/>
            <DataGrid ItemsSource="{Binding ColdDetail.U1.Layers}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      Margin="0,0,0,5">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Материал" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding MaterialOptions}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="Display"
                                          SelectedValue="{Binding SelectedMaterialId, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"
                                          IsTextSearchEnabled="True"
                                          StaysOpenOnEdit="True"
                                          TextSearch.TextPath="Display"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="δ (m)" Binding="{Binding Thickness, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}" Width="90"/>
                    <DataGridTextColumn Header="λ (W/mK)" Binding="{Binding Lambda, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}" Width="90" IsReadOnly="True"/>
                    <DataGridTextColumn Header="R" Binding="{Binding R, StringFormat=0.000}" IsReadOnly="True" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Button Content="+ Слой" Padding="6,2" Margin="0,0,10,0" Background="#4CAF50" Foreground="White" BorderThickness="0"
                        Click="AddU1Layer_Click"/>
                <Button Content="Премахни слой" Padding="6,2" Background="#F44336" Foreground="White" BorderThickness="0"
                        Click="RemoveU1Layer_Click"/>
                <TextBlock Text="U1:" VerticalAlignment="Center" Margin="15,0,5,0"/>
                <TextBlock Text="{Binding ColdDetail.U1.Uw, StringFormat=0.000}" VerticalAlignment="Center" FontWeight="Bold"/>
            </StackPanel>

            <TextBlock Text="Покривна плоча (U2)" FontWeight="Bold" Margin="0,6,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="Rsi = Rsi2 = " VerticalAlignment="Center" Foreground="Gray" FontSize="11"/>
                <TextBlock Text="{Binding ColdDetail.U2.Rsi, StringFormat=0.0000}" VerticalAlignment="Center" Foreground="Gray" FontSize="11" FontWeight="Bold" Margin="0,0,15,0"/>
                <TextBlock Text="Rse = 0.04" VerticalAlignment="Center" Foreground="Gray" FontSize="11"/>
            </StackPanel>
            <!-- Нов ред: U2 (фиксиран за θsi2) -->
            <TextBlock Text="U2 (фиксиран за θsi2):" Margin="0,0,5,0" FontSize="11" Foreground="#1976D2"/>
            <TextBlock Text="{Binding ColdDetail.U2ForTheta, StringFormat=0.000, TargetNullValue='—'}" Margin="0,0,0,6" FontWeight="Bold" FontSize="11" Foreground="#1976D2"/>
            <DataGrid ItemsSource="{Binding ColdDetail.U2.Layers}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      Margin="0,0,0,5">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Материал" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding MaterialOptions}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="Display"
                                          SelectedValue="{Binding SelectedMaterialId, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"
                                          IsTextSearchEnabled="True"
                                          StaysOpenOnEdit="True"
                                          TextSearch.TextPath="Display"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="δ (m)" Binding="{Binding Thickness, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}" Width="90"/>
                    <DataGridTextColumn Header="λ (W/mK)" Binding="{Binding Lambda, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}" Width="90" IsReadOnly="True"/>
                    <DataGridTextColumn Header="R" Binding="{Binding R, StringFormat=0.000}" IsReadOnly="True" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Button Content="+ Слой" Padding="6,2" Margin="0,0,10,0" Background="#4CAF50" Foreground="White" BorderThickness="0"
                        Click="AddU2Layer_Click"/>
                <Button Content="Премахни слой" Padding="6,2" Background="#F44336" Foreground="White" BorderThickness="0"
                        Click="RemoveU2Layer_Click"/>
                <TextBlock Text="U2:" VerticalAlignment="Center" Margin="15,0,5,0"/>
                <TextBlock Text="{Binding ColdDetail.U2.Uw, StringFormat=0.000}" VerticalAlignment="Center" FontWeight="Bold"/>
            </StackPanel>

            <TextBlock Text="Вертикални ограждения (Uw)" FontWeight="Bold" Margin="0,6,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="Rsi = 0.13" VerticalAlignment="Center" Margin="0,0,15,0" Foreground="Gray" FontSize="11"/>
                <TextBlock Text="Rse = 0.04" VerticalAlignment="Center" Foreground="Gray" FontSize="11"/>
            </StackPanel>
            <DataGrid ItemsSource="{Binding ColdDetail.Uw.Layers}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      Margin="0,0,0,5">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Материал" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding MaterialOptions}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="Display"
                                          SelectedValue="{Binding SelectedMaterialId, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"
                                          IsTextSearchEnabled="True"
                                          StaysOpenOnEdit="True"
                                          TextSearch.TextPath="Display"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="δ (m)" Binding="{Binding Thickness, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}" Width="90"/>
                    <DataGridTextColumn Header="λ (W/mK)" Binding="{Binding Lambda, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.000}" Width="90" IsReadOnly="True"/>
                    <DataGridTextColumn Header="R" Binding="{Binding R, StringFormat=0.000}" IsReadOnly="True" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="+ Слой" Padding="6,2" Margin="0,0,10,0" Background="#4CAF50" Foreground="White" BorderThickness="0"
                        Click="AddUwLayer_Click"/>
                <Button Content="Премахни слой" Padding="6,2" Background="#F44336" Foreground="White" BorderThickness="0"
                        Click="RemoveUwLayer_Click"/>
                <TextBlock Text="Uw:" VerticalAlignment="Center" Margin="15,0,5,0"/>
                <TextBlock Text="{Binding ColdDetail.Uw.Uw, StringFormat=0.000}" VerticalAlignment="Center" FontWeight="Bold"/>
            </StackPanel>

            <!-- Изчислени стойности -->
            <Border Background="#E3F2FD" Padding="10" Margin="0,10,0,10" BorderBrush="#2196F3" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Изчислени коефициенти" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Rse1 = Rsi2:" VerticalAlignment="Center" Width="100" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding ColdDetail.Rse1Rsi2, StringFormat=0.0000, TargetNullValue='—'}" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,5,0"/>
                        <TextBlock Text="m²K/W" VerticalAlignment="Center" Foreground="Gray"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="U1 (изчислен):" VerticalAlignment="Center" Width="100" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding ColdDetail.U1Calculated, StringFormat=0.000, TargetNullValue='—'}" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,5,0"/>
                        <TextBlock Text="W/m²K" VerticalAlignment="Center" Foreground="Gray"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="U2 (изчислен):" VerticalAlignment="Center" Width="100" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding ColdDetail.U2Calculated, StringFormat=0.000, TargetNullValue='—'}" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,5,0"/>
                        <TextBlock Text="W/m²K" VerticalAlignment="Center" Foreground="Gray"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Uw (изчислен):" VerticalAlignment="Center" Width="100" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding ColdDetail.UwCalculated, StringFormat=0.000, TargetNullValue='—'}" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,5,0"/>
                        <TextBlock Text="W/m²K" VerticalAlignment="Center" Foreground="Gray"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <Button Content="Изчисли" Width="100" Background="#2196F3" Foreground="White" BorderThickness="0"
                        Click="Calculate_Click"/>
                <TextBlock Text="Ur:" VerticalAlignment="Center" Margin="15,0,5,0" FontSize="14" FontWeight="Bold"/>
                <TextBlock Text="{Binding ColdDetail.Ur, StringFormat=0.000, TargetNullValue='—'}" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" Foreground="#2196F3"/>
                <TextBlock Text="W/m²K" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="Gray"/>
            </StackPanel>

            <!-- ══════ Surface Parameters Expander ══════ -->
            <Expander Margin="0,12,0,0"
                      IsExpanded="{Binding SurfaceProperties.IsExpanded, Mode=TwoWay, FallbackValue=False}">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Повърхностни параметри (α_sol, ε)"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="#1565C0" VerticalAlignment="Center"/>
                        <Border Background="#E3F2FD" CornerRadius="4"
                                Padding="5,1" Margin="8,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="αε: default" FontSize="10" Foreground="#1565C0"/>
                        </Border>
                    </StackPanel>
                </Expander.Header>
                <controls:RoofSurfaceParamsEditor DataContext="{Binding SurfaceProperties}"/>
            </Expander>

            <!-- ══════ Thermal Bridges Expander ══════ -->
            <Expander Margin="0,8,0,0"
                      IsExpanded="{Binding ThermalBridges.IsExpanded, Mode=TwoWay, FallbackValue=False}">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Топлинни мостове"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="#4A148C" VerticalAlignment="Center"/>
                        <Border Background="#EDE7F6" CornerRadius="4"
                                Padding="5,1" Margin="8,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock FontSize="10" Foreground="#4A148C">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Няма"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ThermalBridges.Mode}" Value="GlobalPercentage">
                                                <Setter Property="Text" Value="Глобален %"/>
                                                <Setter Property="Foreground" Value="#E65100"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ThermalBridges.Mode}" Value="Manual">
                                                <Setter Property="Text" Value="Ръчно"/>
                                                <Setter Property="Foreground" Value="#1B5E20"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Expander.Header>

                <Border Padding="10,8,10,10" Background="#FAF5FF">
                    <StackPanel DataContext="{Binding ThermalBridges}">

                        <!-- Режим ComboBox -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Режим:" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox SelectedValue="{Binding Mode, Mode=TwoWay}"
                                      SelectedValuePath="Tag"
                                      Width="200" FontSize="12"
                                      SelectionChanged="TbMode_SelectionChanged">
                                <ComboBoxItem Content="Няма"              Tag="None"/>
                                <ComboBoxItem Content="Глобална стойност" Tag="GlobalPercentage"/>
                                <ComboBoxItem Content="Ръчно въвеждане"   Tag="Manual"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Панел: Няма -->
                        <StackPanel Margin="0,0,0,4">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Mode}" Value="None">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock FontSize="11" Foreground="#555" Text="Htb = 0  |  Htotal = Hel = U × A"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Hel =" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Hel, StringFormat=0.000}" FontSize="12" FontWeight="Bold" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="W/K" FontSize="11" Foreground="#777" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Панел: Глобална стойност -->
                        <StackPanel Margin="0,0,0,4">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Mode}" Value="GlobalPercentage">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Процент (0–10 %):" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding GlobalPercent, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDoubleConverter}, StringFormat=0.0}"
                                         Width="70" FontSize="12" Padding="5,3"
                                         BorderBrush="#7B1FA2" BorderThickness="1"
                                         LostFocus="TbGlobalPercent_LostFocus"/>
                                <TextBlock Text=" %" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Hel ="    FontSize="12" Margin="0,0,4,0"  VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Hel,    StringFormat=0.000}" FontSize="12" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Htb ="    FontSize="12" Margin="0,0,4,0"  VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Htb,    StringFormat=0.000}" FontSize="12" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Htotal =" FontSize="12" Margin="0,0,4,0"  VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Htotal, StringFormat=0.000}" FontSize="12" FontWeight="Bold" Margin="0,0,4,0"  VerticalAlignment="Center"/>
                                <TextBlock Text="W/K" FontSize="11" Foreground="#777" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Панел: Ръчно въвеждане -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Mode}" Value="Manual">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <DataGrid x:Name="ThermalBridgesGrid"
                                      ItemsSource="{Binding Items}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      SelectionMode="Single"
                                      FontSize="11"
                                      Margin="0,0,0,6"
                                      MaxHeight="220"
                                      VerticalScrollBarVisibility="Auto"
                                      SelectionChanged="TbGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Тип"      Binding="{Binding Type}"                           Width="*"/>
                                    <DataGridTextColumn Header="L (m)"    Binding="{Binding Length, StringFormat=0.000}"      Width="65"/>
                                    <DataGridTextColumn Header="Ψ (W/mK)" Binding="{Binding Psi,    StringFormat=0.000}"      Width="75"/>
                                    <DataGridTextColumn Header="χ (W/K)"  Binding="{Binding Chi,    StringFormat=0.000}"      Width="65"/>
                                    <DataGridTextColumn Header="L×Ψ"      Binding="{Binding LinearLoss,        StringFormat=0.000}" Width="65" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Общо"      Binding="{Binding TotalLossNoFacade, StringFormat=0.000}" Width="65" IsReadOnly="True"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="+ Добави"    Padding="8,3" Margin="0,0,8,0"
                                        Background="#4CAF50" Foreground="White" BorderThickness="0"
                                        Click="TbAdd_Click"/>
                                <Button Content="Редактирай" Padding="8,3" Margin="0,0,8,0"
                                        Background="#1976D2" Foreground="White" BorderThickness="0"
                                        Click="TbEdit_Click"/>
                                <Button Content="Изтрий"     Padding="8,3"
                                        Background="#e53935" Foreground="White" BorderThickness="0"
                                        Click="TbDelete_Click"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Hel ="    FontSize="12" Margin="0,0,4,0"  VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Hel,    StringFormat=0.000}" FontSize="12" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Htb ="    FontSize="12" Margin="0,0,4,0"  VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Htb,    StringFormat=0.000}" FontSize="12" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Htotal =" FontSize="12" Margin="0,0,4,0"  VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Htotal, StringFormat=0.000}" FontSize="12" FontWeight="Bold" Margin="0,0,4,0"  VerticalAlignment="Center"/>
                                <TextBlock Text="W/K" FontSize="11" Foreground="#777" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                    </StackPanel>
                </Border>
            </Expander>

        </StackPanel>
    </Border>
</UserControl>
