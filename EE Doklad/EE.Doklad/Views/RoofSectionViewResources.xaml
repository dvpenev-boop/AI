<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:EE.Doklad.Views">
    <views:RoofDetailTemplateSelector x:Key="RoofDetailTemplateSelector"
                                      WarmRoofTemplate="{StaticResource WarmRoofDetailTemplate}"
                                      ColdRoofTemplate="{StaticResource ColdRoofDetailTemplate}"/>
    <!-- Warm Roof Detail Template -->
    <DataTemplate x:Key="WarmRoofDetailTemplate">
        <Border BorderBrush="#CCCCCC" BorderThickness="1" Padding="10" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Детайл – Топъл покрив" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Rsi:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Width="60" Text="{Binding WarmDetail.Rsi, UpdateSourceTrigger=PropertyChanged, StringFormat=N3}" Margin="0,0,10,0"/>
                    <TextBlock Text="Rse:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Width="60" Text="{Binding WarmDetail.Rse, UpdateSourceTrigger=PropertyChanged, StringFormat=N3}" Margin="0,0,10,0"/>
                </StackPanel>
                <DataGrid ItemsSource="{Binding WarmDetail.Layers}" AutoGenerateColumns="False" CanUserAddRows="True" HeadersVisibility="Column" Margin="0,0,0,10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Материал" Binding="{Binding Material, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        <DataGridTextColumn Header="δ (m)" Binding="{Binding Thickness, UpdateSourceTrigger=PropertyChanged, StringFormat=N3}" Width="90"/>
                        <DataGridTextColumn Header="λ (W/mK)" Binding="{Binding Lambda, UpdateSourceTrigger=PropertyChanged, StringFormat=N3}" Width="90"/>
                        <DataGridTextColumn Header="R" Binding="{Binding R, StringFormat=N3}" IsReadOnly="True" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </DataTemplate>
    <!-- Cold Roof Detail Template (Stage 1: skeleton only) -->
    <DataTemplate x:Key="ColdRoofDetailTemplate">
        <Border BorderBrush="#CCCCCC" BorderThickness="1" Padding="10" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Детайл – Студен покрив (Етап 1)" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                <!-- Geometry -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="V′ (m³):"/>
                    <TextBox Width="80" Text="{Binding ColdDetail.Vp, UpdateSourceTrigger=PropertyChanged, StringFormat=N3}" Margin="5,0,10,0"/>
                    <TextBlock Text="A′ (m²):"/>
                    <TextBox Width="80" Text="{Binding ColdDetail.Ap, UpdateSourceTrigger=PropertyChanged, StringFormat=N3}" Margin="5,0,10,0"/>
                    <TextBlock Text="δвс (m):"/>
                    <TextBlock Text="{Binding ColdDetail.Deltavc, StringFormat=N3}"/>
                </StackPanel>
                <!-- Areas -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="A1 (m²):"/>
                    <TextBox Width="80" Text="{Binding ColdDetail.A1, UpdateSourceTrigger=PropertyChanged, StringFormat=N3}" Margin="5,0,10,0"/>
                    <TextBlock Text="A2 (m²):"/>
                    <TextBox Width="80" Text="{Binding ColdDetail.A2, UpdateSourceTrigger=PropertyChanged, StringFormat=N3}" Margin="5,0,10,0"/>
                    <TextBlock Text="Aw (m²):"/>
                    <TextBox Width="80" Text="{Binding ColdDetail.Aw, UpdateSourceTrigger=PropertyChanged, StringFormat=N3}"/>
                </StackPanel>
                <!-- Ventilation -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Тип подпокривно пространство:"/>
                    <ComboBox Width="120" SelectedValue="{Binding ColdDetail.SpaceType, UpdateSourceTrigger=PropertyChanged}" Margin="5,0,10,0">
                        <ComboBoxItem Content="уплътнено" Tag="Sealed"/>
                        <ComboBoxItem Content="неуплътнено" Tag="Unsealed"/>
                    </ComboBox>
                    <TextBlock Text="n (h⁻¹):"/>
                    <TextBox Width="60" Text="{Binding ColdDetail.n, UpdateSourceTrigger=PropertyChanged, StringFormat=N3}" Margin="5,0,10,0"/>
                    <TextBlock Text="V (m³):"/>
                    <TextBox Width="80" Text="{Binding ColdDetail.V, UpdateSourceTrigger=PropertyChanged, StringFormat=N3}"/>
                </StackPanel>
                <!-- Temperatures -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="θi (°C):"/>
                    <TextBox Width="60" Text="{Binding ColdDetail.Ti, UpdateSourceTrigger=PropertyChanged, StringFormat=N1}" Margin="5,0,10,0"/>
                    <TextBlock Text="θe (°C):"/>
                    <TextBox Width="60" Text="{Binding ColdDetail.Te, UpdateSourceTrigger=PropertyChanged, StringFormat=N1}"/>
                </StackPanel>
                <!-- Layer tables for U1, U2, Uw -->
                <TextBlock Text="Таванска плоча (U1):" FontWeight="SemiBold" Margin="0,10,0,0"/>
                <DataGrid ItemsSource="{Binding ColdDetail.U1.Layers}" AutoGenerateColumns="False" CanUserAddRows="True" HeadersVisibility="Column" Margin="0,0,0,5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Материал" Binding="{Binding Material, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        <DataGridTextColumn Header="δ (m)" Binding="{Binding Thickness, UpdateSourceTrigger=PropertyChanged, StringFormat=N3}" Width="90"/>
                        <DataGridTextColumn Header="λ (W/mK)" Binding="{Binding Lambda, UpdateSourceTrigger=PropertyChanged, StringFormat=N3}" Width="90"/>
                        <DataGridTextColumn Header="R" Binding="{Binding R, StringFormat=N3}" IsReadOnly="True" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="Покривна плоча (U2):" FontWeight="SemiBold" Margin="0,10,0,0"/>
                <DataGrid ItemsSource="{Binding ColdDetail.U2.Layers}" AutoGenerateColumns="False" CanUserAddRows="True" HeadersVisibility="Column" Margin="0,0,0,5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Материал" Binding="{Binding Material, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        <DataGridTextColumn Header="δ (m)" Binding="{Binding Thickness, UpdateSourceTrigger=PropertyChanged, StringFormat=N3}" Width="90"/>
                        <DataGridTextColumn Header="λ (W/mK)" Binding="{Binding Lambda, UpdateSourceTrigger=PropertyChanged, StringFormat=N3}" Width="90"/>
                        <DataGridTextColumn Header="R" Binding="{Binding R, StringFormat=N3}" IsReadOnly="True" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="Вертикални ограждения (Uw):" FontWeight="SemiBold" Margin="0,10,0,0"/>
                <DataGrid ItemsSource="{Binding ColdDetail.Uw.Layers}" AutoGenerateColumns="False" CanUserAddRows="True" HeadersVisibility="Column" Margin="0,0,0,5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Материал" Binding="{Binding Material, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        <DataGridTextColumn Header="δ (m)" Binding="{Binding Thickness, UpdateSourceTrigger=PropertyChanged, StringFormat=N3}" Width="90"/>
                        <DataGridTextColumn Header="λ (W/mK)" Binding="{Binding Lambda, UpdateSourceTrigger=PropertyChanged, StringFormat=N3}" Width="90"/>
                        <DataGridTextColumn Header="R" Binding="{Binding R, StringFormat=N3}" IsReadOnly="True" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
